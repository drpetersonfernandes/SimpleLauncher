<ui:FluentWindow x:Class="SimpleLauncher.New.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:vwp="clr-namespace:WpfToolkit.Controls;assembly=VirtualizingWrapPanel"
        xmlns:converters="clr-namespace:SimpleLauncher.New.Converters"
        xmlns:vm="clr-namespace:SimpleLauncher.New.ViewModels"
        Title="{Binding ToolbarTitle}"
        Height="800" Width="1280"
        MinHeight="550" MinWidth="900"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        WindowStartupLocation="CenterScreen"
        WindowCornerPreference="Round"
        Closing="Window_Closing"
        SourceInitialized="Window_SourceInitialized">

    <Window.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
        <converters:NullToVisibilityConverter x:Key="NullToVisibility" />
        <converters:PathToImageConverter x:Key="PathToImage" />
        <converters:SmartTitleCaseConverter x:Key="SmartTitleCase" />
        <converters:ConsoleToCardHeightConverter x:Key="CardHeightConverter" />
        <converters:BindingProxy x:Key="BindingProxy" Data="{DynamicResource LibraryCardWidth}" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Title Bar (min/max/close) -->
            <RowDefinition Height="Auto" />
            <!-- Toolbar -->
            <RowDefinition Height="44" />
            <!-- Body -->
            <RowDefinition Height="*" />
            <!-- Status Bar -->
            <RowDefinition Height="24" />
            <!-- Import Progress Banner (collapsed by default) -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ═══ TITLE BAR (Row 0) — Fluent window controls: minimize/maximize/close ═══ -->
        <ui:TitleBar Grid.Row="0"
                     Title="{Binding ToolbarTitle}"
                     ShowMinimize="True"
                     ShowMaximize="True"
                     ShowClose="True"
                     CanMaximize="True"
                     Padding="16,0" />

        <!-- ═══ TOOLBAR (Row 1) ═══ -->
        <Border Grid.Row="1" Background="{DynamicResource BgTertiaryBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left: View toggle -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <ToggleButton x:Name="GridViewToggle"
                                  Style="{DynamicResource ToolbarToggleButtonStyle}"
                                  IsChecked="True"
                                  ToolTip="Grid View"
                                  Click="ViewToggle_Click">
                        <TextBlock Text="≡" FontSize="15" />
                    </ToggleButton>
                    <ToggleButton x:Name="ListViewToggle"
                                  Style="{DynamicResource ToolbarToggleButtonStyle}"
                                  IsChecked="False"
                                  ToolTip="List View"
                                  Click="ViewToggle_Click">
                        <TextBlock Text="☰" FontSize="13" />
                    </ToggleButton>
                </StackPanel>

                <!-- Card size slider -->
                <StackPanel Grid.Column="1" Orientation="Horizontal"
                            VerticalAlignment="Center" Margin="14,0,0,0">
                    <TextBlock Text="◉" Foreground="{DynamicResource TextMutedBrush}"
                               FontSize="10" VerticalAlignment="Center" />
                    <Slider x:Name="CardSizeSlider"
                            Width="80" Minimum="148" Maximum="280"
                            Value="{DynamicResource LibraryCardWidth}"
                            Margin="6,0" VerticalAlignment="Center"
                            ValueChanged="CardSizeSlider_ValueChanged" />
                    <TextBlock Text="○" Foreground="{DynamicResource TextMutedBrush}"
                               FontSize="10" VerticalAlignment="Center" />
                </StackPanel>

                <!-- Center: Category tabs -->
                <StackPanel Grid.Column="2" Orientation="Horizontal"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ToggleButton x:Name="GamesTab"
                                  Style="{DynamicResource ToolbarToggleButtonStyle}"
                                  IsChecked="True"
                                  Content="Games"
                                  Click="CategoryTab_Click" />
                    <ToggleButton x:Name="RecentTab"
                                  Style="{DynamicResource ToolbarToggleButtonStyle}"
                                  IsChecked="False"
                                  Content="Recently Played"
                                  Click="CategoryTab_Click" Margin="2,0,0,0" />
                    <ToggleButton x:Name="FavoritesTab"
                                  Style="{DynamicResource ToolbarToggleButtonStyle}"
                                  IsChecked="False"
                                  Content="Favorites"
                                  Click="CategoryTab_Click" Margin="2,0,0,0" />
                </StackPanel>

                <!-- Right: Search box -->
                <Border Grid.Column="3" Background="{DynamicResource BgQuaternaryBrush}"
                        CornerRadius="14" Padding="10,4" MinWidth="200">
                    <Grid>
                        <TextBlock x:Name="SearchPlaceholder"
                                   Text="🔍  Search…"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   FontSize="12" VerticalAlignment="Center"
                                   IsHitTestVisible="False" />
                        <TextBox x:Name="SearchBox"
                                 Style="{StaticResource SearchTextBoxStyle}"
                                 BorderThickness="0" Padding="0,4"
                                 TextChanged="SearchBox_TextChanged" />
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- ═══ BODY (Row 2): Sidebar + Content ═══ -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" MinWidth="180" MaxWidth="350" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border Grid.Column="0" Background="{DynamicResource BgSecondaryBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,8,0,0">

                            <!-- CONSOLES section -->
                            <ToggleButton x:Name="ConsolesHeader"
                                          Style="{StaticResource SectionHeaderToggleStyle}"
                                          IsChecked="True"
                                          Content="CONSOLES" />

                            <StackPanel x:Name="ConsolesPanel" Margin="0,0,0,4">
                                <!-- Manufacturer: ARCADE -->
                                <ToggleButton x:Name="ArcadeGroupHeader"
                                              Style="{StaticResource SectionHeaderToggleStyle}"
                                              IsChecked="True"
                                              Content="ARCADE" FontWeight="Normal" FontSize="12"
                                              Padding="28,5" />
                                <StackPanel x:Name="ArcadeGroupPanel">
                                    <ListBox x:Name="ArcadeSystemsList"
                                             ItemContainerStyle="{DynamicResource SidebarItemStyle}"
                                             SelectionChanged="SystemList_SelectionChanged" />
                                </StackPanel>

                                <!-- Manufacturer: NINTENDO -->
                                <ToggleButton x:Name="NintendoGroupHeader"
                                              Style="{StaticResource SectionHeaderToggleStyle}"
                                              IsChecked="True"
                                              Content="NINTENDO" FontWeight="Normal" FontSize="12"
                                              Padding="28,5" />
                                <StackPanel x:Name="NintendoGroupPanel">
                                    <ListBox x:Name="NintendoSystemsList"
                                             ItemContainerStyle="{DynamicResource SidebarItemStyle}"
                                             SelectionChanged="SystemList_SelectionChanged" />
                                </StackPanel>

                                <!-- Manufacturer: SEGA -->
                                <ToggleButton x:Name="SegaGroupHeader"
                                              Style="{StaticResource SectionHeaderToggleStyle}"
                                              IsChecked="True"
                                              Content="SEGA" FontWeight="Normal" FontSize="12"
                                              Padding="28,5" />
                                <StackPanel x:Name="SegaGroupPanel">
                                    <ListBox x:Name="SegaSystemsList"
                                             ItemContainerStyle="{DynamicResource SidebarItemStyle}"
                                             SelectionChanged="SystemList_SelectionChanged" />
                                </StackPanel>

                                <!-- Manufacturer: SONY -->
                                <ToggleButton x:Name="SonyGroupHeader"
                                              Style="{StaticResource SectionHeaderToggleStyle}"
                                              IsChecked="True"
                                              Content="SONY" FontWeight="Normal" FontSize="12"
                                              Padding="28,5" />
                                <StackPanel x:Name="SonyGroupPanel">
                                    <ListBox x:Name="SonySystemsList"
                                             ItemContainerStyle="{DynamicResource SidebarItemStyle}"
                                             SelectionChanged="SystemList_SelectionChanged" />
                                </StackPanel>

                                <!-- Manufacturer: NEC -->
                                <ToggleButton x:Name="NecGroupHeader"
                                              Style="{StaticResource SectionHeaderToggleStyle}"
                                              IsChecked="True"
                                              Content="NEC" FontWeight="Normal" FontSize="12"
                                              Padding="28,5" />
                                <StackPanel x:Name="NecGroupPanel">
                                    <ListBox x:Name="NecSystemsList"
                                             ItemContainerStyle="{DynamicResource SidebarItemStyle}"
                                             SelectionChanged="SystemList_SelectionChanged" />
                                </StackPanel>

                                <!-- Manufacturer: SNK -->
                                <ToggleButton x:Name="SnkGroupHeader"
                                              Style="{StaticResource SectionHeaderToggleStyle}"
                                              IsChecked="True"
                                              Content="SNK" FontWeight="Normal" FontSize="12"
                                              Padding="28,5" />
                                <StackPanel x:Name="SnkGroupPanel">
                                    <ListBox x:Name="SnkSystemsList"
                                             ItemContainerStyle="{DynamicResource SidebarItemStyle}"
                                             SelectionChanged="SystemList_SelectionChanged" />
                                </StackPanel>

                                <!-- Manufacturer: OTHER -->
                                <ToggleButton x:Name="OtherGroupHeader"
                                              Style="{StaticResource SectionHeaderToggleStyle}"
                                              IsChecked="True"
                                              Content="OTHER" FontWeight="Normal" FontSize="12"
                                              Padding="28,5" />
                                <StackPanel x:Name="OtherGroupPanel">
                                    <ListBox x:Name="OtherSystemsList"
                                             ItemContainerStyle="{DynamicResource SidebarItemStyle}"
                                             SelectionChanged="SystemList_SelectionChanged" />
                                </StackPanel>
                            </StackPanel>

                            <!-- COLLECTIONS section -->
                            <TextBlock Style="{StaticResource SidebarGroupHeaderStyle}"
                                       Text="COLLECTIONS" Margin="16,16,16,4" />

                            <ListBox x:Name="CollectionsList"
                                     ItemContainerStyle="{DynamicResource SidebarItemStyle}"
                                     SelectionChanged="SystemList_SelectionChanged">
                                <ListBoxItem Tag="all">
                                    <TextBlock>
                                        <Run Text="⊞  " FontSize="14" />
                                        <Run Text="All Games" />
                                    </TextBlock>
                                </ListBoxItem>
                                <ListBoxItem Tag="recently_added">
                                    <TextBlock>
                                        <Run Text="🕐  " FontSize="14" />
                                        <Run Text="Recently Added" />
                                    </TextBlock>
                                </ListBoxItem>
                                <ListBoxItem Tag="recently_played">
                                    <TextBlock>
                                        <Run Text="◷  " FontSize="14" />
                                        <Run Text="Recently Played" />
                                    </TextBlock>
                                </ListBoxItem>
                                <ListBoxItem Tag="favorites">
                                    <TextBlock>
                                        <Run Text="♡  " FontSize="14" />
                                        <Run Text="Favorites" />
                                    </TextBlock>
                                </ListBoxItem>
                            </ListBox>

                            <!-- Spacer -->
                            <Rectangle Height="20" />

                        </StackPanel>
                    </ScrollViewer>

                    <!-- Bottom: Add System + Preferences buttons -->
                    <StackPanel Grid.Row="1" Margin="8,4,8,8">
                        <Button Style="{StaticResource PrimaryButtonStyle}"
                                Padding="12,8"
                                Click="AddSystem_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="＋  " FontSize="14" />
                                <TextBlock Text="Add System" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource SecondaryButtonStyle}"
                                Margin="0,4,0,0"
                                Padding="12,8"
                                Click="Preferences_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚙  " FontSize="14" />
                                <TextBlock Text="Preferences" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Sidebar resize grip -->
            <GridSplitter Grid.Column="1" Width="4"
                          Background="Transparent"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Stretch"
                          Cursor="SizeWE" />

            <!-- Content area -->
            <Border Grid.Column="2" Background="{DynamicResource BgPrimaryBrush}"
                    AllowDrop="True"
                    DragEnter="Content_DragEnter"
                    DragOver="Content_DragOver"
                    DragLeave="Content_DragLeave"
                    Drop="Content_Drop">
                <Grid>
                    <!-- Drag-drop overlay -->
                    <Border x:Name="DragDropOverlay"
                            Background="{DynamicResource OverlayDragAcceptBrush}"
                            Visibility="Collapsed" Panel.ZIndex="90"
                            BorderBrush="{DynamicResource AccentBrush}"
                            BorderThickness="3"
                            CornerRadius="12">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="📁" FontSize="48" HorizontalAlignment="Center"
                                       Foreground="White" />
                            <TextBlock Text="Drop ROM folder here to scan"
                                       FontSize="18" FontWeight="SemiBold"
                                       Foreground="White"
                                       HorizontalAlignment="Center" Margin="0,12,0,0" />
                            <TextBlock Text="The folder will be scanned for games"
                                       FontSize="13"
                                       Foreground="#CCFFFFFF"
                                       HorizontalAlignment="Center" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                    <!-- Toast notification stack (top-right) -->
                    <StackPanel x:Name="ToastStack"
                                VerticalAlignment="Top" HorizontalAlignment="Right"
                                Margin="16" MaxWidth="360"
                                Visibility="Collapsed" Panel.ZIndex="100" />

                    <!-- Game Grid View -->
                    <ListBox x:Name="GameGridView"
                             ItemsSource="{Binding Games}"
                             Visibility="{Binding IsGridView, Converter={StaticResource BoolToVisibility}}"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             VirtualizingPanel.ScrollUnit="Pixel"
                             VirtualizingPanel.CacheLength="1,1"
                             VirtualizingPanel.CacheLengthUnit="Page"
                             SelectionMode="Single">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <vwp:VirtualizingWrapPanel />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:GameCardViewModel}">
                                <!-- Card: width driven by DynamicResource, height by MultiBinding -->
                                <Border Width="{DynamicResource LibraryCardWidth}"
                                        Margin="6"
                                        Cursor="Hand"
                                        MouseLeftButtonDown="GameCard_Click"
                                        MouseRightButtonDown="GameCard_Click">
                                    <Border.Height>
                                        <MultiBinding Converter="{StaticResource CardHeightConverter}">
                                            <Binding Source="{StaticResource BindingProxy}" Path="Data" />
                                            <Binding Path="SystemName" />
                                            <Binding Path="DataContext.IsMixedView"
                                                     RelativeSource="{RelativeSource AncestorType=ListBox}" />
                                        </MultiBinding>
                                    </Border.Height>
                                    <Border.Effect>
                                        <DropShadowEffect Color="{DynamicResource ShadowColor}"
                                                          BlurRadius="1" ShadowDepth="0"
                                                          Direction="-90" Opacity="0.5" />
                                    </Border.Effect>

                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <!-- Art area -->
                                        <Border Grid.Row="0"
                                                CornerRadius="{DynamicResource CardCornerRadius}"
                                                ClipToBounds="True"
                                                Margin="2">
                                            <Grid>
                                            <!-- Selection ring -->
                                            <Border x:Name="SelectionRing"
                                                    BorderBrush="{DynamicResource SelectionRingBrush}"
                                                    BorderThickness="3"
                                                    CornerRadius="{DynamicResource CardCornerRadius}"
                                                    Visibility="Collapsed" />

                                            <!-- Placeholder (no art) -->
                                            <Border x:Name="PlaceholderBorder"
                                                    Background="{DynamicResource PlaceholderFillBrush}"
                                                    BorderBrush="{DynamicResource PlaceholderStrokeBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="10"
                                                    Visibility="{Binding HasCover, Converter={StaticResource InverseBoolToVisibility}}">
                                                <TextBlock Text="{Binding DisplayTitle, Converter={StaticResource SmartTitleCase}}"
                                                           Foreground="{DynamicResource TextMutedBrush}"
                                                           FontSize="12"
                                                           TextWrapping="Wrap"
                                                           TextAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           Margin="8" />
                                            </Border>

                                            <!-- Cover image -->
                                            <Image Source="{Binding CoverPath, Converter={StaticResource PathToImage}}"
                                                   Stretch="Uniform"
                                                   Visibility="{Binding HasCover, Converter={StaticResource BoolToVisibility}}"
                                                   RenderOptions.BitmapScalingMode="HighQuality" />

                                            <!-- Favorite heart -->
                                            <Border Background="#99000000"
                                                    CornerRadius="0,0,8,0"
                                                    Visibility="{Binding IsFavorite, Converter={StaticResource BoolToVisibility}}"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Top"
                                                    Padding="4">
                                                <TextBlock Text="♥"
                                                           Foreground="{DynamicResource FavoriteHeartBrush}"
                                                           FontSize="14" />
                                            </Border>

                                            <!-- RA trophy badge -->
                                            <Border Background="#99000000"
                                                    CornerRadius="8,0,0,0"
                                                    Visibility="{Binding IsRaSupported, Converter={StaticResource BoolToVisibility}}"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Bottom"
                                                    Padding="4,2">
                                                <TextBlock Text="🏆"
                                                           FontSize="12"
                                                           ToolTip="RetroAchievements supported" />
                                            </Border>
                                            </Grid>
                                        </Border>

                                        <!-- Caption area -->
                                        <StackPanel Grid.Row="1" Margin="4,6,4,4">
                                            <TextBlock Text="{Binding DisplayTitle, Converter={StaticResource SmartTitleCase}}"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       FontFamily="{DynamicResource PrimaryFont}"
                                                       FontSize="13"
                                                       MaxHeight="32"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding DisplayTitle}" />
                                            <!-- Rating stars -->
                                            <StackPanel Orientation="Horizontal"
                                                        Visibility="{Binding Rating, Converter={StaticResource NullToVisibility}}"
                                                        Margin="0,2,0,0">
                                                <TextBlock Text="★★★★★"
                                                           Foreground="{DynamicResource TextMutedBrush}"
                                                           FontSize="10" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                        <Setter TargetName="SelectionRing" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Game List View -->
                    <ListView x:Name="GameListView"
                              ItemsSource="{Binding Games}"
                              Visibility="{Binding IsGridView, Converter={StaticResource InverseBoolToVisibility}}"
                              Background="Transparent"
                              BorderThickness="0"
                              AlternationCount="2"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling"
                              SelectionMode="Single"
                              MouseDoubleClick="GameListView_DoubleClick"
                              GridViewColumnHeader.Click="GameListView_ColumnClick">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Name" Width="250"
                                                DisplayMemberBinding="{Binding DisplayTitle}" />
                                <GridViewColumn Header="System" Width="120"
                                                DisplayMemberBinding="{Binding SystemName}" />
                                <GridViewColumn Header="Times Played" Width="100"
                                                DisplayMemberBinding="{Binding PlayCount}" />
                                <GridViewColumn Header="Path" Width="Auto"
                                                DisplayMemberBinding="{Binding FilePath}" />
                            </GridView>
                        </ListView.View>
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                <Setter Property="FontSize" Value="13" />
                                <Setter Property="Padding" Value="10,6" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListViewItem">
                                            <Border x:Name="border"
                                                    Background="{TemplateBinding Background}"
                                                    BorderThickness="0"
                                                    Padding="{TemplateBinding Padding}">
                                                <GridViewRowPresenter Content="{TemplateBinding Content}" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                                                    <Setter TargetName="border" Property="Background"
                                                            Value="#222222" />
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="border" Property="Background"
                                                            Value="{DynamicResource BgQuaternaryBrush}" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="border" Property="Background"
                                                            Value="{DynamicResource SelectionBackgroundBrush}" />
                                                    <Setter Property="Foreground"
                                                            Value="{DynamicResource TextPrimaryBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListView.ItemContainerStyle>
                    </ListView>

                    <!-- Empty state -->
                    <StackPanel x:Name="EmptyState"
                                VerticalAlignment="Center" HorizontalAlignment="Center"
                                Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="🎮" FontSize="64" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextMutedBrush}" />
                        <TextBlock Text="No Games Found"
                                   FontSize="20" FontWeight="Medium"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   HorizontalAlignment="Center" Margin="0,16,0,4"
                                   FontFamily="{DynamicResource PrimaryFont}" />
                        <TextBlock Text="Select a system from the sidebar or scan for games"
                                   FontSize="13"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center"
                                   FontFamily="{DynamicResource PrimaryFont}" />
                    </StackPanel>

                    <!-- Loading overlay -->
                    <Border x:Name="LoadingOverlay"
                            Background="{DynamicResource OverlayProcessingBrush}"
                            Visibility="Collapsed" Panel.ZIndex="50">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <ProgressBar IsIndeterminate="True" Width="200" Height="4"
                                         Foreground="{DynamicResource AccentBrush}" />
                            <TextBlock x:Name="LoadingMessage"
                                       Text="Loading…"
                                       Foreground="White" FontSize="14"
                                       HorizontalAlignment="Center" Margin="0,12,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ═══ STATUS BAR (Row 3) ═══ -->
        <Border Grid.Row="3" Background="{DynamicResource BgSecondaryBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="10,0">
                <TextBlock x:Name="StatusLeft"
                           Text="0 games"
                           Foreground="{DynamicResource TextMutedBrush}"
                           FontSize="11" VerticalAlignment="Center"
                           HorizontalAlignment="Left" />
                <TextBlock x:Name="StatusRight"
                           Text="Ready"
                           Foreground="{DynamicResource TextMutedBrush}"
                           FontSize="11" VerticalAlignment="Center"
                           HorizontalAlignment="Right" />
            </Grid>
        </Border>

        <!-- ═══ IMPORT BANNER (Row 4, collapsed by default) ═══ -->
        <Border x:Name="ImportBanner"
                Grid.Row="4"
                Background="{DynamicResource BgTertiaryBrush}"
                BorderBrush="{DynamicResource BorderAccentBrush}"
                BorderThickness="0,1,0,0"
                Padding="12,8"
                Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock x:Name="BannerText"
                               Text="Importing games…"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               FontSize="12" FontWeight="SemiBold" />
                    <ProgressBar x:Name="BannerProgress"
                                 IsIndeterminate="True"
                                 Width="300"
                                 Margin="0,4,0,0"
                                 HorizontalAlignment="Left" />
                </StackPanel>
                <Button Grid.Column="1"
                        Content="✕"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Padding="8,4"
                        FontSize="12"
                        Click="BannerClose_Click"
                        VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
