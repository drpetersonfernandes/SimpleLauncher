<Window x:Class="SimpleLauncher.New.EasyModeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:SimpleLauncher.New.Converters"
        Title="Add New System"
        Width="900" MinWidth="700"
        Height="610" MinHeight="550"
        WindowStartupLocation="CenterOwner"
        WindowStyle="ToolWindow"
        Background="{DynamicResource BgPrimaryBrush}"
        ResizeMode="CanResize"
        Loaded="Window_Loaded"
        Closed="Window_Closed">

    <Window.Resources>
        <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
        <converters:InverseBoolConverter x:Key="InverseBool" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Row 0: Header -->
        <StackPanel Grid.Row="0" Margin="24,20,24,12">
            <TextBlock Text="Add New System" FontSize="22" FontWeight="Light"
                       Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8" />
            <TextBlock Text="In this window you can download, configure and launch various retro gaming emulators."
                       TextWrapping="Wrap" FontSize="12"
                       Foreground="{DynamicResource TextMutedBrush}" />
            <TextBlock Text="We also support systems not listed here. Open an issue or use the original Simple Launcher to add a custom system."
                       TextWrapping="Wrap" FontSize="12"
                       Foreground="{DynamicResource TextMutedBrush}" Margin="0,6,0,0" />
        </StackPanel>

        <!-- Row 1: Main content (two columns) -->
        <Grid Grid.Row="1" Margin="24,12,24,12"
              IsEnabled="{Binding IsOperationInProgress, Converter={StaticResource InverseBool}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left column: Configuration -->
            <StackPanel Grid.Column="0">
                <TextBlock Text="Choose a System to Add" FontWeight="SemiBold" FontSize="13"
                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6" />
                <ComboBox x:Name="SystemNameCombo"
                          ItemsSource="{Binding Systems}"
                          SelectedItem="{Binding SelectedSystem}"
                          DisplayMemberPath="SystemName"
                          Height="32"
                          Background="{DynamicResource BgSecondaryBrush}"
                          Foreground="{DynamicResource TextPrimaryBrush}"
                          BorderBrush="{DynamicResource BorderNormalBrush}"
                          Margin="0,0,0,20" />

                <TextBlock Text="Choose Folder with ROMs or ISOs" FontWeight="SemiBold" FontSize="13"
                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6" />
                <TextBlock Text="If you leave it empty, a default folder will be created."
                           TextWrapping="Wrap" FontSize="12"
                           Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,6" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0"
                             Text="{Binding SystemFolderPath, UpdateSourceTrigger=PropertyChanged}"
                             VerticalContentAlignment="Center"
                             Height="32"
                             Background="{DynamicResource BgSecondaryBrush}"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             BorderBrush="{DynamicResource BorderNormalBrush}" />
                    <Button Grid.Column="1" Content="..."
                            Width="40" Height="32"
                            Margin="6,0,0,0"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="BrowseFolder_Click"
                            ToolTip="Browse for ROM folder" />
                </Grid>

                <!-- Links section -->
                <StackPanel Margin="0,24,0,0">
                    <TextBlock Text="Resources" FontWeight="SemiBold" FontSize="13"
                               Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,10" />
                    <TextBlock Text="In case the image pack is not available, you can download covers manually:"
                               TextWrapping="Wrap" FontSize="12"
                               Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,6" />
                    <TextBlock Margin="0,0,0,4">
                        <Hyperlink NavigateUri="https://github.com/libretro-thumbnails/libretro-thumbnails"
                                   RequestNavigate="Hyperlink_RequestNavigate"
                                   Foreground="{DynamicResource LinkBrush}">
                            Libretro Thumbnails (GitHub)
                        </Hyperlink>
                    </TextBlock>
                    <TextBlock>
                        <Hyperlink NavigateUri="https://emumovies.com/files/"
                                   RequestNavigate="Hyperlink_RequestNavigate"
                                   Foreground="{DynamicResource LinkBrush}">
                            EmuMovies Files
                        </Hyperlink>
                    </TextBlock>
                </StackPanel>
            </StackPanel>

            <!-- Right column: Downloads -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Install" FontWeight="SemiBold" FontSize="13"
                               Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,10" />

                    <!-- Essential components -->
                    <Border Background="{DynamicResource BgSecondaryBrush}"
                            BorderBrush="{DynamicResource BorderSubtleBrush}"
                            BorderThickness="1" CornerRadius="6"
                            Padding="12" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Essentials" FontWeight="SemiBold" FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8" />
                            <UniformGrid Columns="2" Rows="1">
                                <Button Content="Download Emulator"
                                        Command="{Binding DownloadEmulatorCommand}"
                                        IsEnabled="{Binding IsEmulatorDownloaded, Converter={StaticResource InverseBool}}"
                                        Height="38" Margin="4"
                                        Style="{StaticResource PrimaryButtonStyle}" />
                                <Button Content="Download Core"
                                        Command="{Binding DownloadCoreCommand}"
                                        IsEnabled="{Binding IsCoreDownloaded, Converter={StaticResource InverseBool}}"
                                        Height="38" Margin="4"
                                        Style="{StaticResource PrimaryButtonStyle}" />
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <!-- Image packs -->
                    <Border Background="{DynamicResource BgSecondaryBrush}"
                            BorderBrush="{DynamicResource BorderSubtleBrush}"
                            BorderThickness="1" CornerRadius="6"
                            Padding="12">
                        <StackPanel>
                            <TextBlock Text="Image Packs (Optional)" FontWeight="SemiBold" FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8" />
                            <UniformGrid Columns="2">
                                <Button Content="Image Pack 1"
                                        Command="{Binding DownloadImagePack1Command}"
                                        IsEnabled="{Binding IsImagePack1Downloaded, Converter={StaticResource InverseBool}}"
                                        Visibility="{Binding IsImagePack1Available, Converter={StaticResource InverseBoolToVisibility}}"
                                        Height="38" Margin="4"
                                        Style="{StaticResource PrimaryButtonStyle}" />
                                <Button Content="Image Pack 2"
                                        Command="{Binding DownloadImagePack2Command}"
                                        IsEnabled="{Binding IsImagePack2Downloaded, Converter={StaticResource InverseBool}}"
                                        Visibility="{Binding IsImagePack2Available, Converter={StaticResource InverseBoolToVisibility}}"
                                        Height="38" Margin="4"
                                        Style="{StaticResource PrimaryButtonStyle}" />
                                <Button Content="Image Pack 3"
                                        Command="{Binding DownloadImagePack3Command}"
                                        IsEnabled="{Binding IsImagePack3Downloaded, Converter={StaticResource InverseBool}}"
                                        Visibility="{Binding IsImagePack3Available, Converter={StaticResource InverseBoolToVisibility}}"
                                        Height="38" Margin="4"
                                        Style="{StaticResource PrimaryButtonStyle}" />
                                <Button Content="Image Pack 4"
                                        Command="{Binding DownloadImagePack4Command}"
                                        IsEnabled="{Binding IsImagePack4Downloaded, Converter={StaticResource InverseBool}}"
                                        Visibility="{Binding IsImagePack4Available, Converter={StaticResource InverseBoolToVisibility}}"
                                        Height="38" Margin="4"
                                        Style="{StaticResource PrimaryButtonStyle}" />
                                <Button Content="Image Pack 5"
                                        Command="{Binding DownloadImagePack5Command}"
                                        IsEnabled="{Binding IsImagePack5Downloaded, Converter={StaticResource InverseBool}}"
                                        Visibility="{Binding IsImagePack5Available, Converter={StaticResource InverseBoolToVisibility}}"
                                        Height="38" Margin="4"
                                        Style="{StaticResource PrimaryButtonStyle}" />
                            </UniformGrid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Row 2: Footer (progress + action) -->
        <Border Grid.Row="2"
                BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,1,0,0"
                Background="{DynamicResource BgSecondaryBrush}" Padding="20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Progress -->
                <Grid Grid.Column="0" Margin="0,0,20,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <ProgressBar Height="20"
                                     Value="{Binding DownloadProgress}"
                                     Minimum="0" Maximum="100" />
                        <TextBlock Text="Download Progress"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   FontSize="10" />
                    </Grid>

                    <DockPanel Grid.Row="1" Margin="0,6,0,0">
                        <Button DockPanel.Dock="Right"
                                Content="Stop"
                                Margin="10,0,0,0" Padding="10,4"
                                Command="{Binding StopDownloadCommand}"
                                IsEnabled="{Binding CanStopDownload}"
                                Style="{StaticResource SecondaryButtonStyle}" />
                        <TextBlock Text="{Binding DownloadStatus}"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                    </DockPanel>
                </Grid>

                <!-- Add System button -->
                <Button Grid.Column="1"
                        Content="Add System"
                        Command="{Binding AddSystemCommand}"
                        IsEnabled="{Binding IsAddSystemEnabled}"
                        FontSize="16" FontWeight="Bold"
                        Padding="32,12"
                        Style="{StaticResource PrimaryButtonStyle}" />
            </Grid>
        </Border>

        <!-- Loading overlay -->
        <Border x:Name="LoadingOverlay"
                Grid.Row="0" Grid.RowSpan="3"
                Background="#B31E1E1E"
                Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock x:Name="LoadingText"
                           Text="Loading configuration..."
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           FontSize="14"
                           HorizontalAlignment="Center" />
                <Button x:Name="EmergencyButton"
                        Content="Cancel"
                        Width="100" Margin="0,16,0,0"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="EmergencyOverlay_Click"
                        HorizontalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
