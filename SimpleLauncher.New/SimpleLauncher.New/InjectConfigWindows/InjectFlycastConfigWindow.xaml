<Window Background="{DynamicResource BgPrimaryBrush}" WindowStartupLocation="CenterOwner"
 x:Class="SimpleLauncher.New.InjectConfigWindows.InjectFlycastConfigWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

 Title="{DynamicResource FlycastConfig_Title}"
 Height="450" Width="700"
 
>
 <Grid Margin="10">
 <Grid.RowDefinitions>
 <RowDefinition Height="*" />
 <RowDefinition Height="Auto" />
 </Grid.RowDefinitions>

 <ScrollViewer VerticalScrollBarVisibility="Auto">
 <StackPanel>
 <!-- Video Section -->
 <GroupBox Header="{DynamicResource FlycastConfig_Video_Header}" Margin="0,0,0,10">
 <StackPanel Margin="5">
 <CheckBox IsChecked="{Binding Fullscreen}" Content="{DynamicResource FlycastConfig_Fullscreen_Checkbox}" Margin="0,5" ToolTip="{DynamicResource FlycastConfig_Fullscreen_Tooltip}" />
 <CheckBox IsChecked="{Binding Maximized}" Content="{DynamicResource FlycastConfig_Maximized_Checkbox}" Margin="0,5" ToolTip="{DynamicResource FlycastConfig_Maximized_Tooltip}" />

 <Label Content="{DynamicResource FlycastConfig_Resolution_Label}" Margin="0,5,0,0" ToolTip="{DynamicResource FlycastConfig_Resolution_Tooltip}" />
 <Grid>
 <Grid.ColumnDefinitions>
 <ColumnDefinition Width="*" />
 <ColumnDefinition Width="Auto" />
 <ColumnDefinition Width="*" />
 </Grid.ColumnDefinitions>
 <TextBox Width="80" Text="{Binding Width}" Grid.Column="0" ToolTip="{DynamicResource FlycastConfig_ResolutionX_Tooltip}" />
 <TextBlock Text="x" Grid.Column="1" VerticalAlignment="Center" Margin="10,0" />
 <TextBox Width="80" Text="{Binding Height}" Grid.Column="2" ToolTip="{DynamicResource FlycastConfig_ResolutionY_Tooltip}" />
 </Grid>
 </StackPanel>
 </GroupBox>

 <!-- CRITICAL SETTING -->
 <Border Background="{DynamicResource AccentBrush}" CornerRadius="8" Padding="16" Margin="0,10,0,0" BorderThickness="0">
 <StackPanel>
 <TextBlock Text="{DynamicResource IMPORTANTSETTING}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6" />
 <CheckBox IsChecked="{Binding ShowBeforeLaunch}" Content="{DynamicResource FlycastConfig_ShowBeforeLaunch_Checkbox}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" ToolTip="{DynamicResource FlycastConfig_ShowBeforeLaunch_Tooltip}" />
 </StackPanel>
 </Border>
 </StackPanel>
 </ScrollViewer>

 <!-- Action Buttons -->
 <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
 <Button x:Name="BtnSave" Content="{DynamicResource FlycastConfig_Save_Button}"
 Style="{DynamicResource SecondaryButtonStyle}"
 Command="{Binding SaveCommand}"
 ToolTip="{DynamicResource FlycastConfig_Save_Tooltip}" />
 <Button x:Name="BtnRun" Content="{DynamicResource FlycastConfig_Run_Button2}"
 Style="{DynamicResource PrimaryButtonStyle}"
 Command="{Binding RunCommand}" IsDefault="True"
 Visibility="{Binding IsLauncherMode, Converter={StaticResource BoolToVisibility}}"
 ToolTip="{DynamicResource FlycastConfig_Run_Tooltip}" />
 <Button Content="{DynamicResource FlycastConfig_Cancel_Button}"
 Style="{DynamicResource SecondaryButtonStyle}"
 Command="{Binding CancelCommand}"
 ToolTip="{DynamicResource FlycastConfig_Cancel_Tooltip}" />
 </StackPanel>
 </Grid>
</Window>
