<Window x:Class="SimpleLauncher.Avalonia.MainWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="using:SimpleLauncher.Avalonia.Converters"
        xmlns:vm="using:SimpleLauncher.Avalonia.ViewModels"
        Title="{Binding ToolbarTitle}"
        Height="800" Width="1280"
        MinHeight="550" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgPrimaryBrush}"
        Opened="Window_Opened"
        Closing="Window_Closing">

    <Window.Resources>
        <!-- ReSharper disable once Xaml.RedundantResource -->
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
        <converters:NullToVisibilityConverter x:Key="NullToVisibility" />
        <converters:PathToImageConverter x:Key="PathToImage" />
        <converters:SmartTitleCaseConverter x:Key="SmartTitleCase" />
        <converters:ConsoleToCardHeightConverter x:Key="CardHeightConverter" />

        <!-- Sidebar system item: icon (or glyph fallback) + name + live count badge -->
        <DataTemplate x:Key="SidebarSystemItemTemplate" DataType="{x:Type vm:SidebarSystemItem}">
            <StackPanel Orientation="Horizontal">
                <Image Source="{Binding IconPath}"
                       Width="20" Height="20" Margin="0,0,6,0"
                       VerticalAlignment="Center"
                       IsVisible="{Binding HasIcon}" />
                <TextBlock Text="🎮" FontSize="14" Margin="0,0,6,0"
                           VerticalAlignment="Center"
                           IsVisible="{Binding HasIcon, Converter={StaticResource InverseBoolToVisibility}}" />
                <TextBlock Text="{Binding SystemName}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding CountText}"
                           Foreground="{DynamicResource TextMutedBrush}"
                           FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0" />
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Grid RowDefinitions="44,*,24">

        <!-- ═══ TOOLBAR (Row 0) ═══ -->
        <Border Grid.Row="0" Background="{DynamicResource BgTertiaryBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="8,0" ColumnDefinitions="Auto,Auto,*,Auto">

                <!-- Left: View toggle -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <ToggleButton x:Name="GridViewToggle"
                                  Classes="toolbar-toggle"
                                  IsChecked="True"
                                  ToolTip.Tip="Grid View"
                                  Click="ViewToggle_Click">
                        <TextBlock Text="≡" FontSize="15" />
                    </ToggleButton>
                    <ToggleButton x:Name="ListViewToggle"
                                  Classes="toolbar-toggle"
                                  IsChecked="False"
                                  ToolTip.Tip="List View"
                                  Click="ViewToggle_Click">
                        <TextBlock Text="☰" FontSize="13" />
                    </ToggleButton>
                </StackPanel>

                <!-- Card size slider -->
                <StackPanel Grid.Column="1" Orientation="Horizontal"
                            VerticalAlignment="Center" Margin="14,0,0,0">
                    <TextBlock Text="◉" Foreground="{DynamicResource TextMutedBrush}"
                               FontSize="10" VerticalAlignment="Center" />
                    <Slider x:Name="CardSizeSlider"
                            Width="80" Minimum="148" Maximum="280"
                            Value="{Binding CardWidth}"
                            Margin="6,0" VerticalAlignment="Center" />
                    <TextBlock Text="○" Foreground="{DynamicResource TextMutedBrush}"
                               FontSize="10" VerticalAlignment="Center" />
                </StackPanel>

                <!-- Center: Category tabs -->
                <StackPanel Grid.Column="2" Orientation="Horizontal"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ToggleButton x:Name="GamesTab"
                                  Classes="toolbar-toggle"
                                  IsChecked="True"
                                  Content="Games"
                                  Click="CategoryTab_Click" />
                    <ToggleButton x:Name="RecentTab"
                                  Classes="toolbar-toggle"
                                  IsChecked="False"
                                  Content="Recently Played"
                                  Click="CategoryTab_Click" Margin="2,0,0,0" />
                    <ToggleButton x:Name="FavoritesTab"
                                  Classes="toolbar-toggle"
                                  IsChecked="False"
                                  Content="Favorites"
                                  Click="CategoryTab_Click" Margin="2,0,0,0" />
                </StackPanel>

                <!-- Right: Search box -->
                <Border Grid.Column="3" Background="{DynamicResource BgQuaternaryBrush}"
                        CornerRadius="14" Padding="10,4" MinWidth="200">
                    <Grid>
                        <TextBlock x:Name="SearchPlaceholder"
                                   Text="🔍  Search…"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   FontSize="12" VerticalAlignment="Center"
                                   IsHitTestVisible="False" />
                        <TextBox x:Name="SearchBox"
                                 Classes="search-textbox"
                                 BorderThickness="0" Padding="0,4"
                                 TextChanged="SearchBox_TextChanged" />
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- ═══ BODY (Row 1): Sidebar + Content ═══ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" MinWidth="180" MaxWidth="350" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border Grid.Column="0" Background="{DynamicResource BgSecondaryBrush}">
                <Grid RowDefinitions="*,Auto">

                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,8,0,0">

                            <!-- CONSOLES section -->
                            <ToggleButton x:Name="ConsolesHeader"
                                          Classes="section-header"
                                          IsChecked="True"
                                          Content="CONSOLES" />

                            <StackPanel x:Name="ConsolesPanel" Margin="0,0,0,4">
                                <!-- Manufacturer: ARCADE -->
                                <ToggleButton x:Name="ArcadeGroupHeader"
                                              Classes="section-header"
                                              IsChecked="True"
                                              Content="ARCADE" FontWeight="Normal" FontSize="12"
                                              Padding="28,5" />
                                <StackPanel x:Name="ArcadeGroupPanel">
                                    <ListBox x:Name="ArcadeSystemsList"
                                             Classes="sidebar-list"
                                             ItemsSource="{Binding Sidebar.Groups[0].Systems}"
                                             ItemTemplate="{StaticResource SidebarSystemItemTemplate}"
                                             SelectionChanged="SystemList_SelectionChanged" />
                                </StackPanel>

                                <!-- Manufacturer: NINTENDO -->
                                <ToggleButton x:Name="NintendoGroupHeader"
                                              Classes="section-header"
                                              IsChecked="True"
                                              Content="NINTENDO" FontWeight="Normal" FontSize="12"
                                              Padding="28,5" />
                                <StackPanel x:Name="NintendoGroupPanel">
                                    <ListBox x:Name="NintendoSystemsList"
                                             Classes="sidebar-list"
                                             ItemsSource="{Binding Sidebar.Groups[1].Systems}"
                                             ItemTemplate="{StaticResource SidebarSystemItemTemplate}"
                                             SelectionChanged="SystemList_SelectionChanged" />
                                </StackPanel>

                                <!-- Manufacturer: SEGA -->
                                <ToggleButton x:Name="SegaGroupHeader"
                                              Classes="section-header"
                                              IsChecked="True"
                                              Content="SEGA" FontWeight="Normal" FontSize="12"
                                              Padding="28,5" />
                                <StackPanel x:Name="SegaGroupPanel">
                                    <ListBox x:Name="SegaSystemsList"
                                             Classes="sidebar-list"
                                             ItemsSource="{Binding Sidebar.Groups[2].Systems}"
                                             ItemTemplate="{StaticResource SidebarSystemItemTemplate}"
                                             SelectionChanged="SystemList_SelectionChanged" />
                                </StackPanel>

                                <!-- Manufacturer: SONY -->
                                <ToggleButton x:Name="SonyGroupHeader"
                                              Classes="section-header"
                                              IsChecked="True"
                                              Content="SONY" FontWeight="Normal" FontSize="12"
                                              Padding="28,5" />
                                <StackPanel x:Name="SonyGroupPanel">
                                    <ListBox x:Name="SonySystemsList"
                                             Classes="sidebar-list"
                                             ItemsSource="{Binding Sidebar.Groups[3].Systems}"
                                             ItemTemplate="{StaticResource SidebarSystemItemTemplate}"
                                             SelectionChanged="SystemList_SelectionChanged" />
                                </StackPanel>

                                <!-- Manufacturer: NEC -->
                                <ToggleButton x:Name="NecGroupHeader"
                                              Classes="section-header"
                                              IsChecked="True"
                                              Content="NEC" FontWeight="Normal" FontSize="12"
                                              Padding="28,5" />
                                <StackPanel x:Name="NecGroupPanel">
                                    <ListBox x:Name="NecSystemsList"
                                             Classes="sidebar-list"
                                             ItemsSource="{Binding Sidebar.Groups[4].Systems}"
                                             ItemTemplate="{StaticResource SidebarSystemItemTemplate}"
                                             SelectionChanged="SystemList_SelectionChanged" />
                                </StackPanel>

                                <!-- Manufacturer: SNK -->
                                <ToggleButton x:Name="SnkGroupHeader"
                                              Classes="section-header"
                                              IsChecked="True"
                                              Content="SNK" FontWeight="Normal" FontSize="12"
                                              Padding="28,5" />
                                <StackPanel x:Name="SnkGroupPanel">
                                    <ListBox x:Name="SnkSystemsList"
                                             Classes="sidebar-list"
                                             ItemsSource="{Binding Sidebar.Groups[5].Systems}"
                                             ItemTemplate="{StaticResource SidebarSystemItemTemplate}"
                                             SelectionChanged="SystemList_SelectionChanged" />
                                </StackPanel>

                                <!-- Manufacturer: OTHER -->
                                <ToggleButton x:Name="OtherGroupHeader"
                                              Classes="section-header"
                                              IsChecked="True"
                                              Content="OTHER" FontWeight="Normal" FontSize="12"
                                              Padding="28,5" />
                                <StackPanel x:Name="OtherGroupPanel">
                                    <ListBox x:Name="OtherSystemsList"
                                             Classes="sidebar-list"
                                             ItemsSource="{Binding Sidebar.Groups[6].Systems}"
                                             ItemTemplate="{StaticResource SidebarSystemItemTemplate}"
                                             SelectionChanged="SystemList_SelectionChanged" />
                                </StackPanel>
                            </StackPanel>

                            <!-- COLLECTIONS section -->
                            <TextBlock Classes="sidebar-group-header"
                                       Text="COLLECTIONS" Margin="16,16,16,4" />

                            <ListBox x:Name="CollectionsList"
                                     Classes="sidebar-list"
                                     SelectionChanged="SystemList_SelectionChanged">
                                <ListBoxItem Tag="all">
                                    <TextBlock>
                                        <Run Text="⊞  " FontSize="14" />
                                        <Run Text="All Games" />
                                    </TextBlock>
                                </ListBoxItem>
                                <ListBoxItem Tag="recently_added">
                                    <TextBlock>
                                        <Run Text="🕐  " FontSize="14" />
                                        <Run Text="Recently Added" />
                                    </TextBlock>
                                </ListBoxItem>
                                <ListBoxItem Tag="recently_played">
                                    <TextBlock>
                                        <Run Text="◷  " FontSize="14" />
                                        <Run Text="Recently Played" />
                                    </TextBlock>
                                </ListBoxItem>
                                <ListBoxItem Tag="favorites">
                                    <TextBlock>
                                        <Run Text="♡  " FontSize="14" />
                                        <Run Text="Favorites" />
                                    </TextBlock>
                                </ListBoxItem>
                            </ListBox>

                            <!-- Spacer -->
                            <Rectangle Height="20" />

                        </StackPanel>
                    </ScrollViewer>

                    <!-- Bottom: Add System + Preferences buttons -->
                    <StackPanel Grid.Row="1" Margin="8,4,8,8">
                        <Button Classes="primary"
                                Padding="12,8"
                                Click="AddSystem_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="＋  " FontSize="14" />
                                <TextBlock Text="Add System" />
                            </StackPanel>
                        </Button>
                        <Button Classes="secondary"
                                Margin="0,4,0,0"
                                Padding="12,8"
                                Click="Preferences_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚙  " FontSize="14" />
                                <TextBlock Text="Preferences" />
                            </StackPanel>
                        </Button>
                        <Button Classes="secondary"
                                Margin="0,4,0,0"
                                Padding="12,8"
                                Click="EmulatorSettings_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🎮  " FontSize="14" />
                                <TextBlock Text="Emulator Settings" />
                            </StackPanel>
                        </Button>
                        <Button Classes="secondary"
                                Margin="0,4,0,0"
                                Padding="12,8"
                                Click="RetroAchievements_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🏆  " FontSize="14" />
                                <TextBlock Text="RetroAchievements" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Sidebar resize grip -->
            <GridSplitter Grid.Column="1" Width="4"
                          Background="Transparent"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Stretch" />

            <!-- Content area -->
            <Border Grid.Column="2" Background="{DynamicResource BgPrimaryBrush}">
                <Grid>
                    <!-- Toast notification stack (top-right) -->
                    <StackPanel x:Name="ToastStack"
                                VerticalAlignment="Top" HorizontalAlignment="Right"
                                Margin="16" MaxWidth="360"
                                IsVisible="False" ZIndex="100" />

                    <!-- Game Grid View -->
                    <ListBox x:Name="GameGridView"
                             ItemsSource="{Binding Games}"
                             IsVisible="{Binding IsGridView}"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:GameCardViewModel}">
                                <!-- Card: width from MainViewModel, height from per-system art ratio -->
                                <Border Width="{Binding DataContext.CardWidth, RelativeSource={RelativeSource AncestorType=ListBox}, FallbackValue=168}"
                                        Margin="6"
                                        Cursor="Hand"
                                        PointerPressed="GameCard_Click">
                                    <Border.Height>
                                        <MultiBinding Converter="{StaticResource CardHeightConverter}">
                                            <Binding Path="DataContext.CardWidth" RelativeSource="{RelativeSource AncestorType=ListBox}" FallbackValue="168" />
                                            <Binding Path="SystemName" />
                                            <Binding Path="DataContext.IsMixedView" RelativeSource="{RelativeSource AncestorType=ListBox}" FallbackValue="False" />
                                        </MultiBinding>
                                    </Border.Height>
                                    <Border.Effect>
                                        <DropShadowEffect Color="{DynamicResource ShadowColor}"
                                                          BlurRadius="1"
                                                          OffsetX="0" OffsetY="0"
                                                          Opacity="0.5" />
                                    </Border.Effect>

                                    <Grid RowDefinitions="*,Auto">

                                        <!-- Art area -->
                                        <Border Grid.Row="0"
                                                CornerRadius="{DynamicResource CardCornerRadius}"
                                                ClipToBounds="True"
                                                Margin="2">
                                            <Grid>
                                                <!-- Selection ring -->
                                                <Border x:Name="SelectionRing"
                                                        BorderBrush="{DynamicResource SelectionRingBrush}"
                                                        BorderThickness="3"
                                                        CornerRadius="{DynamicResource CardCornerRadius}"
                                                        IsVisible="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />

                                                <!-- Placeholder (no art) -->
                                                <Border x:Name="PlaceholderBorder"
                                                        Background="{DynamicResource PlaceholderFillBrush}"
                                                        BorderBrush="{DynamicResource PlaceholderStrokeBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="10"
                                                        IsVisible="{Binding HasCover, Converter={StaticResource InverseBoolToVisibility}}">
                                                    <TextBlock Text="{Binding DisplayTitle, Converter={StaticResource SmartTitleCase}}"
                                                               Foreground="{DynamicResource TextMutedBrush}"
                                                               FontSize="12"
                                                               TextWrapping="Wrap"
                                                               TextAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               Margin="8" />
                                                </Border>

                                                <!-- Cover image -->
                                                <Image Source="{Binding CoverPath, Converter={StaticResource PathToImage}}"
                                                       Stretch="Uniform"
                                                       IsVisible="{Binding HasCover}"
                                                       RenderOptions.BitmapInterpolationMode="HighQuality" />

                                                <!-- Favorite heart -->
                                                <Border Background="#99000000"
                                                        CornerRadius="0,0,8,0"
                                                        IsVisible="{Binding IsFavorite}"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Top"
                                                        Padding="4">
                                                    <TextBlock Text="♥"
                                                               Foreground="{DynamicResource FavoriteHeartBrush}"
                                                               FontSize="14" />
                                                </Border>

                                                <!-- RA trophy badge -->
                                                <Border Background="#99000000"
                                                        CornerRadius="8,0,0,0"
                                                        IsVisible="{Binding IsRaSupported}"
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Bottom"
                                                        Padding="4,2">
                                                    <TextBlock Text="🏆"
                                                               FontSize="12"
                                                               ToolTip.Tip="RetroAchievements supported" />
                                                </Border>
                                            </Grid>
                                        </Border>

                                        <!-- Caption area -->
                                        <StackPanel Grid.Row="1" Margin="4,6,4,4">
                                            <TextBlock Text="{Binding DisplayTitle, Converter={StaticResource SmartTitleCase}}"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       FontFamily="{DynamicResource PrimaryFont}"
                                                       FontSize="13"
                                                       MaxHeight="32"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip.Tip="{Binding DisplayTitle}" />
                                            <!-- Rating stars -->
                                            <StackPanel Orientation="Horizontal"
                                                        IsVisible="{Binding Rating, Converter={StaticResource NullToVisibility}}"
                                                        Margin="0,2,0,0">
                                                <TextBlock Text="★★★★★"
                                                           Foreground="{DynamicResource TextMutedBrush}"
                                                           FontSize="10" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Game List View -->
                    <Grid IsVisible="{Binding IsGridView, Converter={StaticResource InverseBoolToVisibility}}" RowDefinitions="Auto,*">
                        <!-- Sortable column headers -->
                        <Border Grid.Row="0"
                                Background="{DynamicResource BgTertiaryBrush}"
                                BorderBrush="{DynamicResource BorderSubtleBrush}"
                                BorderThickness="0,0,0,1">
                            <Grid Margin="10,6" ColumnDefinitions="250,120,100,*">
                                <TextBlock x:Name="ListHeaderName" Text="Name"
                                           Classes="sidebar-group-header" Margin="0"
                                           Cursor="Hand" PointerPressed="ListHeader_Click" Tag="Name" />
                                <TextBlock x:Name="ListHeaderSystem" Grid.Column="1" Text="System"
                                           Classes="sidebar-group-header" Margin="0"
                                           Cursor="Hand" PointerPressed="ListHeader_Click" Tag="System" />
                                <TextBlock x:Name="ListHeaderPlayed" Grid.Column="2" Text="Times Played"
                                           Classes="sidebar-group-header" Margin="0"
                                           Cursor="Hand" PointerPressed="ListHeader_Click" Tag="Times Played" />
                                <TextBlock x:Name="ListHeaderPath" Grid.Column="3" Text="Path"
                                           Classes="sidebar-group-header" Margin="0"
                                           Cursor="Hand" PointerPressed="ListHeader_Click" Tag="Path" />
                            </Grid>
                        </Border>
                        <ListBox x:Name="GameListView"
                                 Grid.Row="1"
                                 ItemsSource="{Binding Games}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 SelectionMode="Single"
                                 DoubleTapped="GameListView_DoubleClick">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:GameCardViewModel}">
                                    <Grid ColumnDefinitions="250,120,100,*" Margin="10,4">
                                        <TextBlock Text="{Binding DisplayTitle, Converter={StaticResource SmartTitleCase}}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                                        <TextBlock Grid.Column="1" Text="{Binding SystemName}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                        <TextBlock Grid.Column="2" Text="{Binding PlayCount}"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                        <TextBlock Grid.Column="3" Text="{Binding FilePath}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource TextMutedBrush}" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                            <ListBox.Styles>
                                <Style Selector="ListBoxItem">
                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                    <Setter Property="FontSize" Value="13" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Background" Value="Transparent" />
                                </Style>
                                <Style Selector="ListBoxItem:pointerover">
                                    <Setter Property="Background" Value="{DynamicResource BgQuaternaryBrush}" />
                                </Style>
                                <Style Selector="ListBoxItem:selected">
                                    <Setter Property="Background" Value="{DynamicResource SelectionBackgroundBrush}" />
                                </Style>
                            </ListBox.Styles>
                        </ListBox>
                    </Grid>

                    <!-- Empty state -->
                    <StackPanel x:Name="EmptyState"
                                VerticalAlignment="Center" HorizontalAlignment="Center"
                                IsVisible="{Binding IsEmpty}">
                        <TextBlock Text="🎮" FontSize="64" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextMutedBrush}" />
                        <TextBlock Text="No Games Found"
                                   FontSize="20" FontWeight="Medium"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   HorizontalAlignment="Center" Margin="0,16,0,4"
                                   FontFamily="{DynamicResource PrimaryFont}" />
                        <TextBlock Text="Select a system from the sidebar or scan for games"
                                   FontSize="13"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center"
                                   FontFamily="{DynamicResource PrimaryFont}" />
                    </StackPanel>

                    <!-- Loading overlay -->
                    <Border x:Name="LoadingOverlay"
                            Background="{DynamicResource OverlayProcessingBrush}"
                            IsVisible="False" ZIndex="50">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <ProgressBar IsIndeterminate="True" Width="200" Height="4"
                                         Foreground="{DynamicResource AccentBrush}" />
                            <TextBlock x:Name="LoadingMessage"
                                       Text="Loading…"
                                       Foreground="White" FontSize="14"
                                       HorizontalAlignment="Center" Margin="0,12,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ═══ STATUS BAR (Row 2) ═══ -->
        <Border Grid.Row="2" Background="{DynamicResource BgSecondaryBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="10,0">
                <TextBlock x:Name="StatusLeft"
                           Text="{Binding GameCountText}"
                           Foreground="{DynamicResource TextMutedBrush}"
                           FontSize="11" VerticalAlignment="Center"
                           HorizontalAlignment="Left" />
                <TextBlock x:Name="StatusRight"
                           Text="{Binding StatusText}"
                           Foreground="{DynamicResource TextMutedBrush}"
                           FontSize="11" VerticalAlignment="Center"
                           HorizontalAlignment="Right" />
            </Grid>
        </Border>

    </Grid>
</Window>
