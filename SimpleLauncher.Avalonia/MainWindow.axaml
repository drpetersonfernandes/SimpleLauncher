<Window x:Class="SimpleLauncher.Avalonia.MainWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="using:SimpleLauncher.Avalonia.Converters"
        xmlns:vm="using:SimpleLauncher.Avalonia.ViewModels"
        Title="{Binding ToolbarTitle}"
        Height="800" Width="1280"
        MinHeight="650" MinWidth="1050"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgPrimaryBrush}"
        Opened="Window_Opened"
        Closing="Window_Closing">

    <Window.Resources>
        <!-- ReSharper disable once Xaml.RedundantResource -->
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
        <converters:NullToVisibilityConverter x:Key="NullToVisibility" />
        <converters:PathToImageConverter x:Key="PathToImage" />
        <converters:SmartTitleCaseConverter x:Key="SmartTitleCase" />
        <converters:ConsoleToCardHeightConverter x:Key="CardHeightConverter" />
        <converters:BooleanToFavoriteStatusConverter x:Key="FavoriteStatusConverter" />
    </Window.Resources>

    <Grid RowDefinitions="Auto,*">

        <!-- ═══ MENU BAR (Row 0) ═══ -->
        <Menu Grid.Row="0"
              Background="{DynamicResource BgSecondaryBrush}"
              BorderBrush="{DynamicResource BgTertiaryBrush}"
              BorderThickness="0,0,0,1"
              FontFamily="{DynamicResource PrimaryFont}"
              FontSize="13"
              Foreground="{DynamicResource TextPrimaryBrush}">

            <!-- ── OPTIONS ── -->
            <MenuItem Header="Options">
                <MenuItem Header="Preferences" Click="Preferences_Click" />
                <MenuItem x:Name="LanguageMenu" Header="Language">
                    <MenuItem x:Name="LanguageArabic" GroupName="LanguageGroup" Header="العربية" Click="ChangeLanguage_Click" ToggleType="CheckBox" />
                    <MenuItem x:Name="LanguageBengali" GroupName="LanguageGroup" Header="বাংলা" Click="ChangeLanguage_Click" ToggleType="CheckBox" />
                    <MenuItem x:Name="LanguageGerman" GroupName="LanguageGroup" Header="Deutsch" Click="ChangeLanguage_Click" ToggleType="CheckBox" />
                    <MenuItem x:Name="LanguageEnglish" GroupName="LanguageGroup" Header="English" Click="ChangeLanguage_Click" ToggleType="CheckBox" />
                    <MenuItem x:Name="LanguageSpanish" GroupName="LanguageGroup" Header="Español" Click="ChangeLanguage_Click" ToggleType="CheckBox" />
                    <MenuItem x:Name="LanguageFrench" GroupName="LanguageGroup" Header="Français" Click="ChangeLanguage_Click" ToggleType="CheckBox" />
                    <MenuItem x:Name="LanguageHindi" GroupName="LanguageGroup" Header="हिन्दी" Click="ChangeLanguage_Click" ToggleType="CheckBox" />
                    <MenuItem x:Name="LanguageIndonesianMalay" GroupName="LanguageGroup" Header="Indonesian (Malay)" Click="ChangeLanguage_Click" ToggleType="CheckBox" />
                    <MenuItem x:Name="LanguageItalian" GroupName="LanguageGroup" Header="Italiano" Click="ChangeLanguage_Click" ToggleType="CheckBox" />
                    <MenuItem x:Name="LanguageJapanese" GroupName="LanguageGroup" Header="日本語" Click="ChangeLanguage_Click" ToggleType="CheckBox" />
                    <MenuItem x:Name="LanguageKorean" GroupName="LanguageGroup" Header="한국어" Click="ChangeLanguage_Click" ToggleType="CheckBox" />
                    <MenuItem x:Name="LanguageDutch" GroupName="LanguageGroup" Header="Nederlands" Click="ChangeLanguage_Click" ToggleType="CheckBox" />
                    <MenuItem x:Name="LanguagePortugueseBr" GroupName="LanguageGroup" Header="Português" Click="ChangeLanguage_Click" ToggleType="CheckBox" />
                    <MenuItem x:Name="LanguageRussian" GroupName="LanguageGroup" Header="Русский" Click="ChangeLanguage_Click" ToggleType="CheckBox" />
                    <MenuItem x:Name="LanguageTurkish" GroupName="LanguageGroup" Header="Türkçe" Click="ChangeLanguage_Click" ToggleType="CheckBox" />
                    <MenuItem x:Name="LanguageUrdu" GroupName="LanguageGroup" Header="اردو" Click="ChangeLanguage_Click" ToggleType="CheckBox" />
                    <MenuItem x:Name="LanguageVietnamese" GroupName="LanguageGroup" Header="Tiếng Việt" Click="ChangeLanguage_Click" ToggleType="CheckBox" />
                    <MenuItem x:Name="LanguageChineseSimplified" GroupName="LanguageGroup" Header="简体中文" Click="ChangeLanguage_Click" ToggleType="CheckBox" />
                </MenuItem>
                <Separator />
                <MenuItem x:Name="SizeMenu" Header="Set Button Size">
                    <MenuItem Header="50 px" Tag="50" Click="ButtonSizeClickAsync" ToggleType="CheckBox" />
                    <MenuItem Header="100 px" Tag="100" Click="ButtonSizeClickAsync" ToggleType="CheckBox" />
                    <MenuItem Header="150 px" Tag="150" Click="ButtonSizeClickAsync" ToggleType="CheckBox" />
                    <MenuItem Header="200 px" Tag="200" Click="ButtonSizeClickAsync" ToggleType="CheckBox" />
                    <MenuItem Header="250 px" Tag="250" Click="ButtonSizeClickAsync" ToggleType="CheckBox" />
                    <MenuItem Header="300 px" Tag="300" Click="ButtonSizeClickAsync" ToggleType="CheckBox" />
                    <MenuItem Header="350 px" Tag="350" Click="ButtonSizeClickAsync" ToggleType="CheckBox" />
                    <MenuItem Header="400 px" Tag="400" Click="ButtonSizeClickAsync" ToggleType="CheckBox" />
                    <MenuItem Header="450 px" Tag="450" Click="ButtonSizeClickAsync" ToggleType="CheckBox" />
                    <MenuItem Header="500 px" Tag="500" Click="ButtonSizeClickAsync" ToggleType="CheckBox" />
                    <MenuItem Header="550 px" Tag="550" Click="ButtonSizeClickAsync" ToggleType="CheckBox" />
                    <MenuItem Header="600 px" Tag="600" Click="ButtonSizeClickAsync" ToggleType="CheckBox" />
                    <MenuItem Header="650 px" Tag="650" Click="ButtonSizeClickAsync" ToggleType="CheckBox" />
                    <MenuItem Header="700 px" Tag="700" Click="ButtonSizeClickAsync" ToggleType="CheckBox" />
                    <MenuItem Header="750 px" Tag="750" Click="ButtonSizeClickAsync" ToggleType="CheckBox" />
                    <MenuItem Header="800 px" Tag="800" Click="ButtonSizeClickAsync" ToggleType="CheckBox" />
                </MenuItem>
                <MenuItem x:Name="AspectRatioMenu" Header="Set Button Aspect Ratio">
                    <MenuItem x:Name="Square" GroupName="AspectRatioGroup" Header="Square" Click="ButtonAspectRatioClickAsync" ToggleType="CheckBox" />
                    <MenuItem x:Name="Wider" GroupName="AspectRatioGroup" Header="Wider" Click="ButtonAspectRatioClickAsync" ToggleType="CheckBox" />
                    <MenuItem x:Name="SuperWider" GroupName="AspectRatioGroup" Header="Super Wider" Click="ButtonAspectRatioClickAsync" ToggleType="CheckBox" />
                    <MenuItem x:Name="SuperWider2" GroupName="AspectRatioGroup" Header="Super Wider 2" Click="ButtonAspectRatioClickAsync" ToggleType="CheckBox" />
                    <MenuItem x:Name="Taller" GroupName="AspectRatioGroup" Header="Taller" Click="ButtonAspectRatioClickAsync" ToggleType="CheckBox" />
                    <MenuItem x:Name="SuperTaller" GroupName="AspectRatioGroup" Header="Super Taller" Click="ButtonAspectRatioClickAsync" ToggleType="CheckBox" />
                    <MenuItem x:Name="SuperTaller2" GroupName="AspectRatioGroup" Header="Super Taller 2" Click="ButtonAspectRatioClickAsync" ToggleType="CheckBox" />
                </MenuItem>
                <MenuItem x:Name="GamesPerPageMenu" Header="Set Number of Games Per Page">
                    <MenuItem Header="100 games" Tag="100" Click="GamesPerPageClickAsync" ToggleType="CheckBox" />
                    <MenuItem Header="200 games" Tag="200" Click="GamesPerPageClickAsync" ToggleType="CheckBox" />
                    <MenuItem Header="300 games" Tag="300" Click="GamesPerPageClickAsync" ToggleType="CheckBox" />
                    <MenuItem Header="400 games" Tag="400" Click="GamesPerPageClickAsync" ToggleType="CheckBox" />
                    <MenuItem Header="500 games" Tag="500" Click="GamesPerPageClickAsync" ToggleType="CheckBox" />
                    <MenuItem Header="1000 games" Tag="1000" Click="GamesPerPageClickAsync" ToggleType="CheckBox" />
                    <MenuItem Header="10000 games" Tag="10000" Click="GamesPerPageClickAsync" ToggleType="CheckBox" />
                    <MenuItem Header="1000000 games" Tag="1000000" Click="GamesPerPageClickAsync" ToggleType="CheckBox" />
                </MenuItem>
                <Separator />
                <MenuItem Header="View Mode">
                    <MenuItem x:Name="GridView" GroupName="ViewModeGroup" Header="Grid View" Click="ChangeViewMode_Click" ToggleType="CheckBox" />
                    <MenuItem x:Name="ListView" GroupName="ViewModeGroup" Header="List View" Click="ChangeViewMode_Click" ToggleType="CheckBox" />
                </MenuItem>
                <MenuItem Header="Show Games">
                    <MenuItem x:Name="ShowAll" GroupName="ShowGamesGroup" Header="Show All Games" Click="ShowGamesClickAsync" ToggleType="CheckBox" />
                    <MenuItem x:Name="ShowWithCover" GroupName="ShowGamesGroup" Header="Show Only Games With Cover" Click="ShowGamesClickAsync" ToggleType="CheckBox" />
                    <MenuItem x:Name="ShowWithoutCover" GroupName="ShowGamesGroup" Header="Show Only Games Without Cover" Click="ShowGamesClickAsync" ToggleType="CheckBox" />
                </MenuItem>
                <MenuItem Header="Filename Preferences">
                    <MenuItem x:Name="FilenameDisplayOriginal" GroupName="FilenameGroup" Header="Display Original Filenames" Click="FilenameDisplayMode_ClickAsync" ToggleType="CheckBox" />
                    <MenuItem x:Name="FilenameDisplayCleanUp" GroupName="FilenameGroup" Header="Display Clean Up Filenames" Click="FilenameDisplayMode_ClickAsync" ToggleType="CheckBox" />
                    <MenuItem x:Name="FilenameDisplayNoFilename" GroupName="FilenameGroup" Header="Display No Filename" Click="FilenameDisplayMode_ClickAsync" ToggleType="CheckBox" />
                    <Separator />
                    <MenuItem x:Name="DisplayMachineNameToggle" Header="Display Machine Name" Click="DisplayMachineName_ClickAsync" ToggleType="CheckBox" />
                    <Separator />
                    <MenuItem x:Name="FilenameFontSizeMenu" Header="Filename Font Size">
                        <MenuItem x:Name="FilenameFontSizeSmall" GroupName="FilenameFontGroup" Header="Small" Click="FilenameFontSize_ClickAsync" ToggleType="CheckBox" />
                        <MenuItem x:Name="FilenameFontSizeNormal" GroupName="FilenameFontGroup" Header="Normal" Click="FilenameFontSize_ClickAsync" ToggleType="CheckBox" />
                        <MenuItem x:Name="FilenameFontSizeBig" GroupName="FilenameFontGroup" Header="Big" Click="FilenameFontSize_ClickAsync" ToggleType="CheckBox" />
                    </MenuItem>
                    <MenuItem x:Name="MachineNameFontSizeMenu" Header="Machine Name Font Size">
                        <MenuItem x:Name="MachineNameFontSizeSmall" GroupName="MachineNameFontGroup" Header="Small" Click="MachineNameFontSize_ClickAsync" ToggleType="CheckBox" />
                        <MenuItem x:Name="MachineNameFontSizeNormal" GroupName="MachineNameFontGroup" Header="Normal" Click="MachineNameFontSize_ClickAsync" ToggleType="CheckBox" />
                        <MenuItem x:Name="MachineNameFontSizeBig" GroupName="MachineNameFontGroup" Header="Big" Click="MachineNameFontSize_ClickAsync" ToggleType="CheckBox" />
                    </MenuItem>
                </MenuItem>
                <Separator />
                <MenuItem Header="Edit Links" Click="EditLinks_Click" />
                <MenuItem Header="Gamepad Support">
                    <MenuItem x:Name="ToggleGamepad" Header="Enable" Click="ToggleGamepad_Click" ToggleType="CheckBox" />
                    <MenuItem Header="Set Gamepad Dead Zone" Click="SetGamepadDeadZone_Click" />
                </MenuItem>
                <MenuItem Header="Fuzzy Image Matching">
                    <MenuItem x:Name="ToggleFuzzyMatching" Header="Enable" Click="ToggleFuzzyMatchingClickAsync" ToggleType="CheckBox" />
                    <MenuItem x:Name="ToggleAnnotationStripping" Header="Strip Annotations" Click="ToggleAnnotationStrippingClickAsync" ToggleType="CheckBox" />
                    <MenuItem Header="Set Threshold" Click="SetFuzzyMatchingThreshold_Click" />
                </MenuItem>
                <MenuItem Header="Sound Configuration" Click="SoundConfiguration_Click" />
                <MenuItem Header="RetroAchievements Settings">
                    <MenuItem Header="RetroAchievements Settings" Click="RetroAchievementsSettings_Click" />
                    <Separator />
                    <MenuItem Header="Show Games With RetroAchievements" Command="{Binding ShowGamesWithRetroAchievementsCommand}" />
                    <MenuItem Header="Calculate Hashes For All Game Paths" Click="CalculateHashesForAllGamePaths_Click" />
                </MenuItem>
                <MenuItem Header="Inject Emulator Config">
                    <MenuItem Header="Ares Settings" Tag="Ares" Click="ShowEmulatorConfig_Click" />
                    <MenuItem Header="Azahar Settings" Tag="Azahar" Click="ShowEmulatorConfig_Click" />
                    <MenuItem Header="Blastem Settings" Tag="Blastem" Click="ShowEmulatorConfig_Click" />
                    <MenuItem Header="Cemu Settings" Tag="Cemu" Click="ShowEmulatorConfig_Click" />
                    <MenuItem Header="Daphne Settings" Tag="Daphne" Click="ShowEmulatorConfig_Click" />
                    <MenuItem Header="Dolphin Settings" Tag="Dolphin" Click="ShowEmulatorConfig_Click" />
                    <MenuItem Header="DuckStation Settings" Tag="DuckStation" Click="ShowEmulatorConfig_Click" />
                    <MenuItem Header="Flycast Settings" Tag="Flycast" Click="ShowEmulatorConfig_Click" />
                    <MenuItem Header="Mame Settings" Tag="Mame" Click="ShowEmulatorConfig_Click" />
                    <MenuItem Header="Mednafen Settings" Tag="Mednafen" Click="ShowEmulatorConfig_Click" />
                    <MenuItem Header="Mesen Settings" Tag="Mesen" Click="ShowEmulatorConfig_Click" />
                    <MenuItem Header="PCSX2 Settings" Tag="PCSX2" Click="ShowEmulatorConfig_Click" />
                    <MenuItem Header="Raine Settings" Tag="Raine" Click="ShowEmulatorConfig_Click" />
                    <MenuItem Header="Redream Settings" Tag="Redream" Click="ShowEmulatorConfig_Click" />
                    <MenuItem Header="RetroArch Settings" Tag="RetroArch" Click="ShowEmulatorConfig_Click" />
                    <MenuItem Header="RPCS3 Settings" Tag="RPCS3" Click="ShowEmulatorConfig_Click" />
                    <MenuItem Header="SEGA Model 2 Settings" Tag="SegaModel2" Click="ShowEmulatorConfig_Click" />
                    <MenuItem Header="Stella Settings" Tag="Stella" Click="ShowEmulatorConfig_Click" />
                    <MenuItem Header="Supermodel Settings" Tag="Supermodel" Click="ShowEmulatorConfig_Click" />
                    <MenuItem Header="Xenia Settings" Tag="Xenia" Click="ShowEmulatorConfig_Click" />
                    <MenuItem Header="Yumir Settings" Tag="Yumir" Click="ShowEmulatorConfig_Click" />
                </MenuItem>
                <MenuItem Header="Overlay Button Settings">
                    <MenuItem x:Name="RetroAchievementButton" Header="RetroAchievement Overlay Button" Click="ToggleOverlayButton_ClickAsync" ToggleType="CheckBox" />
                    <MenuItem x:Name="VideoLinkButton" Header="Video Link Overlay Button" Click="ToggleOverlayButton_ClickAsync" ToggleType="CheckBox" />
                    <MenuItem x:Name="InfoLinkButton" Header="Info Link Overlay Button" Click="ToggleOverlayButton_ClickAsync" ToggleType="CheckBox" />
                </MenuItem>
            </MenuItem>

            <!-- ── EDIT SYSTEM ── -->
            <MenuItem Header="Edit System">
                <MenuItem Header="Add New System" Click="EasyMode_Click" />
                <MenuItem Header="Edit System" Click="ExpertMode_Click" />
                <MenuItem Header="Download Image Pack" Click="DownloadImagePack_Click" />
                <MenuItem Header="Scan For Microsoft Windows Games" Click="ScanForMicrosoftWindowsGames_ClickAsync" />
            </MenuItem>

            <!-- ── SELECT WINDOW ── -->
            <MenuItem Header="Select Window">
                <MenuItem Header="Global Stats" Click="GlobalStats_Click" />
                <MenuItem Header="RetroAchievements" Click="RetroAchievements_Click" />
            </MenuItem>

            <!-- ── TOOLS ── -->
            <MenuItem Header="Tools">
                <MenuItem Header="Batch Convert Iso To Xiso" Tag="BatchConvertIsoToXiso" Click="LaunchTool_Click" />
                <MenuItem Header="Batch Convert To CHD" Tag="BatchConvertToCHD" Click="LaunchTool_Click" />
                <MenuItem Header="Batch Convert To Compressed File" Tag="BatchConvertToCompressedFile" Click="LaunchTool_Click" />
                <MenuItem Header="Batch Convert To RVZ" Tag="BatchConvertToRVZ" Click="LaunchTool_Click" />
                <MenuItem Header="Create Batch Files For PS3 Games" Tag="CreateBatchFilesForPS3Games" Click="LaunchTool_Click" />
                <MenuItem Header="Create Batch Files For ScummVM Games" Tag="CreateBatchFilesForScummVMGames" Click="LaunchTool_Click" />
                <MenuItem Header="Create Batch Files For Windows Games" Tag="CreateBatchFilesForWindowsGames" Click="LaunchTool_Click" />
                <MenuItem Header="Create Batch Files For Xbox360 XBLA Games" Tag="CreateBatchFilesForXbox360XBLAGames" Click="LaunchTool_Click" />
                <MenuItem Header="Find Rom Cover" Tag="FindRomCover" Click="LaunchTool_Click" />
                <MenuItem Header="Retro Game Cover Downloader" Tag="RetroGameCoverDownloader" Click="LaunchTool_Click" />
                <MenuItem Header="Rom Validator" Tag="RomValidator" Click="LaunchTool_Click" />
            </MenuItem>

            <!-- ── DONATE ── -->
            <MenuItem Header="Donate" Click="Donate_Click" />

            <!-- ── ABOUT ── -->
            <MenuItem Header="About">
                <MenuItem Header="About" Click="About_Click" />
                <MenuItem Header="Support" Click="Support_Click" />
                <MenuItem Header="Open App Data Path" Click="OpenAppDataPath_Click" />
                <Separator />
                <MenuItem Header="Exit" Click="Exit_Click" />
            </MenuItem>
        </Menu>

        <!-- ═══ BODY (Row 1) ═══ -->
        <Grid Grid.Row="1" ColumnDefinitions="64,4,*">

            <!-- ═══ LEFT NAVIGATION RAIL (WPF LeftNavigationPanel parity) ═══ -->
            <Border Grid.Column="0" Width="64"
                    Background="{DynamicResource BgSecondaryBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                    BorderThickness="0,0,1,0"
                    ToolTip.Tip="Navigation">
                <StackPanel Orientation="Vertical" HorizontalAlignment="Center" Spacing="2">
                    <Button x:Name="NavRestartButton" Classes="nav-icon" ToolTip.Tip="Restart / Home"
                            Click="NavRestartButton_Click">
                        <TextBlock Text="⌂" FontSize="18" />
                    </Button>
                    <Button x:Name="NavFavoritesButton" Classes="nav-icon" ToolTip.Tip="Favorites"
                            Click="NavFavoritesButton_Click">
                        <TextBlock Text="♥" FontSize="16" />
                    </Button>
                    <Button x:Name="NavGlobalSearchButton" Classes="nav-icon" ToolTip.Tip="Global Search"
                            Click="NavGlobalSearchButton_Click">
                        <TextBlock Text="🔍" FontSize="14" />
                    </Button>
                    <Button x:Name="NavHistoryButton" Classes="nav-icon" ToolTip.Tip="Play History"
                            Click="NavHistoryButton_Click">
                        <TextBlock Text="◷" FontSize="16" />
                    </Button>
                    <Button x:Name="NavRetroAchievementsButton" Classes="nav-icon" ToolTip.Tip="RetroAchievements"
                            Click="NavRetroAchievementsButton_Click">
                        <TextBlock Text="🏆" FontSize="14" />
                    </Button>
                    <Button x:Name="NavEditSystemButton" Classes="nav-icon" ToolTip.Tip="Edit System"
                            Click="NavEditSystemButton_Click">
                        <TextBlock Text="⚙" FontSize="16" />
                    </Button>
                    <Button x:Name="NavToggleViewModeButton" Classes="nav-icon" ToolTip.Tip="Toggle View Mode"
                            Click="NavToggleViewModeButton_Click">
                        <TextBlock Text="⊞" FontSize="16" />
                    </Button>
                    <Button x:Name="NavToggleButtonAspectRatioButton" Classes="nav-icon" ToolTip.Tip="Toggle Button Aspect Ratio"
                            Click="NavToggleButtonAspectRatioButton_Click">
                        <TextBlock Text="⛶" FontSize="16" />
                    </Button>
                    <Button x:Name="NavZoomInButton" Classes="nav-icon" ToolTip.Tip="Zoom In"
                            Click="NavZoomInButton_Click">
                        <TextBlock Text="＋" FontSize="16" />
                    </Button>
                    <Button x:Name="NavZoomOutButton" Classes="nav-icon" ToolTip.Tip="Zoom Out"
                            Click="NavZoomOutButton_Click">
                        <TextBlock Text="－" FontSize="16" />
                    </Button>
                </StackPanel>
            </Border>

            <!-- Rail resize grip -->
            <GridSplitter Grid.Column="1" Width="4"
                          Background="Transparent"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Stretch" />

            <!-- ═══ MAIN AREA ═══ -->
            <Grid Grid.Column="2" RowDefinitions="Auto,*,Auto">

                <!-- ═══ TOP SYSTEM SELECTION (WPF TopSystemSelection parity) ═══ -->
                <Border Grid.Row="0" Background="{DynamicResource BgTertiaryBrush}"
                        BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1">
                    <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,Auto,*,Auto,Auto">

                        <!-- Row 0: Letter / number filter bar -->
                        <ScrollViewer Grid.Row="0" Grid.ColumnSpan="5"
                                      x:Name="LetterBarScroller"
                                      HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Disabled"
                                      Height="28">
                            <StackPanel x:Name="LetterFilterBar" Orientation="Horizontal" Spacing="2" />
                        </ScrollViewer>

                        <!-- Row 1: System + Emulator ComboBoxes -->
                        <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal"
                                    VerticalAlignment="Center" Margin="8,2,0,0">
                            <TextBlock Text="System:" FontSize="12"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       VerticalAlignment="Center" Margin="0,0,4,0" />
                            <ComboBox x:Name="SystemComboBox" Width="190" MinWidth="150"
                                      VerticalAlignment="Center"
                                      SelectionChanged="SystemComboBox_SelectionChanged" />
                            <TextBlock Text="  Emulator:" FontSize="12"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       VerticalAlignment="Center" Margin="6,0,4,0" />
                            <ComboBox x:Name="EmulatorComboBox" Width="150" MinWidth="120"
                                      VerticalAlignment="Center"
                                      SelectionChanged="EmulatorComboBox_SelectionChanged" />
                        </StackPanel>

                        <!-- Row 1: Search box -->
                        <Border Grid.Row="1" Grid.Column="2" Background="{DynamicResource BgQuaternaryBrush}"
                                CornerRadius="14" Padding="10,4" MinWidth="180" MaxWidth="280">
                            <Grid>
                                <TextBlock x:Name="SearchPlaceholder"
                                           Text="🔍  Search…"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           FontSize="12" VerticalAlignment="Center"
                                           IsHitTestVisible="False" />
                                <TextBox x:Name="SearchBox"
                                         Classes="search-textbox"
                                         BorderThickness="0" Padding="0,4"
                                         TextChanged="SearchBox_TextChanged" />
                            </Grid>
                        </Border>

                        <!-- Row 1: Quick actions (view toggle / home / random / sort / card size) -->
                        <StackPanel Grid.Row="1" Grid.Column="3" Orientation="Horizontal"
                                    VerticalAlignment="Center" Spacing="2">
                            <ToggleButton x:Name="GridViewToggle"
                                          Classes="toolbar-toggle"
                                          IsChecked="True"
                                          ToolTip.Tip="Grid View"
                                          Click="ViewToggle_Click">
                                <TextBlock Text="≡" FontSize="15" />
                            </ToggleButton>
                            <ToggleButton x:Name="ListViewToggle"
                                          Classes="toolbar-toggle"
                                          IsChecked="False"
                                          ToolTip.Tip="List View"
                                          Click="ViewToggle_Click">
                                <TextBlock Text="☰" FontSize="13" />
                            </ToggleButton>
                            <Button x:Name="HomeButton"
                                    Classes="toolbar-icon"
                                    Padding="8,4"
                                    ToolTip.Tip="Restart / Home"
                                    Click="HomeButton_Click">
                                <TextBlock Text="⌂" FontSize="15" />
                            </Button>
                            <Button x:Name="RandomGameButton"
                                    Classes="toolbar-icon"
                                    Padding="8,4"
                                    ToolTip.Tip="Feeling Lucky - pick a random game"
                                    Click="RandomGameButton_Click">
                                <TextBlock Text="🎲" FontSize="13" />
                            </Button>
                            <Button x:Name="MameSortOrderButton"
                                    Classes="toolbar-icon"
                                    Padding="8,4"
                                    ToolTip.Tip="Sort order: File Name"
                                    Click="MameSortOrderButton_Click">
                                <TextBlock Text="⇅" FontSize="14" />
                            </Button>
                        </StackPanel>

                        <!-- Row 1: Card size slider -->
                        <StackPanel Grid.Row="1" Grid.Column="4" Orientation="Horizontal"
                                    VerticalAlignment="Center" Margin="8,0,0,0">
                            <TextBlock Text="◉" Foreground="{DynamicResource TextMutedBrush}"
                                       FontSize="10" VerticalAlignment="Center" />
                            <Slider x:Name="CardSizeSlider"
                                    Width="80" Minimum="50" Maximum="800"
                                    Value="{Binding CardWidth}"
                                    Margin="4,0" VerticalAlignment="Center" />
                            <TextBlock Text="○" Foreground="{DynamicResource TextMutedBrush}"
                                       FontSize="10" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ═══ BODY (Row 1): Game content ═══ -->
                <Border Grid.Row="1" Background="{DynamicResource BgPrimaryBrush}">
                    <Grid>
                        <!-- Toast notification stack (top-right) -->
                        <StackPanel x:Name="ToastStack"
                                    VerticalAlignment="Top" HorizontalAlignment="Right"
                                    Margin="16" MaxWidth="360"
                                    IsVisible="False" ZIndex="100" />

                        <!-- Game browser (grid / list / empty state) — hidden while a section is open -->
                        <Grid x:Name="GameBrowserPanel">

                        <!-- Game Grid View -->
                        <ListBox x:Name="GameGridView"
                                 ItemsSource="{Binding Games}"
                                 IsVisible="{Binding IsGridView}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:GameCardViewModel}">
                                    <!-- Card: width from MainViewModel, height from per-system art ratio -->
                                    <Border Width="{Binding DataContext.CardWidth, RelativeSource={RelativeSource AncestorType=ListBox}, FallbackValue=168}"
                                            Margin="6"
                                            Cursor="Hand"
                                            PointerPressed="GameCard_Click">
                                        <Border.Height>
                                            <MultiBinding Converter="{StaticResource CardHeightConverter}">
                                                <Binding Path="DataContext.CardWidth" RelativeSource="{RelativeSource AncestorType=ListBox}" FallbackValue="168" />
                                                <Binding Path="SystemName" />
                                                <Binding Path="DataContext.IsMixedView" RelativeSource="{RelativeSource AncestorType=ListBox}" FallbackValue="False" />
                                            </MultiBinding>
                                        </Border.Height>
                                        <Border.Effect>
                                            <DropShadowEffect Color="{DynamicResource ShadowColor}"
                                                              BlurRadius="1"
                                                              OffsetX="0" OffsetY="0"
                                                              Opacity="0.5" />
                                        </Border.Effect>

                                        <Grid RowDefinitions="*,Auto">

                                            <!-- Art area -->
                                            <Border Grid.Row="0"
                                                    CornerRadius="{DynamicResource CardCornerRadius}"
                                                    ClipToBounds="True"
                                                    Margin="2">
                                                <Grid>
                                                    <!-- Selection ring -->
                                                    <Border x:Name="SelectionRing"
                                                            BorderBrush="{DynamicResource SelectionRingBrush}"
                                                            BorderThickness="3"
                                                            CornerRadius="{DynamicResource CardCornerRadius}"
                                                            IsVisible="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />

                                                    <!-- Placeholder (no art) -->
                                                    <Border x:Name="PlaceholderBorder"
                                                            Background="{DynamicResource PlaceholderFillBrush}"
                                                            BorderBrush="{DynamicResource PlaceholderStrokeBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="10"
                                                            IsVisible="{Binding HasCover, Converter={StaticResource InverseBoolToVisibility}}">
                                                        <TextBlock Text="{Binding DisplayTitle, Converter={StaticResource SmartTitleCase}}"
                                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                                   FontSize="12"
                                                                   TextWrapping="Wrap"
                                                                   TextAlignment="Center"
                                                                   VerticalAlignment="Center"
                                                                   Margin="8" />
                                                    </Border>

                                                    <!-- Cover image -->
                                                    <Image Source="{Binding CoverPath, Converter={StaticResource PathToImage}}"
                                                           Stretch="Uniform"
                                                           IsVisible="{Binding HasCover}"
                                                           RenderOptions.BitmapInterpolationMode="HighQuality" />

                                                    <!-- Favorite heart -->
                                                    <Border Background="#99000000"
                                                            CornerRadius="0,0,8,0"
                                                            IsVisible="{Binding IsFavorite}"
                                                            HorizontalAlignment="Right"
                                                            VerticalAlignment="Top"
                                                            Padding="4">
                                                        <TextBlock Text="♥"
                                                                   Foreground="{DynamicResource FavoriteHeartBrush}"
                                                                   FontSize="14"
                                                                   AutomationProperties.Name="{Binding IsFavorite, Converter={StaticResource FavoriteStatusConverter}}" />
                                                    </Border>

                                                    <!-- RA trophy badge -->
                                                    <Border Background="#99000000"
                                                            CornerRadius="8,0,0,0"
                                                            IsVisible="{Binding IsRaSupported}"
                                                            HorizontalAlignment="Left"
                                                            VerticalAlignment="Bottom"
                                                            Padding="4,2">
                                                        <TextBlock Text="🏆"
                                                                   FontSize="12"
                                                                   ToolTip.Tip="RetroAchievements supported" />
                                                    </Border>
                                                </Grid>
                                            </Border>

                                            <!-- Caption area -->
                                            <StackPanel Grid.Row="1" Margin="4,6,4,4">
                                                <TextBlock Text="{Binding DisplayTitle, Converter={StaticResource SmartTitleCase}}"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                           FontFamily="{DynamicResource PrimaryFont}"
                                                           FontSize="{Binding DataContext.CaptionFontSize, RelativeSource={RelativeSource AncestorType=ListBox}, FallbackValue=13}"
                                                           MaxHeight="32"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip.Tip="{Binding DisplayTitle}" />
                                                <!-- Rating stars -->
                                                <StackPanel Orientation="Horizontal"
                                                            IsVisible="{Binding Rating, Converter={StaticResource NullToVisibility}}"
                                                            Margin="0,2,0,0">
                                                    <TextBlock Text="★★★★★"
                                                               Foreground="{DynamicResource TextMutedBrush}"
                                                               FontSize="10" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- Game List View -->
                        <Grid IsVisible="{Binding IsGridView, Converter={StaticResource InverseBoolToVisibility}}" RowDefinitions="Auto,*">
                            <!-- Sortable column headers -->
                            <Border Grid.Row="0"
                                    Background="{DynamicResource BgTertiaryBrush}"
                                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                                    BorderThickness="0,0,0,1">
                                <Grid Margin="10,6" ColumnDefinitions="250,120,100,*">
                                    <TextBlock x:Name="ListHeaderName" Text="Name"
                                               Classes="sidebar-group-header" Margin="0"
                                               Cursor="Hand" PointerPressed="ListHeader_Click" Tag="Name" />
                                    <TextBlock x:Name="ListHeaderSystem" Grid.Column="1" Text="System"
                                               Classes="sidebar-group-header" Margin="0"
                                               Cursor="Hand" PointerPressed="ListHeader_Click" Tag="System" />
                                    <TextBlock x:Name="ListHeaderPlayed" Grid.Column="2" Text="Times Played"
                                               Classes="sidebar-group-header" Margin="0"
                                               Cursor="Hand" PointerPressed="ListHeader_Click" Tag="Times Played" />
                                    <TextBlock x:Name="ListHeaderPath" Grid.Column="3" Text="Path"
                                               Classes="sidebar-group-header" Margin="0"
                                               Cursor="Hand" PointerPressed="ListHeader_Click" Tag="Path" />
                                </Grid>
                            </Border>
                            <ListBox x:Name="GameListView"
                                     Grid.Row="1"
                                     ItemsSource="{Binding Games}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     SelectionMode="Single"
                                     DoubleTapped="GameListView_DoubleClick">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:GameCardViewModel}">
                                        <Grid ColumnDefinitions="*,120,100,*" Margin="10,4"
                                              Cursor="Hand" PointerPressed="GameListItem_Click">
                                            <TextBlock Text="{Binding DisplayTitle, Converter={StaticResource SmartTitleCase}}"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                                            <TextBlock Grid.Column="1" Text="{Binding SystemName}"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                                            <TextBlock Grid.Column="2" Text="{Binding PlayCount}"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                                            <TextBlock Grid.Column="3" Text="{Binding FilePath}"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource TextMutedBrush}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                                <ListBox.Styles>
                                    <Style Selector="ListBoxItem">
                                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                        <Setter Property="FontSize" Value="13" />
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="Background" Value="Transparent" />
                                    </Style>
                                    <Style Selector="ListBoxItem:pointerover">
                                        <Setter Property="Background" Value="{DynamicResource BgQuaternaryBrush}" />
                                    </Style>
                                    <Style Selector="ListBoxItem:selected">
                                        <Setter Property="Background" Value="{DynamicResource SelectionBackgroundBrush}" />
                                    </Style>
                                </ListBox.Styles>
                            </ListBox>
                        </Grid>

                        <!-- Empty state -->
                        <StackPanel x:Name="EmptyState"
                                    VerticalAlignment="Center" HorizontalAlignment="Center"
                                    IsVisible="{Binding IsEmpty}">
                            <TextBlock Text="🎮" FontSize="64" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource TextMutedBrush}" />
                            <TextBlock Text="No Games Found"
                                       FontSize="20" FontWeight="Medium"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       HorizontalAlignment="Center" Margin="0,16,0,4"
                                       FontFamily="{DynamicResource PrimaryFont}" />
                            <TextBlock Text="Select a system or scan for games"
                                       FontSize="13"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center"
                                       FontFamily="{DynamicResource PrimaryFont}" />
                        </StackPanel>
                        </Grid>

                        <!-- Loading overlay -->
                        <Border x:Name="LoadingOverlay"
                                Background="{DynamicResource OverlayProcessingBrush}"
                                IsVisible="{Binding IsLoading}" ZIndex="50">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <ProgressBar IsIndeterminate="True" Width="200" Height="4"
                                             Foreground="{DynamicResource AccentBrush}" />
                                <TextBlock x:Name="LoadingMessage"
                                           Text="{Binding LoadingMessage}"
                                           Foreground="White" FontSize="14"
                                           HorizontalAlignment="Center" Margin="0,12,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- ═══ FAVORITES SECTION (WPF FavoritesPage equivalent) ═══ -->
                        <Grid x:Name="FavoritesSectionRoot" IsVisible="False" RowDefinitions="Auto,*" Margin="10">
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8"
                                        Margin="0,4,0,8" VerticalAlignment="Center">
                                <TextBlock Text="Favorites" FontSize="22" FontWeight="Bold"
                                           VerticalAlignment="Center" Margin="0,0,12,0"
                                           FontFamily="{DynamicResource PrimaryFont}" />
                                <Button Classes="secondary" Content="Remove from Favorites"
                                        Command="{Binding RemoveSelectedCommand}" />
                                <Button Classes="primary" Content="Launch Selected Game"
                                        Command="{Binding LaunchSelectedCommand}" />
                            </StackPanel>
                            <Grid Grid.Row="1" ColumnDefinitions="*,6,240">
                                <DataGrid Grid.Column="0"
                                          ItemsSource="{Binding Favorites}"
                                          SelectedItem="{Binding SelectedFavorite}"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          GridLinesVisibility="All"
                                          BorderThickness="1"
                                          DoubleTapped="FavoritesDataGrid_DoubleTapped"
                                          KeyDown="FavoritesDataGrid_KeyDown">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="File Name" Binding="{Binding DisplayName}" Width="*" />
                                        <DataGridTextColumn Header="Machine Description" Binding="{Binding MachineDescription}" Width="*" />
                                        <DataGridTextColumn Header="Default Emulator" Binding="{Binding DefaultEmulator}" Width="180" />
                                        <DataGridTextColumn Header="System Name" Binding="{Binding SystemName}" Width="200" />
                                    </DataGrid.Columns>
                                </DataGrid>
                                <GridSplitter Grid.Column="1" Width="4"
                                              Background="Transparent"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Stretch" />
                                <Border Grid.Column="2" BorderBrush="{DynamicResource BorderSubtleBrush}"
                                        BorderThickness="1" Padding="5">
                                    <Image Source="{Binding SelectedFavorite.CoverImage, Converter={StaticResource PathToImage}}"
                                           Stretch="Uniform"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           RenderOptions.BitmapInterpolationMode="HighQuality" />
                                </Border>
                            </Grid>
                        </Grid>

                        <!-- ═══ PLAY HISTORY SECTION (WPF PlayHistoryPage equivalent) ═══ -->
                        <Grid x:Name="PlayHistorySectionRoot" IsVisible="False" RowDefinitions="Auto,Auto,*" Margin="10">
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8"
                                        Margin="0,4,0,4" VerticalAlignment="Center">
                                <TextBlock Text="Play History" FontSize="22" FontWeight="Bold"
                                           VerticalAlignment="Center" Margin="0,0,12,0"
                                           FontFamily="{DynamicResource PrimaryFont}" />
                                <Button Classes="secondary" Content="Remove from History"
                                        Command="{Binding RemoveSelectedCommand}" />
                                <Button Classes="secondary" Content="Remove All from History"
                                        Command="{Binding RemoveAllCommand}" />
                                <Button Classes="primary" Content="Launch Selected Game"
                                        Command="{Binding LaunchSelectedCommand}" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
                                <Button Classes="secondary" Content="Sort by Date"
                                        Command="{Binding SortByDateCommand}" />
                                <Button Classes="secondary" Content="Sort by Play Time"
                                        Command="{Binding SortByTotalPlayTimeCommand}" />
                                <Button Classes="secondary" Content="Sort by Times Played"
                                        Command="{Binding SortByTimesPlayedCommand}" />
                            </StackPanel>
                            <Grid Grid.Row="2" ColumnDefinitions="*,6,240">
                                <DataGrid Grid.Column="0"
                                          ItemsSource="{Binding PlayHistoryList}"
                                          SelectedItem="{Binding SelectedItem}"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          GridLinesVisibility="All"
                                          BorderThickness="1"
                                          DoubleTapped="PlayHistoryDataGrid_DoubleTapped"
                                          KeyDown="PlayHistoryDataGrid_KeyDown">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="File Name" Binding="{Binding DisplayName}" Width="*" />
                                        <DataGridTextColumn Header="Machine Description" Binding="{Binding MachineDescription}" Width="*" />
                                        <DataGridTextColumn Header="System Name" Binding="{Binding SystemName}" Width="160" />
                                        <DataGridTextColumn Header="Default Emulator" Binding="{Binding DefaultEmulator}" Width="180" />
                                        <DataGridTextColumn Header="Times Played" Binding="{Binding TimesPlayed}" Width="110" />
                                        <DataGridTextColumn Header="Play Time" Binding="{Binding FormattedPlayTime}" Width="110" />
                                        <DataGridTextColumn Header="Last Played Date" Binding="{Binding LastPlayDate}" Width="130" />
                                        <DataGridTextColumn Header="Last Played Time" Binding="{Binding LastPlayTime}" Width="130" />
                                    </DataGrid.Columns>
                                </DataGrid>
                                <GridSplitter Grid.Column="1" Width="6"
                                              Background="Transparent"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Stretch" />
                                <Border Grid.Column="2" BorderBrush="{DynamicResource BorderSubtleBrush}"
                                        BorderThickness="1" Padding="5">
                                    <Image Source="{Binding SelectedItem.CoverImage, Converter={StaticResource PathToImage}}"
                                           Stretch="Uniform"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           RenderOptions.BitmapInterpolationMode="HighQuality" />
                                </Border>
                            </Grid>
                        </Grid>

                        <!-- ═══ GLOBAL SEARCH SECTION (WPF GlobalSearchPage equivalent) ═══ -->
                        <Grid x:Name="GlobalSearchSectionRoot" IsVisible="False" RowDefinitions="Auto,Auto,*" Margin="10">
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8"
                                        Margin="0,4,0,4" VerticalAlignment="Center">
                                <TextBlock Text="Global Search" FontSize="22" FontWeight="Bold"
                                           VerticalAlignment="Center" Margin="0,0,12,0"
                                           FontFamily="{DynamicResource PrimaryFont}" />
                                <TextBox x:Name="GlobalSearchTextBox" Width="220" VerticalAlignment="Center"
                                         Text="{Binding SearchText}"
                                         KeyDown="GlobalSearchTextBox_KeyDown" />
                                <ComboBox ItemsSource="{Binding SystemNames}"
                                          SelectedIndex="{Binding SelectedSystemIndex}"
                                          Width="180" VerticalAlignment="Center" />
                                <Button Classes="secondary" Content="Search" VerticalAlignment="Center"
                                        Command="{Binding SearchCommand}" />
                                <Button Classes="primary" Content="Launch Selected" VerticalAlignment="Center"
                                        Command="{Binding LaunchSelectedCommand}"
                                        IsEnabled="{Binding LaunchButtonEnabled}" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="16" Margin="0,0,0,8">
                                <CheckBox Content="Filename" IsChecked="{Binding SearchFilename}" />
                                <CheckBox Content="MAME Description" IsChecked="{Binding SearchMameDescription}" />
                                <CheckBox Content="Folder Name" IsChecked="{Binding SearchFolderName}" />
                                <CheckBox Content="Search Recursively" IsChecked="{Binding SearchRecursively}" />
                                <TextBlock Text="{Binding ResultsCountText}" FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                            </StackPanel>
                            <Grid Grid.Row="2" ColumnDefinitions="*,6,240">
                                <Grid Grid.Column="0">
                                    <DataGrid ItemsSource="{Binding SearchResults}"
                                              SelectedItem="{Binding SelectedResult}"
                                              AutoGenerateColumns="False"
                                              IsReadOnly="True"
                                              GridLinesVisibility="All"
                                              BorderThickness="1"
                                              DoubleTapped="GlobalSearchResults_DoubleTapped">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="File Name" Binding="{Binding FileNameWithExtension}" Width="*" />
                                            <DataGridTextColumn Header="Machine Name" Binding="{Binding MachineName}" Width="*" />
                                            <DataGridTextColumn Header="Default Emulator" Binding="{Binding DefaultEmulator}" Width="180" />
                                            <DataGridTextColumn Header="System Name" Binding="{Binding SystemName}" Width="200" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <Border Background="{DynamicResource BgPrimaryBrush}"
                                            IsVisible="{Binding NoResultsVisible}"
                                            BorderBrush="{DynamicResource BorderSubtleBrush}"
                                            BorderThickness="1" CornerRadius="2">
                                        <TextBlock Text="No results found"
                                                   VerticalAlignment="Center" HorizontalAlignment="Center"
                                                   FontSize="18" FontWeight="Bold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   Margin="20" />
                                    </Border>
                                </Grid>
                                <GridSplitter Grid.Column="1" Width="6"
                                              Background="Transparent"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Stretch" />
                                <Border Grid.Column="2" BorderBrush="{DynamicResource BorderSubtleBrush}"
                                        BorderThickness="1" Padding="5">
                                    <Image Source="{Binding SelectedResult.CoverImage, Converter={StaticResource PathToImage}}"
                                           Stretch="Uniform"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           RenderOptions.BitmapInterpolationMode="HighQuality" />
                                </Border>
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>

                <!-- ═══ STATUS BAR (Bottom) ═══ -->
                <Border Grid.Row="2" Background="{DynamicResource BgSecondaryBrush}"
                        BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,1,0,0">
                    <Grid Margin="10,0" ColumnDefinitions="*,Auto,*">
                        <TextBlock x:Name="StatusLeft"
                                   Text="{Binding GameCountText}"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   FontSize="11" VerticalAlignment="Center"
                                   HorizontalAlignment="Left" />
                        <!-- Pagination controls (hidden until a label is set by the pagination service) -->
                        <StackPanel x:Name="PaginationPanel" Grid.Column="1" Orientation="Horizontal"
                                    Spacing="8" VerticalAlignment="Center"
                                    IsVisible="False">
                            <Button x:Name="PrevPageButton"
                                    Classes="secondary"
                                    Padding="10,2"
                                    IsEnabled="False"
                                    Click="PrevPage_Click"
                                    ToolTip.Tip="Previous page"
                                    Content="◀" />
                            <TextBlock x:Name="PaginationLabel"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       FontSize="11" VerticalAlignment="Center" />
                            <Button x:Name="NextPageButton"
                                    Classes="secondary"
                                    Padding="10,2"
                                    IsEnabled="False"
                                    Click="NextPage_Click"
                                    ToolTip.Tip="Next page"
                                    Content="▶" />
                        </StackPanel>
                        <TextBlock x:Name="StatusRight" Grid.Column="2"
                                   Text="{Binding StatusText}"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   FontSize="11" VerticalAlignment="Center"
                                   HorizontalAlignment="Right" />
                    </Grid>
                </Border>

            </Grid>
        </Grid>

    </Grid>
</Window>