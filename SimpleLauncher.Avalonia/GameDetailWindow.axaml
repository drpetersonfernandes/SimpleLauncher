<Window x:Class="SimpleLauncher.Avalonia.GameDetailWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="using:SimpleLauncher.Avalonia.Converters"
        Title="Game Details"
        Width="500" Height="450"
        MinWidth="400" MinHeight="350"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgPrimaryBrush}"
        Closing="Window_Closing">

    <Window.Resources>
        <converters:PathToImageConverter x:Key="PathToImage" />
        <converters:SmartTitleCaseConverter x:Key="SmartTitleCase" />
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header: Cover + Info -->
        <Border Grid.Row="0" Background="{DynamicResource BgSecondaryBrush}"
                CornerRadius="{DynamicResource CardCornerRadius}" Padding="16">
            <Grid ColumnDefinitions="120,*">

                <!-- Cover art -->
                <Border Grid.Column="0" CornerRadius="4" ClipToBounds="True"
                        Width="120" Height="168" Background="{DynamicResource BgTertiaryBrush}">
                    <Image x:Name="CoverImage"
                           Source="{Binding CoverPath, Converter={StaticResource PathToImage}}"
                           Stretch="Uniform"
                           RenderOptions.BitmapInterpolationMode="HighQuality" />
                </Border>

                <!-- Game info -->
                <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="TitleText"
                               Text="{Binding DisplayTitle, Converter={StaticResource SmartTitleCase}}"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               FontSize="18" FontWeight="SemiBold"
                               TextWrapping="Wrap" MaxHeight="56" />
                    <TextBlock x:Name="SystemText"
                               Text="{Binding SystemName}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="13" Margin="0,8,0,0" />
                    <TextBlock x:Name="FilePathText"
                               Text="{Binding FilePath}"
                               Foreground="{DynamicResource TextMutedBrush}"
                               FontSize="11" Margin="0,4,0,0"
                               TextTrimming="CharacterEllipsis"
                               ToolTip.Tip="{Binding FilePath}" />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Text="Played: " Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" />
                        <TextBlock Text="{Binding PlayCount}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" FontWeight="SemiBold" />
                        <TextBlock Text=" times" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" />
                    </StackPanel>
                    <TextBlock x:Name="LastPlayedText"
                               Foreground="{DynamicResource TextMutedBrush}"
                               FontSize="11" Margin="0,2,0,0">
                        <Run Text="Last played: " />
                        <Run Text="{Binding LastPlayed}" />
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Description -->
        <Border Grid.Row="1" Background="{DynamicResource BgSecondaryBrush}"
                CornerRadius="6" Padding="14" Margin="0,12,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Text="Description"
                           Foreground="{DynamicResource TextMutedBrush}"
                           FontSize="11" FontWeight="SemiBold" Margin="0,0,0,8" />
                <TextBlock Grid.Row="1"
                           x:Name="DescriptionBlock"
                           Text="No additional information available for this game."
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           FontSize="13" TextWrapping="Wrap"
                           VerticalAlignment="Top" />
            </Grid>
        </Border>

        <!-- Action bar -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button x:Name="RemoveButton"
                    Content="Remove"
                    Classes="secondary"
                    Padding="14,8" Margin="0,0,8,0"
                    Click="RemoveButton_Click" />
            <Button x:Name="FavoriteButton"
                    Content="♡ Favorite"
                    Classes="secondary"
                    Padding="14,8" Margin="0,0,8,0"
                    Click="FavoriteButton_Click" />
            <Button x:Name="PlayButton"
                    Content="▶ Play"
                    Classes="primary"
                    Padding="20,8"
                    Click="PlayButton_Click" />
        </StackPanel>
    </Grid>
</Window>
