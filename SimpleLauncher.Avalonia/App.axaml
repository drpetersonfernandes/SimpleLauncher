<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SimpleLauncher.Avalonia.App"
             RequestedThemeVariant="Dark">
    <Application.Styles>
        <!-- Avalonia Fluent theme (dark variant) — implicit styles for all standard controls -->
        <FluentTheme />
        <!-- DataGrid control theme (required for the grid to render rows/columns) -->
        <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />
        <!-- App-specific colors and remaining custom styles -->
        <StyleInclude Source="avares://SimpleLauncher.Avalonia/Themes/DarkTheme.axaml" />
    </Application.Styles>
</Application>
