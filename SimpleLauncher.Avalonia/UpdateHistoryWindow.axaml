<Window x:Class="SimpleLauncher.Avalonia.UpdateHistoryWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:ext="using:SimpleLauncher.Avalonia.Extensions"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:doc="clr-namespace:Avalonia.Controls.Documents;assembly=Avalonia.Controls"
        xmlns:md="clr-namespace:Markdown.Avalonia;assembly=Markdown.Avalonia"
        Title="{ext:Translate UpdateHistory}"
        Width="800" Height="700"
        MinWidth="700" MinHeight="550"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <md:MarkdownScrollViewer x:Name="HistoryMarkdownViewer"
                                 Margin="10"
                                 doc:TextElement.Foreground="{DynamicResource TextPrimaryBrush}"
                                 Markdown="{Binding MarkdownContent, Mode=OneWay}" />
    </Grid>
</Window>