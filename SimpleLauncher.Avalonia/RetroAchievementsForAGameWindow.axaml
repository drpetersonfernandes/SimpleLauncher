<Window x:Class="SimpleLauncher.Avalonia.RetroAchievementsForAGameWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:SimpleLauncher.Avalonia.Controls"
        xmlns:models="using:SimpleLauncher.Core.Models"
        xmlns:local="using:SimpleLauncher.Avalonia.Models"
        Title="RetroAchievements"
        WindowState="Maximized"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgPrimaryBrush}">

    <Window.Resources>
        <Style x:Key="RightAlignedCell" Selector="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>
    </Window.Resources>

    <Grid RowDefinitions="Auto,*">

        <!-- Header Section: Game Cover, Title, Console -->
        <Border Grid.Row="0" Margin="10" Padding="15"
                BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="5">
            <StackPanel Orientation="Horizontal">
                <controls:RemoteImage x:Name="GameCoverImage" Width="80" Height="80" Stretch="Uniform"
                                      Margin="0,0,15,0" ToolTip.Tip="Cover image of the selected game" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="GameTitleTextBlock" FontSize="24" FontWeight="Bold" Text="Game Title"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock x:Name="ConsoleNameTextBlock" FontSize="16" Margin="0,5,0,0" Text="Console Name"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <TabControl x:Name="TabControl" Grid.Row="1" Margin="10,0,10,10" SelectionChanged="TabControl_SelectionChanged">

            <!-- Tab 1: Achievements -->
            <TabItem Header="Achievements |" Tag="Achievements">
                <Grid RowDefinitions="Auto,*">
                    <!-- Progress Summary Header -->
                    <Border Grid.Row="0" Margin="10,10,10,0" Padding="15"
                            BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="5">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
                                <TextBlock x:Name="GameProgressTitle" FontSize="20" FontWeight="Bold"
                                           Margin="0,0,10,0" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock x:Name="GameProgressConsole" FontStyle="Italic" VerticalAlignment="Bottom"
                                           FontSize="16" Foreground="{DynamicResource TextSecondaryBrush}" />
                            </StackPanel>

                            <!-- Completion Progress Bars -->
                            <Grid Margin="0,15,0,10" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Casual Progress:" FontWeight="Bold"
                                           Margin="0,0,0,5" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <ProgressBar Grid.Row="1" Grid.Column="0" x:Name="CasualProgressbar" Height="20"
                                             Margin="0,0,10,0" Minimum="0" Maximum="100" />
                                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="CasualProgressText"
                                           VerticalAlignment="Center" FontWeight="Bold" Width="60"
                                           TextAlignment="Right" Foreground="{DynamicResource TextPrimaryBrush}" />
                            </Grid>

                            <Grid Margin="0,0,0,10" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Hardcore Progress:" FontWeight="Bold"
                                           Margin="0,0,0,5" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <ProgressBar Grid.Row="1" Grid.Column="0" x:Name="HardcoreProgressbar" Height="20"
                                             Margin="0,0,10,0" Minimum="0" Maximum="100" />
                                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="HardcoreProgressText"
                                           VerticalAlignment="Center" FontWeight="Bold" Width="60"
                                           TextAlignment="Right" Foreground="{DynamicResource TextPrimaryBrush}" />
                            </Grid>

                            <!-- Achievement Stats -->
                            <Grid Margin="0,10,0,0" ColumnDefinitions="*,*,*,*">
                                <Border Grid.Column="0" BorderBrush="{DynamicResource BorderNormalBrush}"
                                        BorderThickness="1" Padding="10" Margin="0,0,5,0" CornerRadius="3">
                                    <StackPanel>
                                        <TextBlock x:Name="EarnedAchievementsValue" FontSize="18" FontWeight="Bold"
                                                   HorizontalAlignment="Center" Foreground="{DynamicResource AccentBrush}" />
                                        <TextBlock Text="Achievements Earned" HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" BorderBrush="{DynamicResource BorderNormalBrush}"
                                        BorderThickness="1" Padding="10" Margin="5,0,5,0" CornerRadius="3">
                                    <StackPanel>
                                        <TextBlock x:Name="TotalAchievementsValue" FontSize="18" FontWeight="Bold"
                                                   HorizontalAlignment="Center" Foreground="{DynamicResource AccentBrush}" />
                                        <TextBlock Text="Total Achievements" HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" BorderBrush="{DynamicResource BorderNormalBrush}"
                                        BorderThickness="1" Padding="10" Margin="5,0,5,0" CornerRadius="3">
                                    <StackPanel>
                                        <TextBlock x:Name="TotalPointsEarnedValue" FontSize="18" FontWeight="Bold"
                                                   HorizontalAlignment="Center" Foreground="{DynamicResource AccentBrush}" />
                                        <TextBlock Text="Total Points Earned" HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="3" BorderBrush="{DynamicResource BorderNormalBrush}"
                                        BorderThickness="1" Padding="10" Margin="5,0,0,0" CornerRadius="3">
                                    <StackPanel>
                                        <TextBlock x:Name="TruePointsEarnedValue" FontSize="18" FontWeight="Bold"
                                                   HorizontalAlignment="Center" Foreground="{DynamicResource AccentBrush}" />
                                        <TextBlock Text="True Points Earned" HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Highest Award Info -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                                <TextBlock Text="Highest Award:" FontWeight="Bold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" FontSize="14" Margin="0,0,10,0" />
                                <controls:RemoteImage x:Name="HighestAwardIcon" Width="20" Height="20"
                                                      Margin="0,0,5,0" VerticalAlignment="Center" IsVisible="False" />
                                <TextBlock x:Name="HighestAwardKindText" FontWeight="Bold"
                                           Foreground="{DynamicResource SelectionBackgroundBrush}" FontSize="14" />
                                <TextBlock Text=" on " FontWeight="Bold" Margin="5,0,5,0"
                                           Foreground="{DynamicResource TextPrimaryBrush}" FontSize="14" />
                                <TextBlock x:Name="HighestAwardDateText" FontWeight="Bold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" FontSize="14" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Achievements DataGrid -->
                    <Grid Grid.Row="1" Margin="10,10,10,10">
                        <DataGrid x:Name="AchievementsDataGrid" AutoGenerateColumns="False" IsReadOnly="True"
                                  HeadersVisibility="Column"
                                  Background="{DynamicResource BgSecondaryBrush}"
                                  BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"
                                  ToolTip.Tip="List of achievements for the selected game">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Icon" Width="Auto">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate x:DataType="local:RaAchievement">
                                            <controls:RemoteImage Url="{Binding BadgeUri}" Width="40" Height="40" Margin="5" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="*" SortMemberPath="Title" />
                                <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="2*" SortMemberPath="Description" />
                                <DataGridTextColumn Header="Points" Binding="{Binding Points}" Width="Auto"
                                                    SortMemberPath="Points" />
                                <DataGridTextColumn Header="True Ratio" Binding="{Binding TrueRatio, StringFormat='{}{0}%'}"
                                                    Width="Auto" SortMemberPath="TrueRatio" />
                                <DataGridTextColumn Header="Unlocked" Binding="{Binding DateUnlockedDisplay}" Width="Auto"
                                                    SortMemberPath="DateUnlocked" />
                                <DataGridTextColumn Header="Mode" Binding="{Binding ModeDisplay}" Width="Auto"
                                                    SortMemberPath="UnlockedInHardcore" />
                                <DataGridTextColumn Header="Rarity" Binding="{Binding RarityDisplay}" Width="Auto"
                                                    SortMemberPath="NumAwardedHardcore" />
                                <DataGridTextColumn Header="Author" Binding="{Binding AuthorDisplay}" Width="Auto" SortMemberPath="Author" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <Grid x:Name="NoAchievementsOverlay" Background="{DynamicResource BgPrimaryBrush}" IsVisible="False">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock x:Name="NoAchievementsMessage" Text="No achievements found for this game."
                                           VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="18"
                                           Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" TextAlignment="Center" />
                                <Button Content="Open RetroAchievements Settings" Margin="0,15,0,0"
                                        Classes="primary" Click="OpenRaSettings_Click"
                                        ToolTip.Tip="Open RetroAchievements settings" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- Tab 2: Game Info -->
            <TabItem Header="Game Info |" Tag="GameInfo">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="10">
                    <StackPanel>
                        <!-- Game Images Section -->
                        <TextBlock Text="Game Images" FontWeight="Bold" FontSize="18" Margin="0,0,0,15"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <Grid Margin="0,0,0,25" ColumnDefinitions="*,*,*,*">
                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="Icon" FontSize="14" HorizontalAlignment="Center"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                <Border BorderBrush="{DynamicResource BorderNormalBrush}" BorderThickness="1"
                                        Margin="0,5,0,0" HorizontalAlignment="Center">
                                    <controls:RemoteImage x:Name="GameInfoImageIcon" Width="150" Height="112.5"
                                                          Stretch="Uniform" PointerPressed="GameImage_PointerPressed"
                                                          ToolTip.Tip="Click to view full size" />
                                </Border>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="10,0,10,0">
                                <TextBlock Text="Title Screen" FontSize="14" HorizontalAlignment="Center"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                <Border BorderBrush="{DynamicResource BorderNormalBrush}" BorderThickness="1"
                                        Margin="0,5,0,0" HorizontalAlignment="Center">
                                    <controls:RemoteImage x:Name="GameInfoTitleImage" Width="150" Height="112.5"
                                                          Stretch="Uniform" PointerPressed="GameImage_PointerPressed"
                                                          ToolTip.Tip="Click to view full size" />
                                </Border>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="10,0,10,0">
                                <TextBlock Text="In-Game" FontSize="14" HorizontalAlignment="Center"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                <Border BorderBrush="{DynamicResource BorderNormalBrush}" BorderThickness="1"
                                        Margin="0,5,0,0" HorizontalAlignment="Center">
                                    <controls:RemoteImage x:Name="GameInfoIngameImage" Width="150" Height="112.5"
                                                          Stretch="Uniform" PointerPressed="GameImage_PointerPressed"
                                                          ToolTip.Tip="Click to view full size" />
                                </Border>
                            </StackPanel>
                            <StackPanel Grid.Column="3" Margin="10,0,0,0">
                                <TextBlock Text="Box Art" FontSize="14" HorizontalAlignment="Center"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                <Border BorderBrush="{DynamicResource BorderNormalBrush}" BorderThickness="1"
                                        Margin="0,5,0,0" HorizontalAlignment="Center">
                                    <controls:RemoteImage x:Name="GameInfoBoxArtImage" Width="150" Height="112.5"
                                                          Stretch="Uniform" PointerPressed="GameImage_PointerPressed"
                                                          ToolTip.Tip="Click to view full size" />
                                </Border>
                            </StackPanel>
                        </Grid>

                        <!-- Game Details Grid -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                            <TextBlock Text="Game Details" FontWeight="Bold" FontSize="18" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                            <Button x:Name="ViewGameOnRaButton" Content="View on RetroAchievements.org"
                                    Classes="primary" Click="ViewGameOnRaButton_Click" Margin="15,0,0,0"
                                    ToolTip.Tip="View game on RetroAchievements" />
                        </StackPanel>
                        <Grid Margin="0,0,0,25" ColumnDefinitions="Auto,*,Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Genre:" FontWeight="Bold"
                                       Margin="0,0,10,8" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="GameInfoGenre" Margin="0,0,20,8"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="Released:" FontWeight="Bold"
                                       Margin="0,0,10,8" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Grid.Row="0" Grid.Column="3" x:Name="GameInfoReleased" Margin="0,0,0,8"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Developer:" FontWeight="Bold"
                                       Margin="0,0,10,8" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="GameInfoDeveloper" Margin="0,0,20,8"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="Publisher:" FontWeight="Bold"
                                       Margin="0,0,10,8" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Grid.Row="1" Grid.Column="3" x:Name="GameInfoPublisher" Margin="0,0,0,8"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Players:" FontWeight="Bold"
                                       Margin="0,0,10,8" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="GameInfoPlayers" Margin="0,0,20,8"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Grid.Row="2" Grid.Column="2" Text="Achievements" FontWeight="Bold"
                                       Margin="0,0,10,8" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Grid.Row="2" Grid.Column="3" x:Name="GameInfoAchievementCount" Margin="0,0,0,8"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Console:" FontWeight="Bold"
                                       Margin="0,0,10,8" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Grid.Row="3" Grid.Column="1" x:Name="GameInfoConsoleName" Margin="0,0,20,8"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Grid.Row="3" Grid.Column="2" Text="Updated:" FontWeight="Bold"
                                       Margin="0,0,10,8" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Grid.Row="3" Grid.Column="3" x:Name="GameInfoUpdated" Margin="0,0,0,8"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Console ID:" FontWeight="Bold"
                                       Margin="0,0,10,8" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Grid.Row="4" Grid.Column="1" x:Name="GameInfoConsoleId" Margin="0,0,20,8"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Grid.Row="4" Grid.Column="2" Text="Game ID:" FontWeight="Bold"
                                       Margin="0,0,10,8" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Grid.Row="4" Grid.Column="3" x:Name="GameInfoId" Margin="0,0,0,8"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />

                            <TextBlock Grid.Row="5" Grid.Column="0" Text="Parent Game:" FontWeight="Bold"
                                       Margin="0,0,10,8" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Grid.Row="5" Grid.Column="1" x:Name="GameInfoParentGame" Margin="0,0,20,8"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Grid.Row="5" Grid.Column="2" Text="Forum Topic:" FontWeight="Bold"
                                       Margin="0,0,10,8" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Grid.Row="5" Grid.Column="3" x:Name="GameInfoForumTopic" Margin="0,0,0,8"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />

                            <TextBlock Grid.Row="6" Grid.Column="0" Text="Release Granularity:" FontWeight="Bold"
                                       Margin="0,0,10,8" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="3" x:Name="GameInfoReleaseGranularity"
                                       Margin="0,0,0,8" Foreground="{DynamicResource TextPrimaryBrush}" />

                            <TextBlock Grid.Row="7" Grid.Column="0" Text="Guide URL:" FontWeight="Bold"
                                       Margin="0,0,10,8" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Grid.Row="7" Grid.Column="1" Grid.ColumnSpan="3" x:Name="GameInfoGuideUrl"
                                       Margin="0,0,0,8" Foreground="{DynamicResource TextPrimaryBrush}" />
                        </Grid>

                        <!-- Statistics Section -->
                        <TextBlock Text="Player Statistics" FontWeight="Bold" FontSize="18" Margin="0,0,0,15"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <Grid Margin="0,0,0,25" ColumnDefinitions="*,*,*">
                            <Border Grid.Column="0" BorderBrush="{DynamicResource BorderNormalBrush}"
                                    BorderThickness="1" Padding="10" Margin="0,0,5,0" CornerRadius="3">
                                <StackPanel>
                                    <TextBlock x:Name="DistinctPlayersValue" FontSize="18" FontWeight="Bold"
                                               HorizontalAlignment="Center" Foreground="{DynamicResource AccentBrush}" />
                                    <TextBlock Text="Total Players" HorizontalAlignment="Center"
                                               Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" BorderBrush="{DynamicResource BorderNormalBrush}"
                                    BorderThickness="1" Padding="10" Margin="5,0,5,0" CornerRadius="3">
                                <StackPanel>
                                    <TextBlock x:Name="CasualPlayersValue" FontSize="18" FontWeight="Bold"
                                               HorizontalAlignment="Center" Foreground="{DynamicResource AccentBrush}" />
                                    <TextBlock Text="Casual Players" HorizontalAlignment="Center"
                                               Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" BorderBrush="{DynamicResource BorderNormalBrush}"
                                    BorderThickness="1" Padding="10" Margin="5,0,0,0" CornerRadius="3">
                                <StackPanel>
                                    <TextBlock x:Name="HardcorePlayersValue" FontSize="18" FontWeight="Bold"
                                               HorizontalAlignment="Center" Foreground="{DynamicResource AccentBrush}" />
                                    <TextBlock Text="Hardcore Players" HorizontalAlignment="Center"
                                               Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Claims Section -->
                        <TextBlock Text="Development Claims" FontWeight="Bold" FontSize="18" Margin="0,0,0,15"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock x:Name="GameInfoClaims" TextWrapping="Wrap" Margin="0,0,0,20"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />

                        <!-- Achievements List Section -->
                        <StackPanel x:Name="GameInfoAchievementsSection" IsVisible="False">
                            <TextBlock Text="Achievements List" FontWeight="Bold" FontSize="18" Margin="0,25,0,15"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                            <DataGrid x:Name="GameInfoAchievementsDataGrid" AutoGenerateColumns="False" IsReadOnly="True"
                                      Margin="0,0,0,20" HeadersVisibility="Column"
                                      Background="{DynamicResource BgSecondaryBrush}"
                                      BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" MaxHeight="400"
                                      ToolTip.Tip="List of achievements for the selected game">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="Icon" Width="Auto">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate x:DataType="local:RaAchievement">
                                                <controls:RemoteImage Url="{Binding BadgeUri}" Width="40" Height="40" Margin="5" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="*" SortMemberPath="Title" />
                                    <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="2*" SortMemberPath="Description" />
                                    <DataGridTextColumn Header="Points" Binding="{Binding Points}" Width="Auto"
                                                        SortMemberPath="Points" />
                                    <DataGridTextColumn Header="True Ratio" Binding="{Binding TrueRatio, StringFormat='{}{0}%'}"
                                                        Width="Auto" SortMemberPath="TrueRatio" />
                                    <DataGridTextColumn Header="Author" Binding="{Binding AuthorDisplay}" Width="Auto" SortMemberPath="Author" />
                                    <DataGridTextColumn Header="Created" Binding="{Binding DateCreated}" Width="Auto" SortMemberPath="DateCreated" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>

                        <!-- No Data Overlay -->
                        <Grid x:Name="NoGameInfoOverlay" Background="{DynamicResource BgPrimaryBrush}" IsVisible="False">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock x:Name="NoGameInfoMessage" Text="Extended game information not available."
                                           VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="18"
                                           Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" TextAlignment="Center" />
                                <Button Content="Open RetroAchievements Settings" Margin="0,15,0,0"
                                        Classes="primary" Click="OpenRaSettings_Click"
                                        ToolTip.Tip="Open RetroAchievements settings" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Tab 3: Game Ranking -->
            <TabItem Header="Game Ranking |" Tag="GameRanking">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="10">
                    <StackPanel>
                        <!-- Your Rank and Score Section -->
                        <TextBlock Text="Your Rank and Score" FontWeight="Bold" FontSize="18" Margin="0,0,0,15"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <Grid Margin="0,0,0,25" ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto">
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Rank:" FontWeight="Bold"
                                       Margin="0,0,10,8" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="UserRankText" Margin="0,0,0,8"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Score:" FontWeight="Bold"
                                       Margin="0,0,10,8" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="UserScoreText" Margin="0,0,0,8"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Last Award:" FontWeight="Bold"
                                       Margin="0,0,10,8" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="UserLastAwardText" Margin="0,0,0,8"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />

                            <Grid Grid.Row="0" Grid.Column="0" Grid.RowSpan="3" Grid.ColumnSpan="2"
                                  x:Name="NoUserRankOverlay" Background="{DynamicResource BgPrimaryBrush}" IsVisible="False">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock x:Name="NoUserRankMessage" Text="No rank data available. Ensure your RetroAchievements credentials are set."
                                               VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="16"
                                               Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" TextAlignment="Center" />
                                    <Button Content="Open RetroAchievements Settings" Margin="0,15,0,0"
                                            Classes="primary" Click="OpenRaSettings_Click"
                                            ToolTip.Tip="Open RetroAchievements settings" />
                                </StackPanel>
                            </Grid>
                        </Grid>

                        <!-- Latest Masters Section -->
                        <TextBlock Text="Latest Masters" FontWeight="Bold" FontSize="18" Margin="0,0,0,15"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <DataGrid x:Name="LatestMastersDataGrid" AutoGenerateColumns="False" IsReadOnly="True"
                                  Margin="0,0,0,20" HeadersVisibility="Column"
                                  Background="{DynamicResource BgSecondaryBrush}"
                                  BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"
                                  ToolTip.Tip="Latest achievement masters for the selected game">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Rank" Binding="{Binding Rank}" Width="Auto"
                                                    SortMemberPath="Rank" />
                                <DataGridTextColumn Header="User" Binding="{Binding User}" Width="*" SortMemberPath="User" />
                                <DataGridTextColumn Header="Score" Binding="{Binding Score}" Width="Auto"
                                                    SortMemberPath="Score" />
                                <DataGridTextColumn Header="True Ratio" Binding="{Binding TrueRatio, StringFormat='{}{0}%'}"
                                                    Width="Auto" SortMemberPath="TrueRatio" />
                                <DataGridTextColumn Header="Achievements" Binding="{Binding NumAchievements}" Width="Auto"
                                                    SortMemberPath="NumAchievements" />
                                <DataGridTextColumn Header="Last Award" Binding="{Binding LastAward}" Width="Auto" SortMemberPath="LastAward" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <Grid x:Name="NoLatestMastersOverlay" Background="{DynamicResource BgPrimaryBrush}" IsVisible="False">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock x:Name="NoLatestMastersMessage" Text="No latest masters found for this game."
                                           VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="18"
                                           Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" TextAlignment="Center" />
                                <Button Content="Open RetroAchievements Settings" Margin="0,15,0,0"
                                        Classes="primary" Click="OpenRaSettings_Click"
                                        ToolTip.Tip="Open RetroAchievements settings" />
                            </StackPanel>
                        </Grid>

                        <!-- High Scores Section -->
                        <TextBlock Text="High Scores" FontWeight="Bold" FontSize="18" Margin="0,20,0,15"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <DataGrid x:Name="HighScoresDataGrid" AutoGenerateColumns="False" IsReadOnly="True"
                                  Margin="0,0,0,10" HeadersVisibility="Column"
                                  Background="{DynamicResource BgSecondaryBrush}"
                                  BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"
                                  ToolTip.Tip="High scores list for the selected game">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Rank" Binding="{Binding Rank}" Width="Auto"
                                                    SortMemberPath="Rank" />
                                <DataGridTextColumn Header="User" Binding="{Binding User}" Width="*" SortMemberPath="User" />
                                <DataGridTextColumn Header="Score" Binding="{Binding Score}" Width="Auto"
                                                    SortMemberPath="Score" />
                                <DataGridTextColumn Header="True Ratio" Binding="{Binding TrueRatio, StringFormat='{}{0}%'}"
                                                    Width="Auto" SortMemberPath="TrueRatio" />
                                <DataGridTextColumn Header="Achievements" Binding="{Binding NumAchievements}" Width="Auto"
                                                    SortMemberPath="NumAchievements" />
                                <DataGridTextColumn Header="Last Award" Binding="{Binding LastAward}" Width="Auto" SortMemberPath="LastAward" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <Grid x:Name="NoHighScoresOverlay" Background="{DynamicResource BgPrimaryBrush}" IsVisible="False">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock x:Name="NoHighScoresMessage" Text="No high scores found for this game."
                                           VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="18"
                                           Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" TextAlignment="Center" />
                                <Button Content="Open RetroAchievements Settings" Margin="0,15,0,0"
                                        Classes="primary" Click="OpenRaSettings_Click"
                                        ToolTip.Tip="Open RetroAchievements settings" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Tab 4: My Profile -->
            <TabItem Header="My Profile |" Tag="MyProfile">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="10">
                    <Grid>
                        <StackPanel x:Name="UserProfilePanel">
                            <!-- User Header with Avatar -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                                <Border BorderBrush="{DynamicResource BorderNormalBrush}" BorderThickness="1"
                                        Width="90" Height="90" CornerRadius="5">
                                    <controls:RemoteImage x:Name="UserProfilePic" Stretch="Uniform" />
                                </Border>
                                <StackPanel VerticalAlignment="Center" Margin="15,0,0,0">
                                    <TextBlock x:Name="UserProfileUser" FontSize="22" FontWeight="Bold"
                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock x:Name="UserProfileMotto" FontStyle="Italic" TextWrapping="Wrap"
                                               Margin="0,5,0,0" FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <Button x:Name="ViewProfileOnRaButton" Content="View Profile on RetroAchievements.org"
                                            Classes="primary" Click="ViewProfileOnRaButton_Click" Margin="0,10,0,0"
                                            ToolTip.Tip="View profile on RetroAchievements button" />
                                </StackPanel>
                            </StackPanel>

                            <!-- Current Activity -->
                            <Border Background="{DynamicResource AccentBrush}" Margin="0,0,0,20" Padding="15" CornerRadius="5">
                                <StackPanel>
                                    <TextBlock Text="Currently Playing" FontWeight="Bold"
                                               Foreground="White" FontSize="16" />
                                    <TextBlock x:Name="UserProfileRichPresence" TextWrapping="Wrap"
                                               Foreground="White" Margin="0,5,0,0" FontSize="14" />
                                </StackPanel>
                            </Border>

                            <!-- User Statistics Grid -->
                            <Grid Margin="0,0,0,25" ColumnDefinitions="*,*,*">
                                <Border Grid.Column="0" BorderBrush="{DynamicResource BorderNormalBrush}"
                                        BorderThickness="1" Padding="10" Margin="0,0,5,0" CornerRadius="3">
                                    <StackPanel>
                                        <TextBlock x:Name="PointsValue" FontSize="18" FontWeight="Bold"
                                                   HorizontalAlignment="Center" Foreground="{DynamicResource AccentBrush}" />
                                        <TextBlock Text="Points" HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" BorderBrush="{DynamicResource BorderNormalBrush}"
                                        BorderThickness="1" Padding="10" Margin="5,0,5,0" CornerRadius="3">
                                    <StackPanel>
                                        <TextBlock x:Name="TruePointsValue" FontSize="18" FontWeight="Bold"
                                                   HorizontalAlignment="Center" Foreground="{DynamicResource AccentBrush}" />
                                        <TextBlock Text="True Points" HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" BorderBrush="{DynamicResource BorderNormalBrush}"
                                        BorderThickness="1" Padding="10" Margin="5,0,0,0" CornerRadius="3">
                                    <StackPanel>
                                        <TextBlock x:Name="RankValue" FontSize="18" FontWeight="Bold"
                                                   HorizontalAlignment="Center" Foreground="{DynamicResource AccentBrush}" />
                                        <TextBlock Text="Rank:" HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Detailed User Information -->
                            <TextBlock Text="User Details" FontWeight="Bold" FontSize="18" Margin="0,0,0,15"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                            <Grid Margin="0,0,0,25" ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Member Since:" FontWeight="Bold"
                                           Margin="0,0,10,8" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Grid.Row="0" Grid.Column="1" x:Name="UserProfileMemberSince"
                                           Margin="0,0,0,8" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="User ID:" FontWeight="Bold"
                                           Margin="0,0,10,8" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="UserProfileId"
                                           Margin="0,0,0,8" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Contributions:" FontWeight="Bold"
                                           Margin="0,0,10,8" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Grid.Row="2" Grid.Column="1" x:Name="UserProfileContributions"
                                           Margin="0,0,0,8" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Softcore Points:" FontWeight="Bold"
                                           Margin="0,0,10,8" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Grid.Row="3" Grid.Column="1" x:Name="UserProfileSoftcorePoints"
                                           Margin="0,0,0,8" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Permissions:" FontWeight="Bold"
                                           Margin="0,0,10,8" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Grid.Row="4" Grid.Column="1" x:Name="UserProfilePermissions"
                                           Margin="0,0,0,8" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Grid.Row="5" Grid.Column="0" Text="Status:" FontWeight="Bold"
                                           Margin="0,0,10,8" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Grid.Row="5" Grid.Column="1" x:Name="UserProfileStatus"
                                           Margin="0,0,0,8" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Grid.Row="6" Grid.Column="0" Text="Profile ID (ULID):" FontWeight="Bold"
                                           Margin="0,0,10,8" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Grid.Row="6" Grid.Column="1" x:Name="UserProfileProfileId"
                                           Margin="0,0,0,8" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Grid.Row="7" Grid.Column="0" Text="Wall Active:" FontWeight="Bold"
                                           Margin="0,0,10,8" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Grid.Row="7" Grid.Column="1" x:Name="UserProfileWallActive"
                                           Margin="0,0,0,8" Foreground="{DynamicResource TextPrimaryBrush}" />
                            </Grid>

                            <!-- Recently Played Section -->
                            <TextBlock Text="Recently Played Games:" FontWeight="Bold" Margin="0,15,0,10"
                                       FontSize="18" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <ListBox x:Name="UserProfileRecentlyPlayed" BorderThickness="1"
                                     BorderBrush="{DynamicResource BorderNormalBrush}"
                                     Background="{DynamicResource BgSecondaryBrush}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="models:RaRecentlyPlayedGame">
                                        <StackPanel Orientation="Horizontal" Margin="0,2">
                                            <controls:RemoteImage Url="{Binding GameIconUrl}"
                                                                  Width="40" Height="40" Stretch="Uniform"
                                                                  VerticalAlignment="Center" Margin="0,0,10,0" />
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14"
                                                           TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Title}" />
                                                <TextBlock Text="{Binding ConsoleName}" FontSize="12"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip.Tip="{Binding ConsoleName}" Margin="0,2,0,0" />
                                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                    <TextBlock Text="Casual" FontSize="12" />
                                                    <TextBlock Text="{Binding ProgressDisplay}" FontSize="12"
                                                               ToolTip.Tip="{Binding ProgressDisplay}" />
                                                    <TextBlock Text="Hardcore" FontSize="12" Margin="5,0,0,0" />
                                                    <TextBlock Text="{Binding HardcoreProgressDisplay}" FontSize="12"
                                                               ToolTip.Tip="{Binding HardcoreProgressDisplay}" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding LastPlayed}" FontSize="12"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip.Tip="{Binding LastPlayed}" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>

                        <Grid x:Name="NoProfileOverlay" Background="{DynamicResource BgPrimaryBrush}" IsVisible="False">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock x:Name="NoProfileMainMessage" Text="Could not load user profile. Check username and API key in settings."
                                           VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="18"
                                           TextWrapping="Wrap" TextAlignment="Center"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock x:Name="NoProfileSubMessage"
                                           Text="Please check your username and API key in settings, or try again later."
                                           VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="14"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="0,10,0,0" TextWrapping="Wrap" TextAlignment="Center" />
                                <Button Content="Open RetroAchievements Settings" Margin="0,15,0,0"
                                        Classes="primary" Click="OpenRaSettings_Click"
                                        ToolTip.Tip="Open RetroAchievements settings" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- Tab 5: Unlocks -->
            <TabItem Header="Unlocks |" Tag="Unlocks">
                <Grid RowDefinitions="Auto,Auto,*">
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="10,15,10,15">
                        <TextBlock Text="From:" VerticalAlignment="Center" Margin="0,0,5,0" FontSize="14"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <DatePicker x:Name="FromDatePicker" Width="140"
                                    ToolTip.Tip="Select the start date for unlocks (defaults to 1 month ago)" />
                        <TextBlock Text="To:" VerticalAlignment="Center" Margin="15,0,5,0" FontSize="14"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <DatePicker x:Name="ToDatePicker" Width="140"
                                    ToolTip.Tip="Select the end date for unlocks (defaults to today)" />
                        <Button Content="Fetch Unlocks" Click="FetchUnlocksClickAsync" Margin="15,0,0,0"
                                Padding="10,5" x:Name="FetchUnlocksButton" Classes="primary"
                                ToolTip.Tip="Fetch unlocks for selected dates" />
                        <Button Content="Reset Dates" Click="ResetDatesClickAsync" Margin="10,0,0,0" Padding="10,5"
                                Classes="secondary" ToolTip.Tip="Reset date filters" />
                    </StackPanel>

                    <Border Grid.Row="1" Margin="10,0,10,15" Padding="15"
                            BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="5">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="Total Unlocks in Range: " FontWeight="Bold" FontSize="16"
                                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,10,0" />
                                <TextBlock x:Name="TotalUnlocksInRangeText" FontWeight="Bold" FontSize="16"
                                           Foreground="{DynamicResource AccentBrush}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,5,0,0">
                                <TextBlock Text="Total Points Earned: " FontWeight="Bold" FontSize="16"
                                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,10,0" />
                                <TextBlock x:Name="TotalPointsEarnedInRangeText" FontWeight="Bold" FontSize="16"
                                           Foreground="{DynamicResource AccentBrush}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <DataGrid x:Name="UnlocksDataGrid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True"
                              Margin="10,0,10,10" HeadersVisibility="Column"
                              Background="{DynamicResource BgSecondaryBrush}"
                              BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"
                              ToolTip.Tip="Achievements unlocks data grid">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Game Icon" Width="Auto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="models:RaEarnedAchievement">
                                        <controls:RemoteImage Url="{Binding GameIconFullUrl}" Width="32" Height="32" Margin="5" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Game Title" Binding="{Binding GameTitle}" Width="*" SortMemberPath="GameTitle" />
                            <DataGridTemplateColumn Header="Badge" Width="Auto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="models:RaEarnedAchievement">
                                        <controls:RemoteImage Url="{Binding BadgeFullUrl}" Width="32" Height="32" Margin="5" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Achievement" Binding="{Binding Title}" Width="2*" SortMemberPath="Title" />
                            <DataGridTextColumn Header="Points" Binding="{Binding Points}" Width="Auto"
                                                SortMemberPath="Points" />
                            <DataGridTextColumn Header="True Ratio" Binding="{Binding TrueRatio, StringFormat='{}{0}%'}"
                                                Width="Auto" SortMemberPath="TrueRatio" />
                            <DataGridTextColumn Header="Unlocked Date" Binding="{Binding UnlockedDateDisplay}" Width="Auto"
                                                SortMemberPath="UnlockedDate" />
                            <DataGridTextColumn Header="Mode" Binding="{Binding ModeDisplay}" Width="Auto"
                                                SortMemberPath="ModeDisplay" />
                            <DataGridTextColumn Header="Console" Binding="{Binding ConsoleName}" Width="Auto" SortMemberPath="ConsoleName" />
                            <DataGridTextColumn Header="Author" Binding="{Binding Author}" Width="Auto" SortMemberPath="Author" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <Grid x:Name="NoUnlocksOverlay" Grid.Row="2" Background="{DynamicResource BgPrimaryBrush}" IsVisible="False">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock x:Name="NoUnlocksMessage" Text="No unlocks found for the selected date range."
                                       VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="18"
                                       Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" TextAlignment="Center" />
                            <Button Content="Open RetroAchievements Settings" Margin="0,15,0,0"
                                    Classes="primary" Click="OpenRaSettings_Click"
                                    ToolTip.Tip="Open RetroAchievements settings" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- Tab 6: User Progress -->
            <TabItem Header="User Progress |" Tag="UserProgress">
                <Grid>
                    <DataGrid x:Name="UserProgressDataGrid" AutoGenerateColumns="False" IsReadOnly="True"
                              Margin="10" HeadersVisibility="Column"
                              Background="{DynamicResource BgSecondaryBrush}"
                              BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"
                              ToolTip.Tip="User progress data grid">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Icon" Width="Auto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="models:RaUserCompletionGame">
                                        <controls:RemoteImage Url="{Binding ImageIcon}" Width="32" Height="32" Margin="5" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Game Title" Binding="{Binding Title}" Width="2*" SortMemberPath="Title" />
                            <DataGridTextColumn Header="Console" Binding="{Binding ConsoleName}" Width="*" SortMemberPath="ConsoleName" />
                            <DataGridTextColumn Header="Casual" Binding="{Binding CompletionDisplay}" Width="Auto"
                                                SortMemberPath="NumAwarded" />
                            <DataGridTextColumn Header="Hardcore" Binding="{Binding HardcoreCompletionDisplay}" Width="Auto"
                                                SortMemberPath="NumAwardedHardcore" />
                            <DataGridTextColumn Header="Most Recent Award" Binding="{Binding MostRecentAwardedDateDisplay}" Width="Auto"
                                                SortMemberPath="MostRecentAwardedDate" />
                            <DataGridTextColumn Header="Highest Award" Binding="{Binding HighestAwardKindDisplay}" Width="Auto"
                                                SortMemberPath="HighestAwardKind" />
                            <DataGridTextColumn Header="Highest Award Date" Binding="{Binding HighestAwardDateDisplay}" Width="Auto"
                                                SortMemberPath="HighestAwardDate" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <Grid x:Name="NoUserProgressOverlay" Background="{DynamicResource BgPrimaryBrush}" IsVisible="False">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock x:Name="NoUserProgressMainMessage" Text="Could not load user completion progress."
                                       VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="18"
                                       TextWrapping="Wrap" TextAlignment="Center"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock x:Name="NoUserProgressSubMessage"
                                       Text="Please check your username and API key in settings, or try again later."
                                       VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="14"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Margin="0,10,0,0" TextWrapping="Wrap" TextAlignment="Center" />
                            <Button Content="Open RetroAchievements Settings" Margin="0,15,0,0"
                                    Classes="primary" Click="OpenRaSettings_Click"
                                    ToolTip.Tip="Open RetroAchievements settings" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Loading Overlay -->
        <Border Grid.Row="0" x:Name="LoadingOverlay" Background="{DynamicResource OverlayProcessingBrush}" IsVisible="False" ZIndex="10">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MinWidth="260">
                <ProgressBar IsIndeterminate="True" Width="220" />
                <TextBlock x:Name="LoadingOverlayMessage" Text="Loading..." Margin="0,12,0,0"
                           HorizontalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}" />
                <Button x:Name="EmergencyReturnButton" Content="Return" Margin="0,15,0,0"
                        Classes="secondary" Click="EmergencyOverlayRelease_Click" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
