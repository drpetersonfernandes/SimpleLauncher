<Window x:Class="SimpleLauncher.Avalonia.SupportWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Support"
        Width="600" Height="450"
        CanResize="False"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid x:Name="MainContentGrid" RowDefinitions="Auto,Auto,Auto,*,Auto">

            <TextBlock Grid.Row="0" Margin="10,10,10,20"
                       Text="Use the form below to get support."
                       TextWrapping="Wrap" />

            <StackPanel Grid.Row="1" Margin="10,0,10,10" Orientation="Horizontal">
                <TextBlock Width="95" VerticalAlignment="Center" Text="Name"
                           Classes="form-label" />
                <TextBox x:Name="NameTextBox" Width="270"
                         Text="{Binding Name}" />
            </StackPanel>

            <StackPanel Grid.Row="2" Margin="10,0,10,20" Orientation="Horizontal">
                <TextBlock Width="95" VerticalAlignment="Center" Text="Email"
                           Classes="form-label" />
                <TextBox x:Name="EmailTextBox" Width="270"
                         Text="{Binding Email}" />
            </StackPanel>

            <TextBox x:Name="SupportTextBox"
                     Grid.Row="3"
                     Height="200"
                     Margin="10,0,10,20"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     Text="{Binding SupportRequest}" />

            <StackPanel Grid.Row="4" Margin="10,0,10,20"
                        HorizontalAlignment="Center"
                        Orientation="Horizontal">
                <Button Classes="primary"
                        IsDefault="True"
                        Command="{Binding SendSupportRequestCommand}"
                        Content="Send Support Request" />
                <Button Classes="secondary"
                        IsCancel="True"
                        Margin="10,0,0,0"
                        Command="{Binding CloseCommand}"
                        Content="Close" />
            </StackPanel>
        </Grid>

        <!-- Overlay for loading -->
        <Border x:Name="LoadingOverlay"
                Background="#B31E1E1E"
                IsVisible="False"
                ZIndex="10">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar IsIndeterminate="True" Width="220" />
                <TextBlock x:Name="LoadingOverlayMessage"
                           Text="Sending support request..."
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           FontSize="14"
                           HorizontalAlignment="Center"
                           Margin="0,12,0,0" />
                <Button x:Name="EmergencyButton"
                        Content="Cancel" Width="100" Margin="0,16,0,0"
                        Classes="secondary"
                        Click="EmergencyOverlayRelease_Click"
                        HorizontalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</Window>