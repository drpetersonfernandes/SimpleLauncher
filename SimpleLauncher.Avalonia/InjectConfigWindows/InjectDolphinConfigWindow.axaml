<Window x:Class="SimpleLauncher.Avalonia.InjectConfigWindows.InjectDolphinConfigWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="using:SimpleLauncher.Avalonia.Converters"
        Title="Dolphin Configuration"
        Height="500" Width="700"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgPrimaryBrush}">

    <Window.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>

    <Grid Margin="10" RowDefinitions="*,Auto">

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Core Section -->
                <GroupBox Header="Core &amp; Graphics">
                    <StackPanel Margin="5">
                        <Grid ColumnDefinitions="*,*" Margin="0,0,0,5">
                            <TextBlock Text="Graphics Backend:" Classes="form-label" />
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding GfxBackendOptions}"
                                      SelectedItem="{Binding GfxBackend}"
                                      ToolTip.Tip="Select the graphics API. Vulkan is generally recommended for modern GPUs." />
                        </Grid>
                        <CheckBox IsChecked="{Binding DspThread}"
                                  Content="Enable DSP Thread"
                                  Margin="0,5"
                                  ToolTip.Tip="Runs DSP emulation on a separate thread. Improves performance on most multi-core CPUs." />
                    </StackPanel>
                </GroupBox>

                <!-- Wiimote Section -->
                <GroupBox Header="Wiimote">
                    <StackPanel Margin="5">
                        <CheckBox IsChecked="{Binding WiimoteContinuousScanning}"
                                  Content="Continuous Scanning"
                                  Margin="0,5"
                                  ToolTip.Tip="Continuously look for real Wiimotes to connect via Bluetooth." />
                        <CheckBox IsChecked="{Binding WiimoteEnableSpeaker}"
                                  Content="Enable Wiimote Speaker"
                                  Margin="0,5"
                                  ToolTip.Tip="Enables sound output through the physical Wiimote controller speaker." />
                    </StackPanel>
                </GroupBox>

                <!-- CRITICAL SETTING -->
                <Border Classes="important-setting">
                    <StackPanel>
                        <TextBlock Text="⚠ IMPORTANT SETTING" Classes="important-setting-header" />
                        <CheckBox IsChecked="{Binding ShowBeforeLaunch}"
                                  Content="Show these settings before launching Dolphin"
                                  ToolTip.Tip="Show this window before launching a game." />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Save"
                    Classes="secondary"
                    Command="{Binding SaveCommand}"
                    ToolTip.Tip="Save the configuration and close this window." />
            <Button Content="Save &amp; Run"
                    Classes="primary"
                    Command="{Binding RunCommand}"
                    IsDefault="True"
                    IsVisible="{Binding IsLauncherMode, Converter={StaticResource BoolToVisibility}}"
                    ToolTip.Tip="Save the configuration and run the game." />
            <Button Content="Cancel"
                    Classes="secondary"
                    Command="{Binding CancelCommand}"
                    ToolTip.Tip="Cancel and close this window without saving changes." />
        </StackPanel>
    </Grid>
</Window>
