<Window x:Class="SimpleLauncher.Avalonia.InjectConfigWindows.InjectRedreamConfigWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Redream Configuration"
        Height="850" Width="700"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgPrimaryBrush}">

    <Grid Margin="10" RowDefinitions="*,Auto">

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Video Section -->
                <GroupBox Header="Video" Margin="0,0,0,10">
                    <StackPanel Margin="5">
                        <Grid ColumnDefinitions="*,*" Margin="0,0,0,5">
                            <TextBlock Text="Cable:" Classes="form-label" />
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding CableOptions}"
                                      SelectedItem="{Binding RedreamCable}"
                                      ToolTip.Tip="Video cable type." />
                        </Grid>
                        <Grid ColumnDefinitions="*,*" Margin="0,0,0,5">
                            <TextBlock Text="Broadcast:" Classes="form-label" />
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding BroadcastOptions}"
                                      SelectedItem="{Binding RedreamBroadcast}"
                                      ToolTip.Tip="Video broadcast standard." />
                        </Grid>
                        <CheckBox IsChecked="{Binding RedreamVsync}"
                                  Content="Vertical Sync"
                                  Margin="0,5"
                                  ToolTip.Tip="Enable vertical sync." />
                        <CheckBox IsChecked="{Binding RedreamFrameskip}"
                                  Content="Frame Skip"
                                  Margin="0,5"
                                  ToolTip.Tip="Enable frame skip." />
                        <Grid ColumnDefinitions="*,*" Margin="0,5,0,5">
                            <TextBlock Text="Aspect Ratio:" Classes="form-label" />
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding AspectOptions}"
                                      SelectedItem="{Binding RedreamAspect}"
                                      ToolTip.Tip="Screen aspect ratio." />
                        </Grid>
                        <Grid ColumnDefinitions="*,*" Margin="0,5,0,5">
                            <TextBlock Text="Resolution Scale:" Classes="form-label" />
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding ResOptions}"
                                      SelectedItem="{Binding RedreamRes}"
                                      ToolTip.Tip="Internal resolution scaling factor (e.g., 2 for 2x)." />
                        </Grid>
                        <Grid ColumnDefinitions="*,*" Margin="0,5,0,5">
                            <TextBlock Text="Renderer:" Classes="form-label" />
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding RendererOptions}"
                                      SelectedItem="{Binding RedreamRenderer}"
                                      ToolTip.Tip="Graphics renderer to use." />
                        </Grid>
                        <Grid ColumnDefinitions="*,*" Margin="0,5,0,5">
                            <TextBlock Text="Fullscreen Mode:" Classes="form-label" />
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding FullmodeOptions}"
                                      SelectedItem="{Binding RedreamFullmode}"
                                      ToolTip.Tip="How the game is displayed in fullscreen." />
                        </Grid>
                    </StackPanel>
                </GroupBox>

                <!-- System Section -->
                <GroupBox Header="System" Margin="0,0,0,10">
                    <StackPanel Margin="5">
                        <Grid ColumnDefinitions="*,*" Margin="0,5,0,5">
                            <TextBlock Text="Volume" Classes="form-label" />
                            <DockPanel Grid.Column="1">
                                <TextBlock Text="{Binding ElementName=SldVolume, Path=Value, StringFormat={}{0}%}"
                                           Width="40" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="5,0,0,0" />
                                <Slider x:Name="SldVolume"
                                        Value="{Binding RedreamVolume}"
                                        Minimum="0" Maximum="100"
                                        TickFrequency="1" IsSnapToTickEnabled="True" />
                            </DockPanel>
                        </Grid>
                        <Grid ColumnDefinitions="*,*" Margin="0,5,0,5">
                            <TextBlock Text="Latency (ms)" Classes="form-label" />
                            <ComboBox Grid.Column="1" IsEditable="True"
                                      Text="{Binding RedreamLatency}"
                                      ToolTip.Tip="Set the audio latency.">
                                <ComboBoxItem Content="8" />
                                <ComboBoxItem Content="16" />
                                <ComboBoxItem Content="32" />
                                <ComboBoxItem Content="48" />
                                <ComboBoxItem Content="64" />
                            </ComboBox>
                        </Grid>
                        <CheckBox IsChecked="{Binding RedreamFramerate}"
                                  Content="Frame Rate Counter"
                                  Margin="0,5"
                                  ToolTip.Tip="Show the frame rate counter." />
                        <Grid ColumnDefinitions="*,*" Margin="0,5,0,5">
                            <TextBlock Text="Language:" Classes="form-label" />
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding LanguageOptions}"
                                      SelectedItem="{Binding RedreamLanguage}"
                                      ToolTip.Tip="System language." />
                        </Grid>
                        <Grid ColumnDefinitions="*,*" Margin="0,5,0,5">
                            <TextBlock Text="Region:" Classes="form-label" />
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding RegionOptions}"
                                      SelectedItem="{Binding RedreamRegion}"
                                      ToolTip.Tip="System region." />
                        </Grid>
                    </StackPanel>
                </GroupBox>

                <!-- CRITICAL SETTING -->
                <Border Classes="important-setting">
                    <StackPanel>
                        <TextBlock Text="⚠ IMPORTANT SETTING" Classes="important-setting-header" />
                        <CheckBox IsChecked="{Binding RedreamShowSettingsBeforeLaunch}"
                                  Content="Show this window before launching a game"
                                  ToolTip.Tip="Show this window before launching a game." />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="BtnSave"
                    Content="Save"
                    Classes="secondary"
                    Command="{Binding SaveCommand}"
                    ToolTip.Tip="Save the configuration and close this window." />
            <Button Content="Save &amp; Run"
                    Classes="primary"
                    Command="{Binding RunCommand}"
                    IsDefault="True"
                    IsVisible="{Binding IsLauncherMode, Converter={StaticResource BoolToVisibility}}"
                    ToolTip.Tip="Save the configuration and run the game." />
            <Button Content="Cancel"
                    Classes="secondary"
                    Command="{Binding CancelCommand}"
                    ToolTip.Tip="Cancel and close this window without saving changes." />
        </StackPanel>
    </Grid>
</Window>
