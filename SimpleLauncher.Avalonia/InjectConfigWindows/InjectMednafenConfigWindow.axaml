<Window x:Class="SimpleLauncher.Avalonia.InjectConfigWindows.InjectMednafenConfigWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="using:SimpleLauncher.Avalonia.Converters"
        Title="Mednafen Configuration"
        Height="750" Width="700"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgPrimaryBrush}">

    <Grid Margin="10" RowDefinitions="*,Auto">

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Video Section -->
                <GroupBox Header="Video" Margin="0,0,0,10">
                    <StackPanel Margin="5">
                        <Grid ColumnDefinitions="*,*" Margin="0,0,0,5">
                            <TextBlock Text="Video Driver:" Classes="form-label" VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding VideoDriverOptions}"
                                      SelectedItem="{Binding MednafenVideoDriver}"
                                      ToolTip.Tip="Select the video rendering driver. 'opengl' is recommended for performance and features." />
                        </Grid>
                        <CheckBox IsChecked="{Binding MednafenFullscreen}"
                                  Content="Run in Fullscreen"
                                  Margin="0,5"
                                  ToolTip.Tip="If checked, the emulator will start in fullscreen mode." />
                        <CheckBox IsChecked="{Binding MednafenVsync}"
                                  Content="Enable VSync"
                                  Margin="0,5"
                                  ToolTip.Tip="Synchronizes the frame rate with your monitor's refresh rate to prevent screen tearing. Requires 'opengl' driver." />
                        <Grid ColumnDefinitions="*,*" Margin="0,5,0,5">
                            <TextBlock Text="Aspect Ratio / Stretch:" Classes="form-label" VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding StretchOptions}"
                                      SelectedItem="{Binding MednafenStretch}"
                                      ToolTip.Tip="How the game image is stretched to fit the screen. 'aspect' is recommended." />
                        </Grid>
                        <CheckBox IsChecked="{Binding MednafenBilinear}"
                                  Content="Bilinear Interpolation"
                                  Margin="0,5"
                                  ToolTip.Tip="Smooths pixels when scaling the image. Can make games look blurry." />
                    </StackPanel>
                </GroupBox>

                <!-- Effects Section -->
                <GroupBox Header="Effects" Margin="0,0,0,10">
                    <StackPanel Margin="5">
                        <TextBlock Text="Scanlines Opacity:" Classes="form-label" VerticalAlignment="Center" />
                        <Slider Value="{Binding MednafenScanlines}" Minimum="0" Maximum="100" IsSnapToTickEnabled="True" TickFrequency="1" ToolTip.Tip="Adds horizontal lines to mimic an old CRT screen. 0 is off, 100 is fully opaque." />
                        <Grid ColumnDefinitions="*,*" Margin="0,5,0,5">
                            <TextBlock Text="Shader:" Classes="form-label" VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding ShaderOptions}"
                                      SelectedItem="{Binding MednafenShader}"
                                      ToolTip.Tip="Applies a post-processing effect to the game image. Requires 'opengl' driver." />
                        </Grid>
                    </StackPanel>
                </GroupBox>

                <!-- Sound Section -->
                <GroupBox Header="Sound" Margin="0,0,0,10">
                    <StackPanel Margin="5">
                        <TextBlock Text="Master Volume (%):" Classes="form-label" VerticalAlignment="Center" />
                        <Slider Value="{Binding MednafenVolume}" Minimum="0" Maximum="100" IsSnapToTickEnabled="True" TickFrequency="1" ToolTip.Tip="Adjusts the main sound volume. 100 is default." />
                    </StackPanel>
                </GroupBox>

                <!-- Features Section -->
                <GroupBox Header="Features" Margin="0,0,0,10">
                    <StackPanel Margin="5">
                        <CheckBox IsChecked="{Binding MednafenCheats}"
                                  Content="Enable Cheats"
                                  Margin="0,5"
                                  ToolTip.Tip="Enables the cheat system within the emulator." />
                        <CheckBox IsChecked="{Binding MednafenRewind}"
                                  Content="Enable Rewind"
                                  Margin="0,5"
                                  ToolTip.Tip="Allows you to rewind gameplay. Can be performance-intensive." />
                    </StackPanel>
                </GroupBox>

                <!-- CRITICAL SETTING -->
                <Border Classes="important-setting">
                    <StackPanel>
                        <TextBlock Text="⚠ IMPORTANT SETTING" Classes="important-setting-header" />
                        <CheckBox IsChecked="{Binding MednafenShowSettingsBeforeLaunch}"
                                  Content="Show this window before launching a game"
                                  ToolTip.Tip="Show this window before launching a game." />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="BtnSave" Content="Save"
                    Classes="secondary"
                    Command="{Binding SaveCommand}"
                    ToolTip.Tip="Save the configuration and close this window." />
            <Button Content="Save &amp; Run"
                    Classes="primary"
                    Command="{Binding RunCommand}"
                    IsDefault="True"
                    IsVisible="{Binding IsLauncherMode, Converter={StaticResource BoolToVisibility}}"
                    ToolTip.Tip="Save the configuration and run the game." />
            <Button Content="Cancel"
                    Classes="secondary"
                    Command="{Binding CancelCommand}"
                    ToolTip.Tip="Cancel and close this window without saving changes." />
        </StackPanel>
    </Grid>
</Window>
