<Window x:Class="SimpleLauncher.Avalonia.InjectConfigWindows.InjectMameConfigWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="using:SimpleLauncher.Avalonia.Converters"
        Title="MAME Configuration"
        Height="600" Width="700"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgPrimaryBrush}">

    <Window.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>

    <Grid Margin="10" RowDefinitions="*,Auto">

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Video Section -->
                <GroupBox Header="Video / Display" Margin="0,0,0,10">
                    <StackPanel Margin="5">
                        <Grid ColumnDefinitions="*,*" Margin="0,0,0,5">
                            <TextBlock Text="Video Mode:" Classes="form-label" />
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding VideoOptions}"
                                      SelectedItem="{Binding MameVideo}"
                                      ToolTip.Tip="Specifies the video technology used for rendering (e.g., d3d, opengl, bgfx)." />
                        </Grid>
                        <Grid ColumnDefinitions="*,*" Margin="0,0,0,5">
                            <TextBlock Text="BGFX Backend:" Classes="form-label" />
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding BgfxBackendOptions}"
                                      SelectedItem="{Binding MameBgfxBackend}"
                                      ToolTip.Tip="The rendering backend for BGFX (e.g., d3d11, vulkan)." />
                        </Grid>
                        <Grid ColumnDefinitions="*,*" Margin="0,0,0,5">
                            <TextBlock Text="BGFX Shader:" Classes="form-label" />
                            <ComboBox Grid.Column="1" IsEditable="True"
                                      ItemsSource="{Binding BgfxChainsOptions}"
                                      Text="{Binding MameBgfxScreenChains}"
                                      ToolTip.Tip="Post-processing shader chains (e.g., crt-geom)." />
                        </Grid>
                        <CheckBox IsChecked="{Binding MameFilter}"
                                  Content="Bilinear Filtering"
                                  Margin="0,5"
                                  ToolTip.Tip="Applies bilinear filtering to smooth the image." />
                        <CheckBox IsChecked="{Binding MameWindow}"
                                  Content="Run in Window"
                                  Margin="0,5"
                                  ToolTip.Tip="Runs MAME in a window instead of fullscreen." />
                        <CheckBox IsChecked="{Binding MameMaximize}"
                                  Content="Maximize (Start maximized)"
                                  Margin="0,5"
                                  ToolTip.Tip="Starts the window maximized." />
                        <CheckBox IsChecked="{Binding MameKeepAspect}"
                                  Content="Enforce Aspect Ratio"
                                  Margin="0,5"
                                  ToolTip.Tip="Maintains the original aspect ratio of the game." />
                    </StackPanel>
                </GroupBox>

                <!-- Performance and Advanced Section -->
                <GroupBox Header="Performance And Advanced" Margin="0,0,0,10">
                    <StackPanel Margin="5">
                        <CheckBox IsChecked="{Binding MameAutoframeskip}"
                                  Content="Auto Frameskip"
                                  Margin="0,5"
                                  ToolTip.Tip="Automatically skips frames to maintain full speed." />
                        <CheckBox IsChecked="{Binding MameCheat}"
                                  Content="Enable Cheats"
                                  Margin="0,5"
                                  ToolTip.Tip="Enables the internal MAME cheat system." />
                        <CheckBox IsChecked="{Binding MameRewind}"
                                  Content="Enable Rewind"
                                  Margin="0,5"
                                  ToolTip.Tip="Enables the ability to rewind gameplay." />
                        <CheckBox IsChecked="{Binding MameNvramSave}"
                                  Content="Save NVRAM (High Scores)"
                                  Margin="0,5"
                                  ToolTip.Tip="Saves non-volatile RAM (high scores, settings) on exit." />
                    </StackPanel>
                </GroupBox>

                <!-- UX Section -->
                <GroupBox Header="User Experience" Margin="0,0,0,10">
                    <StackPanel Margin="5">
                        <CheckBox IsChecked="{Binding MameSkipGameInfo}"
                                  Content="Skip Game Info Screen"
                                  Margin="0,5"
                                  ToolTip.Tip="Skips the 'This system is working...' startup screens." />
                        <CheckBox IsChecked="{Binding MameAutosave}"
                                  Content="Autosave State"
                                  Margin="0,5"
                                  ToolTip.Tip="Automatically save state on exit and load on start." />
                        <CheckBox IsChecked="{Binding MameConfirmQuit}"
                                  Content="Confirm Quit"
                                  Margin="0,5"
                                  ToolTip.Tip="Ask for confirmation before exiting MAME." />
                    </StackPanel>
                </GroupBox>

                <!-- Input Section -->
                <GroupBox Header="Input" Margin="0,0,0,10">
                    <StackPanel Margin="5">
                        <CheckBox IsChecked="{Binding MameJoystick}"
                                  Content="Enable Joystick / Gamepad"
                                  Margin="0,5"
                                  ToolTip.Tip="Enables joystick and gamepad input." />
                    </StackPanel>
                </GroupBox>

                <!-- CRITICAL SETTING -->
                <Border Classes="important-setting">
                    <StackPanel>
                        <TextBlock Text="⚠ IMPORTANT SETTING" Classes="important-setting-header" />
                        <CheckBox IsChecked="{Binding MameShowSettingsBeforeLaunch}"
                                  Content="Open this window before launching a MAME game"
                                  ToolTip.Tip="Show this window before launching a game." />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="BtnSave" Content="Save"
                    Classes="secondary"
                    Command="{Binding SaveCommand}"
                    ToolTip.Tip="Save the configuration and close this window." />
            <Button Content="Save &amp; Run"
                    Classes="primary"
                    Command="{Binding RunCommand}"
                    IsDefault="True"
                    IsVisible="{Binding IsLauncherMode, Converter={StaticResource BoolToVisibility}}"
                    ToolTip.Tip="Save the configuration and run the game." />
            <Button Content="Cancel"
                    Classes="secondary"
                    Command="{Binding CancelCommand}"
                    ToolTip.Tip="Cancel and close this window without saving changes." />
        </StackPanel>
    </Grid>
</Window>
