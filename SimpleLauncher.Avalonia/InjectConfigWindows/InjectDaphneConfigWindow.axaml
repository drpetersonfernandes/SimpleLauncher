<Window x:Class="SimpleLauncher.Avalonia.InjectConfigWindows.InjectDaphneConfigWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="using:SimpleLauncher.Avalonia.Converters"
        Title="Daphne Configuration"
        Height="550" Width="700"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgPrimaryBrush}">

    <Window.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>

    <Grid Margin="10" RowDefinitions="*,Auto">

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Video Section -->
                <GroupBox Header="Video &amp; Display" Margin="0,0,0,10">
                    <StackPanel Margin="5">
                        <CheckBox IsChecked="{Binding DaphneFullscreen}"
                                  Content="Run in Fullscreen"
                                  Margin="0,5"
                                  ToolTip.Tip="If checked, the game will launch in fullscreen mode." />
                        <CheckBox IsChecked="{Binding DaphneBilinear}"
                                  Content="Enable Bilinear Filtering"
                                  Margin="0,5"
                                  ToolTip.Tip="If checked, smooths the video. Uncheck for sharp, pixelated graphics." />
                        <TextBlock Text="Resolution:" Classes="form-label"
                                   Margin="0,5,0,0"
                                   ToolTip.Tip="Set the windowed or fullscreen resolution." />
                        <Grid ColumnDefinitions="*,Auto,*">
                            <NumericUpDown Grid.Column="0" Minimum="640" Maximum="7680" Increment="1"
                                           Value="{Binding DaphneResX}"
                                           ToolTip.Tip="Set the horizontal resolution." />
                            <TextBlock Grid.Column="1" Text="x" VerticalAlignment="Center" Margin="10,0" />
                            <NumericUpDown Grid.Column="2" Minimum="480" Maximum="4320" Increment="1"
                                           Value="{Binding DaphneResY}"
                                           ToolTip.Tip="Set the vertical resolution." />
                        </Grid>
                    </StackPanel>
                </GroupBox>

                <!-- Audio Section -->
                <GroupBox Header="Audio" Margin="0,0,0,10">
                    <StackPanel Margin="5">
                        <CheckBox IsChecked="{Binding DaphneEnableSound}"
                                  Content="Enable Sound"
                                  Margin="0,5"
                                  ToolTip.Tip="Uncheck to mute all game audio." />
                    </StackPanel>
                </GroupBox>

                <!-- Gameplay Section -->
                <GroupBox Header="Gameplay" Margin="0,0,0,10">
                    <StackPanel Margin="5">
                        <CheckBox IsChecked="{Binding DaphneDisableCrosshairs}"
                                  Content="Disable Crosshairs"
                                  Margin="0,5"
                                  ToolTip.Tip="For shooting games, hides the mouse cursor/crosshair." />
                        <CheckBox IsChecked="{Binding DaphneUseOverlays}"
                                  Content="Use Score Overlays"
                                  Margin="0,5"
                                  ToolTip.Tip="Enable or disable the on-screen score and credit displays." />
                    </StackPanel>
                </GroupBox>

                <!-- CRITICAL SETTING -->
                <Border Classes="important-setting">
                    <StackPanel>
                        <TextBlock Text="⚠ IMPORTANT SETTING" Classes="important-setting-header" />
                        <CheckBox IsChecked="{Binding DaphneShowSettingsBeforeLaunch}"
                                  Content="Show this window before launching a game"
                                  ToolTip.Tip="Show this window before launching a game." />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="BtnSave" Content="Save"
                    Classes="secondary"
                    Command="{Binding SaveCommand}"
                    ToolTip.Tip="Save the configuration and close this window." />
            <Button Content="Save &amp; Run"
                    Classes="primary"
                    Command="{Binding RunCommand}"
                    IsDefault="True"
                    IsVisible="{Binding IsLauncherMode, Converter={StaticResource BoolToVisibility}}"
                    ToolTip.Tip="Save the configuration and run the game." />
            <Button Content="Cancel"
                    Classes="secondary"
                    Command="{Binding CancelCommand}"
                    ToolTip.Tip="Cancel and close this window without saving changes." />
        </StackPanel>
    </Grid>
</Window>
