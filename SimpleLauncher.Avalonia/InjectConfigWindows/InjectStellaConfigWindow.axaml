<Window x:Class="SimpleLauncher.Avalonia.InjectConfigWindows.InjectStellaConfigWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="using:SimpleLauncher.Avalonia.Converters"
        Title="Stella Configuration"
        Height="700" Width="700"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgPrimaryBrush}">

    <Grid Margin="10" RowDefinitions="*,Auto">

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Video Section -->
                <GroupBox Header="Video" Margin="0,0,0,10">
                    <StackPanel Margin="5">
                        <CheckBox IsChecked="{Binding Fullscreen}"
                                  Content="Run in Fullscreen"
                                  Margin="0,5"
                                  ToolTip.Tip="If checked, the emulator will start in fullscreen mode." />
                        <CheckBox IsChecked="{Binding Vsync}"
                                  Content="Enable V-Sync"
                                  Margin="0,5"
                                  ToolTip.Tip="Synchronize rendering with the display's refresh rate to prevent screen tearing." />
                        <CheckBox IsChecked="{Binding CorrectAspect}"
                                  Content="Correct Aspect Ratio"
                                  Margin="0,5"
                                  ToolTip.Tip="Maintains the original aspect ratio of the Atari 2600." />
                        <Grid ColumnDefinitions="*,*" Margin="0,5,0,5">
                            <TextBlock Text="Video Driver:" Classes="form-label" VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding VideoDriverOptions}"
                                      SelectedItem="{Binding VideoDriver}"
                                      ToolTip.Tip="Selects the graphics API to use for rendering. 'direct3d' is recommended for Windows." />
                        </Grid>
                        <Grid ColumnDefinitions="*,*" Margin="0,5,0,5">
                            <TextBlock Text="TV Effects:" Classes="form-label" VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding TvFilterOptions}"
                                      SelectedItem="{Binding TvFilter}"
                                      ToolTip.Tip="Simulates different types of television displays." />
                        </Grid>
                        <TextBlock Text="Scanlines Intensity:" Classes="form-label" VerticalAlignment="Center" />
                        <Slider Value="{Binding Scanlines}" Minimum="0" Maximum="100" IsSnapToTickEnabled="True" TickFrequency="1" ToolTip.Tip="Adjusts the visibility of simulated scanlines (0-100)." />
                    </StackPanel>
                </GroupBox>

                <!-- Audio Section -->
                <GroupBox Header="Audio" Margin="0,0,0,10">
                    <StackPanel Margin="5">
                        <CheckBox IsChecked="{Binding AudioEnabled}"
                                  Content="Enable Audio"
                                  Margin="0,5"
                                  ToolTip.Tip="Toggles all sound output on or off." />
                        <TextBlock Text="Master Volume:" Classes="form-label" VerticalAlignment="Center" />
                        <Slider Value="{Binding AudioVolume}" Minimum="0" Maximum="100" IsSnapToTickEnabled="True" TickFrequency="1" ToolTip.Tip="Adjusts the overall sound volume (0-100)." />
                    </StackPanel>
                </GroupBox>

                <!-- Features Section -->
                <GroupBox Header="Features" Margin="0,0,0,10">
                    <StackPanel Margin="5">
                        <CheckBox IsChecked="{Binding TimeMachine}"
                                  Content="Enable Rewind (Time Machine)"
                                  Margin="0,5"
                                  ToolTip.Tip="Allows you to rewind gameplay. May impact performance." />
                        <CheckBox IsChecked="{Binding ConfirmExit}"
                                  Content="Confirm on Exit"
                                  Margin="0,5"
                                  ToolTip.Tip="If checked, Stella will ask for confirmation before closing." />
                    </StackPanel>
                </GroupBox>

                <!-- CRITICAL SETTING -->
                <Border Classes="important-setting">
                    <StackPanel>
                        <TextBlock Text="⚠ IMPORTANT SETTING" Classes="important-setting-header" />
                        <CheckBox IsChecked="{Binding ShowBeforeLaunch}"
                                  Content="Show this window before launching a game"
                                  ToolTip.Tip="Show this window before launching a game." />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="BtnSave" Content="Save"
                    Classes="secondary"
                    Command="{Binding SaveCommand}"
                    ToolTip.Tip="Save the configuration and close this window." />
            <Button Content="Save &amp; Run"
                    Classes="primary"
                    Command="{Binding RunCommand}"
                    IsDefault="True"
                    IsVisible="{Binding IsLauncherMode, Converter={StaticResource BoolToVisibility}}"
                    ToolTip.Tip="Save the configuration and run the game." />
            <Button Content="Cancel"
                    Classes="secondary"
                    Command="{Binding CancelCommand}"
                    ToolTip.Tip="Cancel and close this window without saving changes." />
        </StackPanel>
    </Grid>
</Window>
