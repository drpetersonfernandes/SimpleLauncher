<Window x:Class="SimpleLauncher.Avalonia.InjectConfigWindows.InjectCemuConfigWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="using:SimpleLauncher.Avalonia.Converters"
        Title="Cemu Configuration Injection"
        Height="600" Width="700"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgPrimaryBrush}">

    <Grid Margin="10" RowDefinitions="*,Auto">

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Video Section -->
                <GroupBox Header="Video &amp; Graphics" Margin="0,0,0,10">
                    <StackPanel Margin="5">
                        <CheckBox IsChecked="{Binding Fullscreen}"
                                  Content="Start in Fullscreen"
                                  Margin="0,5"
                                  ToolTip.Tip="Automatically switch to fullscreen mode when a game starts." />

                        <Grid ColumnDefinitions="*,*" Margin="0,5">
                            <TextBlock Text="Graphics API:" Classes="form-label" />
                            <ComboBox Grid.Column="1"
                                      SelectedValue="{Binding GraphicApi}"
                                      SelectedValueBinding="{Binding Tag}"
                                      ToolTip.Tip="Vulkan is generally recommended for better performance on modern hardware.">
                                <ComboBoxItem Content="OpenGL" Tag="0" />
                                <ComboBoxItem Content="Vulkan" Tag="1" />
                            </ComboBox>
                        </Grid>

                        <Grid ColumnDefinitions="*,*" Margin="0,5">
                            <TextBlock Text="VSync:" Classes="form-label" />
                            <ComboBox Grid.Column="1"
                                      SelectedValue="{Binding Vsync}"
                                      SelectedValueBinding="{Binding Tag}"
                                      ToolTip.Tip="Synchronizes frame rate with monitor refresh rate to prevent screen tearing.">
                                <ComboBoxItem Content="Off" Tag="0" />
                                <ComboBoxItem Content="On" Tag="1" />
                            </ComboBox>
                        </Grid>

                        <CheckBox IsChecked="{Binding AsyncCompile}"
                                  Content="Async Shader Compilation"
                                  Margin="0,5"
                                  ToolTip.Tip="Reduces stuttering by compiling shaders in the background." />
                    </StackPanel>
                </GroupBox>

                <!-- Audio Section -->
                <GroupBox Header="Audio Settings" Margin="0,0,0,10">
                    <StackPanel Margin="5">
                        <TextBlock Text="TV Volume:" Classes="form-label" />
                        <Slider Value="{Binding Volume}"
                                Minimum="0" Maximum="100"
                                IsSnapToTickEnabled="True" TickFrequency="1"
                                ToolTip.Tip="Adjust the master volume level for the emulated TV output." />
                    </StackPanel>
                </GroupBox>

                <!-- General Section -->
                <GroupBox Header="General &amp; System" Margin="0,0,0,10">
                    <StackPanel Margin="5">
                        <CheckBox IsChecked="{Binding Discord}"
                                  Content="Enable Discord Rich Presence"
                                  Margin="0,5"
                                  ToolTip.Tip="Show the current game you are playing on your Discord profile." />
                        <Grid ColumnDefinitions="*,*" Margin="0,5">
                            <TextBlock Text="Console Language:" Classes="form-label" />
                            <ComboBox Grid.Column="1"
                                      SelectedValue="{Binding Language}"
                                      SelectedValueBinding="{Binding Tag}"
                                      ToolTip.Tip="Sets the system language of the emulated Wii U console.">
                                <ComboBoxItem Content="Japanese" Tag="0" />
                                <ComboBoxItem Content="English" Tag="1" />
                                <ComboBoxItem Content="French" Tag="2" />
                                <ComboBoxItem Content="German" Tag="3" />
                                <ComboBoxItem Content="Italian" Tag="4" />
                                <ComboBoxItem Content="Spanish" Tag="5" />
                            </ComboBox>
                        </Grid>
                    </StackPanel>
                </GroupBox>

                <!-- CRITICAL SETTING -->
                <Border Classes="important-setting">
                    <StackPanel>
                        <TextBlock Text="⚠ IMPORTANT SETTING" Classes="important-setting-header" />
                        <CheckBox IsChecked="{Binding ShowBeforeLaunch}"
                                  Content="Show this window before launching a game"
                                  ToolTip.Tip="Show this window before launching a game." />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="BtnSave"
                    Content="Save"
                    Classes="secondary"
                    Command="{Binding SaveCommand}"
                    ToolTip.Tip="Save the configuration and close this window." />
            <Button Content="Save &amp; Run"
                    Classes="primary"
                    Command="{Binding RunCommand}"
                    IsDefault="True"
                    IsVisible="{Binding IsLauncherMode, Converter={StaticResource BoolToVisibility}}"
                    ToolTip.Tip="Save the configuration and run the game." />
            <Button Content="Cancel"
                    Classes="secondary"
                    Command="{Binding CancelCommand}"
                    ToolTip.Tip="Cancel and close this window without saving changes." />
        </StackPanel>
    </Grid>
</Window>
