<Window x:Class="SimpleLauncher.Avalonia.InjectConfigWindows.InjectRpcs3ConfigWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="using:SimpleLauncher.Avalonia.Converters"
        Title="RPCS3 Configuration"
        Height="750" Width="700"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgPrimaryBrush}">

    <Window.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>

    <Grid Margin="10" RowDefinitions="*,Auto">

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Video Section -->
                <GroupBox Header="Video Settings" Margin="0,0,0,10">
                    <StackPanel Margin="5">
                        <Grid ColumnDefinitions="*,*" Margin="0,0,0,5">
                            <TextBlock Text="Renderer:" Classes="form-label" />
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding RendererOptions}"
                                      SelectedItem="{Binding Rpcs3Renderer}"
                                      ToolTip.Tip="Select the graphics API. Vulkan is recommended for most hardware." />
                        </Grid>
                        <Grid ColumnDefinitions="*,*" Margin="0,5,0,5">
                            <TextBlock Text="Resolution:" Classes="form-label" />
                            <ComboBox Grid.Column="1" IsEditable="True"
                                      ItemsSource="{Binding ResolutionOptions}"
                                      Text="{Binding Rpcs3Resolution}"
                                      ToolTip.Tip="Set the output resolution of the emulator window." />
                        </Grid>
                        <Grid ColumnDefinitions="*,*" Margin="0,5,0,5">
                            <TextBlock Text="Aspect Ratio:" Classes="form-label" />
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding AspectRatioOptions}"
                                      SelectedItem="{Binding Rpcs3AspectRatio}"
                                      ToolTip.Tip="Set the display aspect ratio." />
                        </Grid>
                        <Grid ColumnDefinitions="*,*" Margin="0,5,0,5">
                            <TextBlock Text="Resolution Scale:" Classes="form-label" />
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding ResolutionScaleOptions}"
                                      SelectedItem="{Binding Rpcs3ResolutionScale}"
                                      ToolTip.Tip="Upscale the internal resolution for sharper graphics. 100% is native 720p." />
                        </Grid>
                        <Grid ColumnDefinitions="*,*" Margin="0,5,0,5">
                            <TextBlock Text="Anisotropic Filter:" Classes="form-label" />
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding AnisotropicFilterOptions}"
                                      SelectedItem="{Binding Rpcs3AnisotropicFilter}"
                                      ToolTip.Tip="Improves texture quality on surfaces viewed at an angle. 0 is disabled." />
                        </Grid>
                        <CheckBox IsChecked="{Binding Rpcs3Vsync}"
                                  Content="Enable VSync"
                                  Margin="0,5"
                                  ToolTip.Tip="Synchronize framerate with your monitor's refresh rate to prevent screen tearing." />
                    </StackPanel>
                </GroupBox>

                <!-- Core Section -->
                <GroupBox Header="Core Settings" Margin="0,0,0,10">
                    <StackPanel Margin="5">
                        <Grid ColumnDefinitions="*,*" Margin="0,0,0,5">
                            <TextBlock Text="PPU Decoder:" Classes="form-label" />
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding PpuDecoderOptions}"
                                      SelectedItem="{Binding Rpcs3PpuDecoder}"
                                      ToolTip.Tip="Selects the decoder for the PPU. Recompiler (LLVM) offers the best performance." />
                        </Grid>
                        <Grid ColumnDefinitions="*,*" Margin="0,5,0,5">
                            <TextBlock Text="SPU Decoder:" Classes="form-label" />
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding SpuDecoderOptions}"
                                      SelectedItem="{Binding Rpcs3SpuDecoder}"
                                      ToolTip.Tip="Selects the decoder for the SPU. Recompiler (LLVM) offers the best performance." />
                        </Grid>
                    </StackPanel>
                </GroupBox>

                <!-- Audio Section -->
                <GroupBox Header="Audio Settings" Margin="0,0,0,10">
                    <StackPanel Margin="5">
                        <Grid ColumnDefinitions="*,*" Margin="0,0,0,5">
                            <TextBlock Text="Audio Renderer:" Classes="form-label" />
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding AudioRendererOptions}"
                                      SelectedItem="{Binding Rpcs3AudioRenderer}"
                                      ToolTip.Tip="Select the audio backend. Cubeb is generally recommended." />
                        </Grid>
                        <CheckBox IsChecked="{Binding Rpcs3AudioBuffering}"
                                  Content="Enable Audio Buffering"
                                  Margin="0,5"
                                  ToolTip.Tip="Helps prevent audio stuttering at the cost of a small amount of latency." />
                    </StackPanel>
                </GroupBox>

                <!-- Miscellaneous Section -->
                <GroupBox Header="Miscellaneous" Margin="0,0,0,10">
                    <StackPanel Margin="5">
                        <CheckBox IsChecked="{Binding Rpcs3StartFullscreen}"
                                  Content="Start Games in Fullscreen"
                                  Margin="0,5"
                                  ToolTip.Tip="If checked, games will automatically launch in fullscreen mode." />
                    </StackPanel>
                </GroupBox>

                <!-- CRITICAL SETTING -->
                <Border Classes="important-setting">
                    <StackPanel>
                        <TextBlock Text="⚠ IMPORTANT SETTING" Classes="important-setting-header" />
                        <CheckBox IsChecked="{Binding Rpcs3ShowSettingsBeforeLaunch}"
                                  Content="Show this window before launching a game"
                                  ToolTip.Tip="Show this window before launching a game." />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="BtnSave"
                    Content="Save"
                    Classes="secondary"
                    Command="{Binding SaveCommand}"
                    ToolTip.Tip="Save the configuration and close this window." />
            <Button Content="Save &amp; Run"
                    Classes="primary"
                    Command="{Binding RunCommand}"
                    IsDefault="True"
                    IsVisible="{Binding IsLauncherMode, Converter={StaticResource BoolToVisibility}}"
                    ToolTip.Tip="Save the configuration and run the game." />
            <Button Content="Cancel"
                    Classes="secondary"
                    Command="{Binding CancelCommand}"
                    ToolTip.Tip="Cancel and close this window without saving changes." />
        </StackPanel>
    </Grid>
</Window>
