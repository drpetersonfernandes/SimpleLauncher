<Window x:Class="SimpleLauncher.Avalonia.InjectConfigWindows.InjectBlastemConfigWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Blastem Configuration"
        Height="600" Width="700"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgPrimaryBrush}">

    <Grid Margin="10" RowDefinitions="*,Auto">

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Video Section -->
                <GroupBox Header="Video Display" Margin="0,0,0,10">
                    <StackPanel Margin="5">
                        <CheckBox IsChecked="{Binding Fullscreen}"
                                  Content="Run in Fullscreen"
                                  Margin="0,5"
                                  ToolTip.Tip="Toggles between windowed and fullscreen mode." />
                        <CheckBox IsChecked="{Binding Vsync}"
                                  Content="Enable V-Sync"
                                  Margin="0,5"
                                  ToolTip.Tip="Synchronize framerate with monitor refresh rate to prevent screen tearing." />
                        <CheckBox IsChecked="{Binding Scanlines}"
                                  Content="Enable Scanlines"
                                  Margin="0,5"
                                  ToolTip.Tip="Simulates the look of a CRT screen by adding horizontal lines." />
                        <Grid ColumnDefinitions="*,*" Margin="0,5,0,5">
                            <TextBlock Text="Aspect Ratio:" Classes="form-label" VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding AspectOptions}"
                                      SelectedItem="{Binding Aspect}"
                                      ToolTip.Tip="Sets the display aspect ratio. 'stretch' will fill the window." />
                        </Grid>
                        <Grid ColumnDefinitions="*,*" Margin="0,5,0,5">
                            <TextBlock Text="Scaling Filter:" Classes="form-label" VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding ScalingOptions}"
                                      SelectedItem="{Binding Scaling}"
                                      ToolTip.Tip="'linear' provides smooth scaling (bilinear filtering). 'nearest' provides sharp, blocky scaling (nearest neighbor)." />
                        </Grid>
                    </StackPanel>
                </GroupBox>

                <!-- Audio Section -->
                <GroupBox Header="Audio" Margin="0,0,0,10">
                    <StackPanel Margin="5">
                        <Grid ColumnDefinitions="*,*" Margin="0,5,0,5">
                            <TextBlock Text="Audio Sample Rate:" Classes="form-label" VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding AudioRateOptions}"
                                      SelectedItem="{Binding AudioRate}"
                                      ToolTip.Tip="Sets the output audio sample rate in Hz. Higher values provide better quality." />
                        </Grid>
                    </StackPanel>
                </GroupBox>

                <!-- System Section -->
                <GroupBox Header="System" Margin="0,0,0,10">
                    <StackPanel Margin="5">
                        <Grid ColumnDefinitions="*,*" Margin="0,5,0,5">
                            <TextBlock Text="Sync Source:" Classes="form-label" VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding SyncSourceOptions}"
                                      SelectedItem="{Binding SyncSource}"
                                      ToolTip.Tip="'video' provides the smoothest experience when refresh rates match. 'audio' provides lower audio latency." />
                        </Grid>
                    </StackPanel>
                </GroupBox>

                <!-- CRITICAL SETTING -->
                <Border Classes="important-setting">
                    <StackPanel>
                        <TextBlock Text="⚠ IMPORTANT SETTING" Classes="important-setting-header" />
                        <CheckBox IsChecked="{Binding ShowBeforeLaunch}"
                                  Content="Show this window before launching a game"
                                  ToolTip.Tip="Show this window before launching a game." />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="BtnSave"
                    Content="Save"
                    Classes="secondary"
                    Command="{Binding SaveCommand}"
                    ToolTip.Tip="Save the configuration and close this window." />
            <Button Content="Save &amp; Run"
                    Classes="primary"
                    Command="{Binding RunCommand}"
                    IsDefault="True"
                    IsVisible="{Binding IsLauncherMode, Converter={StaticResource BoolToVisibility}}"
                    ToolTip.Tip="Save the configuration and run the game." />
            <Button Content="Cancel"
                    Classes="secondary"
                    Command="{Binding CancelCommand}"
                    ToolTip.Tip="Cancel and close this window without saving changes." />
        </StackPanel>
    </Grid>
</Window>
