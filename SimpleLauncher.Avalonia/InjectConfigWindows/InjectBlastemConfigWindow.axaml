<Window x:Class="SimpleLauncher.Avalonia.InjectConfigWindows.InjectBlastemConfigWindow"
        xmlns="https://github.com/avaloniaui"
         xmlns:ext="using:SimpleLauncher.Avalonia.Extensions"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Blastem Configuration"
        Height="600" Width="700"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgPrimaryBrush}">

    <Grid Margin="10" RowDefinitions="*,Auto">

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Video Section -->
                <GroupBox Header="{ext:Translate BlastemConfig_Video_Header}" Margin="0,0,0,10">
                    <StackPanel Margin="5">
                        <CheckBox IsChecked="{Binding Fullscreen}"
                                  Content="{ext:Translate SupermodelConfig_Fullscreen_Checkbox}"
                                  Margin="0,5"
                                  ToolTip.Tip="{ext:Translate BlastemConfig_Fullscreen_Tooltip}" />
                        <CheckBox IsChecked="{Binding Vsync}"
                                  Content="{ext:Translate SupermodelConfig_Vsync_Checkbox}"
                                  Margin="0,5"
                                  ToolTip.Tip="{ext:Translate BlastemConfig_Vsync_Tooltip}" />
                        <CheckBox IsChecked="{Binding Scanlines}"
                                  Content="{ext:Translate BlastemConfig_Scanlines_Checkbox}"
                                  Margin="0,5"
                                  ToolTip.Tip="{ext:Translate BlastemConfig_Scanlines_Tooltip}" />
                        <Grid ColumnDefinitions="*,*" Margin="0,5,0,5">
                            <TextBlock Text="{ext:Translate RPCS3Config_AspectRatio_Label}" Classes="form-label" VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding AspectOptions}"
                                      SelectedItem="{Binding Aspect}"
                                      ToolTip.Tip="{ext:Translate BlastemConfig_Aspect_Tooltip}" />
                        </Grid>
                        <Grid ColumnDefinitions="*,*" Margin="0,5,0,5">
                            <TextBlock Text="{ext:Translate BlastemConfig_Scaling_Label}" Classes="form-label" VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding ScalingOptions}"
                                      SelectedItem="{Binding Scaling}"
                                      ToolTip.Tip="{ext:Translate BlastemConfig_Scaling_Tooltip}" />
                        </Grid>
                    </StackPanel>
                </GroupBox>

                <!-- Audio Section -->
                <GroupBox Header="{ext:Translate SupermodelConfig_Audio_Header}" Margin="0,0,0,10">
                    <StackPanel Margin="5">
                        <Grid ColumnDefinitions="*,*" Margin="0,5,0,5">
                            <TextBlock Text="{ext:Translate BlastemConfig_AudioRate_Label}" Classes="form-label" VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding AudioRateOptions}"
                                      SelectedItem="{Binding AudioRate}"
                                      ToolTip.Tip="{ext:Translate BlastemConfig_AudioRate_Tooltip}" />
                        </Grid>
                    </StackPanel>
                </GroupBox>

                <!-- System Section -->
                <GroupBox Header="{ext:Translate RedreamConfig_System_Header}" Margin="0,0,0,10">
                    <StackPanel Margin="5">
                        <Grid ColumnDefinitions="*,*" Margin="0,5,0,5">
                            <TextBlock Text="{ext:Translate BlastemConfig_SyncSource_Label}" Classes="form-label" VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding SyncSourceOptions}"
                                      SelectedItem="{Binding SyncSource}"
                                      ToolTip.Tip="{ext:Translate BlastemConfig_SyncSource_Tooltip}" />
                        </Grid>
                    </StackPanel>
                </GroupBox>

                <!-- CRITICAL SETTING -->
                <Border Classes="important-setting">
                    <StackPanel>
                        <TextBlock Text="{ext:Translate IMPORTANTSETTING}" Classes="important-setting-header" />
                        <CheckBox IsChecked="{Binding ShowBeforeLaunch}"
                                  Content="{ext:Translate SupermodelConfig_ShowBeforeLaunch_Checkbox}"
                                  ToolTip.Tip="{ext:Translate YumirConfig_ShowBeforeLaunch_Tooltip}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="BtnSave"
                    Content="{ext:Translate YumirConfig_Save_Button}"
                    Classes="secondary"
                    Command="{Binding SaveCommand}"
                    ToolTip.Tip="{ext:Translate YumirConfig_Save_Tooltip}" />
            <Button Content="{ext:Translate YumirConfig_Run_Button2}"
                    Classes="primary"
                    Command="{Binding RunCommand}"
                    IsDefault="True"
                    IsVisible="{Binding IsLauncherMode, Converter={StaticResource BoolToVisibility}}"
                    ToolTip.Tip="{ext:Translate YumirConfig_Run_Tooltip}" />
            <Button Content="{ext:Translate YumirConfig_Cancel_Button}"
                    Classes="secondary"
                    Command="{Binding CancelCommand}"
                    ToolTip.Tip="{ext:Translate YumirConfig_Cancel_Tooltip}" />
        </StackPanel>
    </Grid>
</Window>
