<Window x:Class="SimpleLauncher.Avalonia.InjectConfigWindows.InjectAresConfigWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="using:SimpleLauncher.Avalonia.Converters"
        Title="Ares Configuration"
        Height="700" Width="700"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgPrimaryBrush}">

    <Window.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>

    <Grid Margin="10" RowDefinitions="*,Auto">

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Video Section -->
                <GroupBox Header="Video" Margin="0,0,0,10">
                    <StackPanel Margin="5">
                        <Grid ColumnDefinitions="*,*" Margin="0,0,0,5">
                            <TextBlock Text="Video Driver:" Classes="form-label" />
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding VideoDriverOptions}"
                                      SelectedItem="{Binding VideoDriver}"
                                      ToolTip.Tip="Select the graphics API to use for rendering." />
                        </Grid>
                        <CheckBox IsChecked="{Binding Exclusive}"
                                  Content="Run in Fullscreen"
                                  Margin="0,5"
                                  ToolTip.Tip="Enable exclusive fullscreen mode." />
                        <Grid ColumnDefinitions="*,*" Margin="0,5,0,5">
                            <TextBlock Text="Shader:" Classes="form-label" />
                            <ComboBox Grid.Column="1" IsEditable="True"
                                      ItemsSource="{Binding ShaderOptions}"
                                      Text="{Binding Shader}"
                                      ToolTip.Tip="Select a post-processing shader. 'None' for no shader." />
                        </Grid>
                        <Grid ColumnDefinitions="*,*" Margin="0,5,0,5">
                            <TextBlock Text="Internal Resolution Scale:" Classes="form-label" />
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding MultiplierOptions}"
                                      SelectedItem="{Binding Multiplier}"
                                      ToolTip.Tip="Increases the internal rendering resolution for sharper graphics." />
                        </Grid>
                        <Grid ColumnDefinitions="*,*" Margin="0,5,0,5">
                            <TextBlock Text="Aspect Correction:" Classes="form-label" />
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding AspectCorrectionOptions}"
                                      SelectedItem="{Binding AspectCorrection}"
                                      ToolTip.Tip="How the image is scaled to fit the screen. 'Standard' is recommended." />
                        </Grid>
                    </StackPanel>
                </GroupBox>

                <!-- Audio Section -->
                <GroupBox Header="Audio" Margin="0,0,0,10">
                    <StackPanel Margin="5">
                        <CheckBox IsChecked="{Binding Mute}"
                                  Content="Mute Audio"
                                  Margin="0,5"
                                  ToolTip.Tip="Disable all audio output." />
                        <TextBlock Text="Volume:" Classes="form-label" />
                        <Slider Value="{Binding Volume}"
                                Minimum="0.0" Maximum="2.0"
                                IsSnapToTickEnabled="True" TickFrequency="0.1"
                                ToolTip.Tip="Adjust the master audio volume. 1.0 is 100%." />
                    </StackPanel>
                </GroupBox>

                <!-- General Section -->
                <GroupBox Header="General &amp; Features" Margin="0,0,0,10">
                    <StackPanel Margin="5">
                        <CheckBox IsChecked="{Binding FastBoot}"
                                  Content="Fast Boot"
                                  Margin="0,5"
                                  ToolTip.Tip="Skips console BIOS screens for faster game loading." />
                        <CheckBox IsChecked="{Binding Rewind}"
                                  Content="Enable Rewind"
                                  Margin="0,5"
                                  ToolTip.Tip="Allows you to rewind gameplay. May impact performance." />
                        <CheckBox IsChecked="{Binding RunAhead}"
                                  Content="Enable Run-Ahead"
                                  Margin="0,5"
                                  ToolTip.Tip="Reduces input latency. May require a powerful CPU." />
                        <CheckBox IsChecked="{Binding AutoSaveMemory}"
                                  Content="Auto-Save Memory"
                                  Margin="0,5"
                                  ToolTip.Tip="Automatically saves battery-backed RAM (like save games) on exit." />
                    </StackPanel>
                </GroupBox>

                <!-- CRITICAL SETTING -->
                <Border Classes="important-setting">
                    <StackPanel>
                        <TextBlock Text="⚠ IMPORTANT SETTING" Classes="important-setting-header" />
                        <CheckBox IsChecked="{Binding ShowBeforeLaunch}"
                                  Content="Show this window before launching a game"
                                  ToolTip.Tip="Show this window before launching a game." />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="BtnSave"
                    Content="Save"
                    Classes="secondary"
                    Command="{Binding SaveCommand}"
                    ToolTip.Tip="Save the configuration and close this window." />
            <Button Content="Save &amp; Run"
                    Classes="primary"
                    Command="{Binding RunCommand}"
                    IsDefault="True"
                    IsVisible="{Binding IsLauncherMode, Converter={StaticResource BoolToVisibility}}"
                    ToolTip.Tip="Save the configuration and run the game." />
            <Button Content="Cancel"
                    Classes="secondary"
                    Command="{Binding CancelCommand}"
                    ToolTip.Tip="Cancel and close this window without saving changes." />
        </StackPanel>
    </Grid>
</Window>
