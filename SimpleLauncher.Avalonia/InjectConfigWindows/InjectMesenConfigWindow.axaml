<Window x:Class="SimpleLauncher.Avalonia.InjectConfigWindows.InjectMesenConfigWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="using:SimpleLauncher.Avalonia.Converters"
        Title="Mesen Configuration"
        Height="700" Width="700"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgPrimaryBrush}">

    <Grid Margin="10" RowDefinitions="*,Auto">

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Video Section -->
                <GroupBox Header="Video" Margin="0,0,0,10">
                    <StackPanel Margin="5">
                        <CheckBox IsChecked="{Binding Fullscreen}"
                                  Content="Run in Fullscreen"
                                  Margin="0,5"
                                  ToolTip.Tip="If checked, the emulator will start in fullscreen mode." />
                        <CheckBox IsChecked="{Binding Vsync}"
                                  Content="Enable V-Sync"
                                  Margin="0,5"
                                  ToolTip.Tip="Synchronizes the frame rate with your monitor's refresh rate to prevent screen tearing." />
                        <CheckBox IsChecked="{Binding Bilinear}"
                                  Content="Enable Bilinear Filtering"
                                  Margin="0,5"
                                  ToolTip.Tip="Smooths the image, which can reduce pixelation." />
                        <Grid ColumnDefinitions="*,*" Margin="0,5,0,5">
                            <TextBlock Text="Aspect Ratio" Classes="form-label" VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding AspectRatioOptions}"
                                      SelectedItem="{Binding AspectRatio}"
                                      ToolTip.Tip="Determines the display aspect ratio of the game." />
                        </Grid>
                        <Grid ColumnDefinitions="*,*" Margin="0,5,0,5">
                            <TextBlock Text="Video Filter" Classes="form-label" VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding VideoFilterOptions}"
                                      SelectedItem="{Binding VideoFilter}"
                                      ToolTip.Tip="Applies a visual filter to the game output (e.g., NTSC)." />
                        </Grid>
                    </StackPanel>
                </GroupBox>

                <!-- Audio Section -->
                <GroupBox Header="Audio" Margin="0,0,0,10">
                    <StackPanel Margin="5">
                        <CheckBox IsChecked="{Binding EnableAudio}"
                                  Content="Enable Audio"
                                  Margin="0,5"
                                  ToolTip.Tip="Enables or disables all sound output." />
                        <TextBlock Text="Master Volume" Classes="form-label" VerticalAlignment="Center" />
                        <Slider Value="{Binding MasterVolume}"
                                Minimum="0"
                                Maximum="100"
                                IsSnapToTickEnabled="True"
                                TickFrequency="1"
                                ToolTip.Tip="Adjusts the overall sound volume." />
                    </StackPanel>
                </GroupBox>

                <!-- Performance & Features Section -->
                <GroupBox Header="Performance &amp; Features" Margin="0,0,0,10">
                    <StackPanel Margin="5">
                        <CheckBox IsChecked="{Binding Rewind}"
                                  Content="Enable Rewind"
                                  Margin="0,5"
                                  ToolTip.Tip="Allows you to rewind gameplay. May impact performance." />
                        <CheckBox IsChecked="{Binding PauseInBackground}"
                                  Content="Pause When in Background"
                                  Margin="0,5"
                                  ToolTip.Tip="Pauses the emulation when the window is not in focus." />
                        <TextBlock Text="Run-Ahead Frames" Classes="form-label" VerticalAlignment="Center" />
                        <Slider Value="{Binding RunAhead}"
                                Minimum="0"
                                Maximum="8"
                                IsSnapToTickEnabled="True"
                                TickFrequency="1"
                                ToolTip.Tip="Reduces input lag by running frames ahead and rolling back. Use with caution (0-8)." />
                    </StackPanel>
                </GroupBox>

                <!-- CRITICAL SETTING -->
                <Border Classes="important-setting">
                    <StackPanel>
                        <TextBlock Text="⚠ IMPORTANT SETTING" Classes="important-setting-header" />
                        <CheckBox IsChecked="{Binding ShowBeforeLaunch}"
                                  Content="Show this window before launching a game"
                                  ToolTip.Tip="Show this window before launching a game." />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="BtnSave"
                    Content="Save"
                    Classes="secondary"
                    Command="{Binding SaveCommand}"
                    ToolTip.Tip="Save the configuration and close this window." />
            <Button Content="Save &amp; Run"
                    Classes="primary"
                    Command="{Binding RunCommand}"
                    IsDefault="True"
                    IsVisible="{Binding IsLauncherMode, Converter={StaticResource BoolToVisibility}}"
                    ToolTip.Tip="Save the configuration and run the game." />
            <Button Content="Cancel"
                    Classes="secondary"
                    Command="{Binding CancelCommand}"
                    ToolTip.Tip="Cancel and close this window without saving changes." />
        </StackPanel>
    </Grid>
</Window>
