<Window x:Class="SimpleLauncher.Avalonia.InjectConfigWindows.InjectRetroArchConfigWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RetroArch Configuration"
        Height="800" Width="700"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgPrimaryBrush}">

    <Grid Margin="10" RowDefinitions="*,Auto">

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Video Section -->
                <GroupBox Header="Video" Margin="0,0,0,10">
                    <StackPanel Margin="5">
                        <Grid ColumnDefinitions="*,*" Margin="0,0,0,5">
                            <TextBlock Text="Video Driver:" Classes="form-label" />
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding VideoDriverOptions}"
                                      SelectedItem="{Binding VideoDriver}"
                                      ToolTip.Tip="The driver used for video output (vulkan is recommended for modern GPUs)." />
                        </Grid>
                        <CheckBox IsChecked="{Binding Fullscreen}"
                                  Content="Start in Fullscreen"
                                  Margin="0,5"
                                  ToolTip.Tip="Starts RetroArch in fullscreen mode." />
                        <CheckBox IsChecked="{Binding Vsync}"
                                  Content="Enable VSync"
                                  Margin="0,5"
                                  ToolTip.Tip="Synchronizes frame rate with monitor refresh to prevent tearing." />
                        <CheckBox IsChecked="{Binding ThreadedVideo}"
                                  Content="Threaded Video"
                                  Margin="0,5"
                                  ToolTip.Tip="Improves performance by running video on a separate thread." />
                        <CheckBox IsChecked="{Binding Bilinear}"
                                  Content="Bilinear Filtering"
                                  Margin="0,5"
                                  ToolTip.Tip="Applies bilinear filtering to smooth pixels." />
                        <Grid ColumnDefinitions="*,*" Margin="0,0,0,5">
                            <TextBlock Text="Aspect Ratio:" Classes="form-label" />
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding AspectRatioIndexOptions}"
                                      SelectedItem="{Binding AspectRatioIndex}"
                                      ToolTip.Tip="Sets the screen aspect ratio (Core Provided is usually best)." />
                        </Grid>
                        <CheckBox IsChecked="{Binding ScaleInteger}"
                                  Content="Integer Scaling"
                                  Margin="0,5"
                                  ToolTip.Tip="Scales the image by whole numbers to ensure perfect pixels." />
                        <CheckBox IsChecked="{Binding ShaderEnable}"
                                  Content="Enable Shaders"
                                  Margin="0,5"
                                  ToolTip.Tip="Enables the use of graphical shaders." />
                        <CheckBox IsChecked="{Binding HardSync}"
                                  Content="GPU Hard Sync"
                                  Margin="0,5"
                                  ToolTip.Tip="Synchronizes CPU and GPU to reduce input latency." />
                    </StackPanel>
                </GroupBox>

                <!-- Audio Section -->
                <GroupBox Header="Audio" Margin="0,0,0,10">
                    <StackPanel Margin="5">
                        <CheckBox IsChecked="{Binding AudioEnable}"
                                  Content="Enable Audio"
                                  Margin="0,5"
                                  ToolTip.Tip="Enables audio output." />
                        <CheckBox IsChecked="{Binding AudioMute}"
                                  Content="Mute Audio"
                                  Margin="0,5"
                                  ToolTip.Tip="Mutes all audio." />
                    </StackPanel>
                </GroupBox>

                <!-- Automation & Misc -->
                <GroupBox Header="Automation And Behavior" Margin="0,0,0,10">
                    <StackPanel Margin="5">
                        <CheckBox IsChecked="{Binding PauseNonActive}"
                                  Content="Pause when window loses focus"
                                  Margin="0,5"
                                  ToolTip.Tip="Pauses the emulator when the window is not in focus." />
                        <CheckBox IsChecked="{Binding SaveOnExit}"
                                  Content="Save Configuration on Exit"
                                  Margin="0,5"
                                  ToolTip.Tip="If checked, changes made inside RA menu will be saved." />
                        <CheckBox IsChecked="{Binding AutoSaveState}"
                                  Content="Auto Save State on Exit"
                                  Margin="0,5"
                                  ToolTip.Tip="Automatically creates a save state when closing." />
                        <CheckBox IsChecked="{Binding AutoLoadState}"
                                  Content="Auto Load State on Start"
                                  Margin="0,5"
                                  ToolTip.Tip="Automatically loads the last save state when starting." />
                        <CheckBox IsChecked="{Binding Rewind}"
                                  Content="Enable Rewind"
                                  Margin="0,5"
                                  ToolTip.Tip="Allows you to rewind gameplay in real-time." />
                        <CheckBox IsChecked="{Binding RunAhead}"
                                  Content="Run-Ahead"
                                  Margin="0,5"
                                  ToolTip.Tip="Reduces input lag by predicting future frames (CPU intensive)." />
                    </StackPanel>
                </GroupBox>

                <!-- UI Section -->
                <GroupBox Header="User Interface" Margin="0,0,0,10">
                    <StackPanel Margin="5">
                        <Grid ColumnDefinitions="*,*" Margin="0,0,0,5">
                            <TextBlock Text="Menu Driver:" Classes="form-label" />
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding MenuDriverOptions}"
                                      SelectedItem="{Binding MenuDriver}"
                                      ToolTip.Tip="The visual style of the menu (Ozone is modern, XMB is PS3-style)." />
                        </Grid>
                        <CheckBox IsChecked="{Binding ShowAdvancedSettings}"
                                  Content="Show Advanced Settings"
                                  Margin="0,5"
                                  ToolTip.Tip="Shows more complex options in the RetroArch menu." />
                    </StackPanel>
                </GroupBox>

                <!-- RetroAchievements -->
                <GroupBox Header="RetroAchievements" Margin="0,0,0,10">
                    <StackPanel Margin="5">
                        <TextBlock Text="Credentials are managed in the 'RetroAchievements Settings' window."
                                   FontStyle="Italic"
                                   Margin="0,0,0,5"
                                   TextWrapping="Wrap" />
                        <CheckBox IsChecked="{Binding CheevosEnable}"
                                  Content="Enable RetroAchievements"
                                  Margin="0,5"
                                  ToolTip.Tip="Enables RetroAchievements integration." />
                        <CheckBox IsChecked="{Binding CheevosHardcore}"
                                  Content="Hardcore Mode"
                                  Margin="0,5"
                                  ToolTip.Tip="Disables cheats/rewind to earn hardcore badges." />
                        <CheckBox IsChecked="{Binding DiscordAllow}"
                                  Content="Discord Rich Presence"
                                  Margin="0,5"
                                  ToolTip.Tip="Shows what you are playing on your Discord profile." />
                    </StackPanel>
                </GroupBox>

                <!-- CRITICAL SETTING -->
                <Border Classes="important-setting">
                    <StackPanel>
                        <TextBlock Text="⚠ IMPORTANT SETTING" Classes="important-setting-header" />
                        <CheckBox IsChecked="{Binding ShowBeforeLaunch}"
                                  Content="Open this window before launching RetroArch"
                                  ToolTip.Tip="Show this window before launching a game." />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="BtnSave"
                    Content="Save"
                    Classes="secondary"
                    Command="{Binding SaveCommand}"
                    ToolTip.Tip="Save the configuration and close this window." />
            <Button Content="Save &amp; Run"
                    Classes="primary"
                    Command="{Binding RunCommand}"
                    IsDefault="True"
                    IsVisible="{Binding IsLauncherMode, Converter={StaticResource BoolToVisibility}}"
                    ToolTip.Tip="Save the configuration and run the game." />
            <Button Content="Cancel"
                    Classes="secondary"
                    Command="{Binding CancelCommand}"
                    ToolTip.Tip="Cancel and close this window without saving changes." />
        </StackPanel>
    </Grid>
</Window>
