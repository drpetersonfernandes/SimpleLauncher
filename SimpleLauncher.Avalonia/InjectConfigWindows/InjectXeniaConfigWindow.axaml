<Window x:Class="SimpleLauncher.Avalonia.InjectConfigWindows.InjectXeniaConfigWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="using:SimpleLauncher.Avalonia.Converters"
        Title="Xenia Configuration"
        Height="850" Width="700"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgPrimaryBrush}">

    <Window.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>

    <Grid Margin="10" RowDefinitions="*,Auto">

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- GPU Section -->
                <GroupBox Header="Graphics (GPU)" Margin="0,0,0,10">
                    <StackPanel Margin="5">
                        <Grid ColumnDefinitions="*,*" Margin="0,0,0,5">
                            <TextBlock Text="Graphics API:" Classes="form-label" VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding GpuOptions}"
                                      SelectedItem="{Binding XeniaGpu}"
                                      ToolTip.Tip="The graphics API used for rendering (d3d12 is standard)." />
                        </Grid>

                        <CheckBox IsChecked="{Binding XeniaVsync}"
                                  Content="VSync"
                                  Margin="0,5"
                                  ToolTip.Tip="Synchronizes frame rate to prevent screen tearing." />
                        <CheckBox IsChecked="{Binding XeniaFullscreen}"
                                  Content="Fullscreen"
                                  Margin="0,5"
                                  ToolTip.Tip="Starts Xenia in fullscreen mode." />

                        <TextBlock Text="Resolution Scale (X / Y):"
                                   Classes="form-label"
                                   Margin="0,5,0,0"
                                   ToolTip.Tip="Internal rendering resolution scale (1=720p, 2=1440p)." />
                        <Grid ColumnDefinitions="*,Auto,*">
                            <ComboBox Grid.Column="0"
                                      ItemsSource="{Binding ResScaleOptions}"
                                      Text="{Binding XeniaResScaleX}"
                                      ToolTip.Tip="Set the horizontal resolution scale." />
                            <TextBlock Text="x" Grid.Column="1" VerticalAlignment="Center" Margin="10,0" />
                            <ComboBox Grid.Column="2"
                                      ItemsSource="{Binding ResScaleOptions}"
                                      Text="{Binding XeniaResScaleY}"
                                      ToolTip.Tip="Set the vertical resolution scale." />
                        </Grid>

                        <TextBlock Text="Post-Processing AA:" Classes="form-label" Margin="0,5,0,0" />
                        <ComboBox ItemsSource="{Binding AaOptions}"
                                  SelectedValue="{Binding XeniaAa}"
                                  SelectedValueBinding="{Binding Tag}"
                                  ToolTip.Tip="Reduces jagged edges using FXAA.">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Display}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <TextBlock Text="Scaling And Sharpening:" Classes="form-label" Margin="0,5,0,0" />
                        <ComboBox ItemsSource="{Binding ScalingOptions}"
                                  SelectedItem="{Binding XeniaScaling}"
                                  ToolTip.Tip="Upscaling method (FSR provides high-quality sharpening)." />

                        <TextBlock Text="Readback Resolve (Fixes Graphics):" Classes="form-label" Margin="0,5,0,0" />
                        <ComboBox ItemsSource="{Binding ReadbackOptions}"
                                  SelectedItem="{Binding XeniaReadbackResolve}"
                                  ToolTip.Tip="Fixes certain graphical glitches at the cost of performance." />

                        <CheckBox IsChecked="{Binding XeniaGammaSrgb}"
                                  Content="Gamma Render Target as sRGB"
                                  Margin="0,5"
                                  ToolTip.Tip="Corrects colors in some games that appear too dark." />

                    </StackPanel>
                </GroupBox>

                <!-- Audio Section -->
                <GroupBox Header="Audio (APU)" Margin="0,0,0,10">
                    <StackPanel Margin="5">
                        <Grid ColumnDefinitions="*,*" Margin="0,0,0,5">
                            <TextBlock Text="Audio Driver:" Classes="form-label" VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding ApuOptions}"
                                      SelectedItem="{Binding XeniaApu}"
                                      ToolTip.Tip="The audio processing driver." />
                        </Grid>
                        <CheckBox IsChecked="{Binding XeniaMute}"
                                  Content="Mute Audio"
                                  Margin="0,5"
                                  ToolTip.Tip="Mutes all audio output." />
                    </StackPanel>
                </GroupBox>

                <!-- System Section -->
                <GroupBox Header="System And Input" Margin="0,0,0,10">
                    <StackPanel Margin="5">
                        <CheckBox IsChecked="{Binding XeniaApplyPatches}"
                                  Content="Apply Game Patches"
                                  Margin="0,5"
                                  ToolTip.Tip="Enables game-specific patches (patch files required)." />
                        <CheckBox IsChecked="{Binding XeniaMountCache}"
                                  Content="Mount Cache Partition"
                                  Margin="0,5"
                                  ToolTip.Tip="Simulates an Xbox 360 hard drive cache (required for some games)." />
                        <CheckBox IsChecked="{Binding XeniaVibration}"
                                  Content="Enable Controller Vibration"
                                  Margin="0,5"
                                  ToolTip.Tip="Enables controller vibration." />

                        <Grid ColumnDefinitions="*,*" Margin="0,5,0,0">
                            <TextBlock Text="Input Driver (HID):" Classes="form-label" VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding HidOptions}"
                                      SelectedItem="{Binding XeniaHid}"
                                      ToolTip.Tip="The input driver (xinput is standard for Xbox controllers)." />
                        </Grid>

                        <Grid ColumnDefinitions="*,*" Margin="0,5,0,0">
                            <TextBlock Text="User Language:" Classes="form-label" VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding LangOptions}"
                                      SelectedValue="{Binding XeniaUserLanguage}"
                                      SelectedValueBinding="{Binding Tag}"
                                      ToolTip.Tip="The system language reported to the game.">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Display}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>
                    </StackPanel>
                </GroupBox>

                <!-- CRITICAL SETTING -->
                <Border Classes="important-setting">
                    <StackPanel>
                        <TextBlock Text="⚠ IMPORTANT SETTING" Classes="important-setting-header" />
                        <CheckBox IsChecked="{Binding XeniaShowSettingsBeforeLaunch}"
                                  Content="Open this window before launching an Xbox 360 game"
                                  ToolTip.Tip="Show this window before launching a game." />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="BtnSave"
                    Content="Save"
                    Classes="secondary"
                    Command="{Binding SaveCommand}"
                    ToolTip.Tip="Save the configuration and close this window." />
            <Button Content="Save &amp; Run"
                    Classes="primary"
                    Command="{Binding RunCommand}"
                    IsDefault="True"
                    IsVisible="{Binding IsLauncherMode, Converter={StaticResource BoolToVisibility}}"
                    ToolTip.Tip="Save the configuration and run the game." />
            <Button Content="Cancel"
                    Classes="secondary"
                    Command="{Binding CancelCommand}"
                    ToolTip.Tip="Cancel and close this window without saving changes." />
        </StackPanel>
    </Grid>
</Window>
