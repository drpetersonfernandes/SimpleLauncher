<Window x:Class="SimpleLauncher.Avalonia.InjectConfigWindows.InjectSupermodelConfigWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="using:SimpleLauncher.Avalonia.Converters"
        Title="Supermodel Configuration"
        Height="750" Width="700"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgPrimaryBrush}">

    <Grid Margin="10" RowDefinitions="*,Auto">

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Video Section -->
                <GroupBox Header="Video &amp; Graphics" Margin="0,0,0,10">
                    <StackPanel Margin="5">
                        <CheckBox IsChecked="{Binding New3DEngine}"
                                  Content="Use New 3D Engine"
                                  Margin="0,5"
                                  ToolTip.Tip="Enables the modern, more accurate 3D engine. Highly recommended." />
                        <CheckBox IsChecked="{Binding QuadRendering}"
                                  Content="Quad Rendering"
                                  Margin="0,5"
                                  ToolTip.Tip="Improves accuracy for some GPUs, especially for transparent polygons. May impact performance." />
                        <CheckBox IsChecked="{Binding Fullscreen}"
                                  Content="Run in Fullscreen"
                                  Margin="0,5"
                                  ToolTip.Tip="Starts the emulator in fullscreen mode." />
                        <CheckBox IsChecked="{Binding Vsync}"
                                  Content="Enable V-Sync"
                                  Margin="0,5"
                                  ToolTip.Tip="Synchronizes the frame rate with your monitor's refresh rate to prevent screen tearing." />
                        <CheckBox IsChecked="{Binding WideScreen}"
                                  Content="Force Wide Screen (16:9)"
                                  Margin="0,5"
                                  ToolTip.Tip="Forces a 16:9 aspect ratio, which may stretch the image if the game was originally 4:3." />
                        <CheckBox IsChecked="{Binding Stretch}"
                                  Content="Stretch to Fill Screen"
                                  Margin="0,5"
                                  ToolTip.Tip="Stretches the image to fill your entire screen, ignoring the original aspect ratio." />

                        <TextBlock Text="Resolution (Width x Height):" Classes="form-label"
                                   Margin="0,5,0,0"
                                   ToolTip.Tip="Sets the internal rendering resolution of the game." />
                        <Grid ColumnDefinitions="*,Auto,*">
                            <NumericUpDown Grid.Column="0" Minimum="640" Maximum="7680" Increment="1"
                                           Value="{Binding ResX}"
                                           ToolTip.Tip="Set the horizontal resolution." />
                            <TextBlock Grid.Column="1" Text="x" VerticalAlignment="Center" Margin="10,0" />
                            <NumericUpDown Grid.Column="2" Minimum="480" Maximum="4320" Increment="1"
                                           Value="{Binding ResY}"
                                           ToolTip.Tip="Set the vertical resolution." />
                        </Grid>
                    </StackPanel>
                </GroupBox>

                <!-- Audio Section -->
                <GroupBox Header="Audio" Margin="0,0,0,10">
                    <StackPanel Margin="5">
                        <TextBlock Text="Music Volume:" Classes="form-label" VerticalAlignment="Center" />
                        <Slider Value="{Binding MusicVolume}" Minimum="0" Maximum="100" IsSnapToTickEnabled="True" TickFrequency="1" ToolTip.Tip="Adjusts the volume of in-game music (0-100)." />
                        <TextBlock Text="Sound Effects Volume:" Classes="form-label" VerticalAlignment="Center" Margin="0,5,0,0" />
                        <Slider Value="{Binding SoundVolume}" Minimum="0" Maximum="100" IsSnapToTickEnabled="True" TickFrequency="1" ToolTip.Tip="Adjusts the volume of sound effects (0-100)." />
                    </StackPanel>
                </GroupBox>

                <!-- System & Performance Section -->
                <GroupBox Header="System &amp; Performance" Margin="0,0,0,10">
                    <StackPanel Margin="5">
                        <CheckBox IsChecked="{Binding Throttle}"
                                  Content="Throttle Emulation Speed"
                                  Margin="0,5"
                                  ToolTip.Tip="Limits the emulation speed to the original hardware's speed (60 FPS). Disable for benchmarking." />
                        <CheckBox IsChecked="{Binding MultiThreaded}"
                                  Content="Enable Multi-Threading"
                                  Margin="0,5"
                                  ToolTip.Tip="Uses multiple CPU cores for a significant performance boost. Highly recommended." />

                        <Grid ColumnDefinitions="*,*" Margin="0,5">
                            <TextBlock Text="Input System:" Classes="form-label" VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding InputSystemOptions}"
                                      SelectedItem="{Binding InputSystem}"
                                      ToolTip.Tip="Selects the input API. XInput is for modern Xbox controllers. DInput is for older gamepads." />
                        </Grid>

                        <Grid ColumnDefinitions="*,*" Margin="0,5">
                            <TextBlock Text="PowerPC Frequency (MHz):" Classes="form-label" VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding PpcFrequencyOptions}"
                                      SelectedItem="{Binding PowerPcFrequency}"
                                      ToolTip.Tip="Adjusts the emulated CPU speed. Higher values can smooth out performance drops in demanding games." />
                        </Grid>
                    </StackPanel>
                </GroupBox>

                <!-- CRITICAL SETTING -->
                <Border Classes="important-setting">
                    <StackPanel>
                        <TextBlock Text="⚠ IMPORTANT SETTING" Classes="important-setting-header" />
                        <CheckBox IsChecked="{Binding ShowBeforeLaunch}"
                                  Content="Show this window before launching a game"
                                  ToolTip.Tip="Show this window before launching a game." />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="BtnSave" Content="Save"
                    Classes="secondary"
                    Command="{Binding SaveCommand}"
                    ToolTip.Tip="Save the configuration and close this window." />
            <Button Content="Save &amp; Run"
                    Classes="primary"
                    Command="{Binding RunCommand}"
                    IsDefault="True"
                    IsVisible="{Binding IsLauncherMode, Converter={StaticResource BoolToVisibility}}"
                    ToolTip.Tip="Save the configuration and run the game." />
            <Button Content="Cancel"
                    Classes="secondary"
                    Command="{Binding CancelCommand}"
                    ToolTip.Tip="Cancel and close this window without saving changes." />
        </StackPanel>
    </Grid>
</Window>
