<Window x:Class="SimpleLauncher.Avalonia.InjectConfigWindows.InjectYumirConfigWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="using:SimpleLauncher.Avalonia.Converters"
        Title="Yumir (Ymir) Configuration"
        Height="650" Width="700"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgPrimaryBrush}">

    <Grid Margin="10" RowDefinitions="*,Auto">

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Video Section -->
                <GroupBox Header="Video Settings" Margin="0,0,0,10">
                    <StackPanel Margin="5">
                        <CheckBox IsChecked="{Binding YumirFullscreen}"
                                  Content="Full Screen"
                                  Margin="0,5"
                                  ToolTip.Tip="Toggle between windowed and full screen mode." />
                        <CheckBox IsChecked="{Binding YumirForceAspectRatio}"
                                  Content="Force Aspect Ratio"
                                  Margin="0,5"
                                  ToolTip.Tip="Forces the emulator to use the specified aspect ratio instead of the game native one." />
                        <CheckBox IsChecked="{Binding YumirReduceLatency}"
                                  Content="Reduce Latency"
                                  Margin="0,5"
                                  ToolTip.Tip="Attempts to minimize input lag at the cost of some performance." />

                        <Grid Margin="0,5" ColumnDefinitions="*,*">
                            <TextBlock Text="Aspect Ratio Value:" Classes="form-label" VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding ForcedAspectOptions}"
                                      SelectedItem="{Binding YumirForcedAspect}"
                                      ToolTip.Tip="Select the numerical aspect ratio to force (e.g., 1.77 for 16:9)." />
                        </Grid>
                    </StackPanel>
                </GroupBox>

                <!-- Audio Section -->
                <GroupBox Header="Audio Settings" Margin="0,0,0,10">
                    <StackPanel Margin="5">
                        <CheckBox IsChecked="{Binding YumirMute}"
                                  Content="Mute Audio"
                                  Margin="0,5"
                                  ToolTip.Tip="Disable all sound output." />
                        <TextBlock Text="Volume Level:" Classes="form-label" VerticalAlignment="Center" />
                        <Slider Value="{Binding YumirVolume}" Minimum="0.0" Maximum="1.0" IsSnapToTickEnabled="True" TickFrequency="0.05" ToolTip.Tip="Adjust the master volume (0.0 to 1.0)." />
                    </StackPanel>
                </GroupBox>

                <!-- System Section -->
                <GroupBox Header="System &amp; Emulation" Margin="0,0,0,10">
                    <StackPanel Margin="5">
                        <CheckBox IsChecked="{Binding YumirAutoDetectRegion}"
                                  Content="Auto Detect Region"
                                  Margin="0,5"
                                  ToolTip.Tip="Automatically detect the game region (Japan, USA, Europe)." />
                        <Grid Margin="0,5" ColumnDefinitions="*,*">
                            <TextBlock Text="Video Standard:" Classes="form-label" VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding VideoStandardOptions}"
                                      SelectedItem="{Binding YumirVideoStandard}"
                                      ToolTip.Tip="Choose between PAL (50Hz) or NTSC (60Hz) timing." />
                        </Grid>
                        <CheckBox IsChecked="{Binding YumirPauseWhenUnfocused}"
                                  Content="Pause when Unfocused"
                                  Margin="0,5"
                                  ToolTip.Tip="Automatically pause emulation when the emulator window loses focus." />
                    </StackPanel>
                </GroupBox>

                <!-- CRITICAL SETTING -->
                <Border Classes="important-setting">
                    <StackPanel>
                        <TextBlock Text="⚠ IMPORTANT SETTING" Classes="important-setting-header" />
                        <CheckBox IsChecked="{Binding YumirShowSettingsBeforeLaunch}"
                                  Content="Show these settings every time before launching a game"
                                  ToolTip.Tip="Show this window before launching a game." />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="BtnSave" Content="Save"
                    Classes="secondary"
                    Command="{Binding SaveCommand}"
                    ToolTip.Tip="Save the configuration and close this window." />
            <Button Content="Save &amp; Run"
                    Classes="primary"
                    Command="{Binding RunCommand}"
                    IsDefault="True"
                    IsVisible="{Binding IsLauncherMode, Converter={StaticResource BoolToVisibility}}"
                    ToolTip.Tip="Save the configuration and run the game." />
            <Button Content="Cancel"
                    Classes="secondary"
                    Command="{Binding CancelCommand}"
                    ToolTip.Tip="Cancel and close this window without saving changes." />
        </StackPanel>
    </Grid>
</Window>
