<Window x:Class="SimpleLauncher.Avalonia.EasyModeWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="using:SimpleLauncher.Avalonia.Converters"
        Title="Add New System"
        Width="900" MinWidth="700"
        Height="610" MinHeight="550"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgPrimaryBrush}"
        Opened="Window_Opened"
        Closed="Window_Closed">

    <Window.Resources>
        <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
        <converters:InverseBoolConverter x:Key="InverseBool" />
    </Window.Resources>

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Row 0: Header + Close button -->
        <Grid Grid.Row="0" Margin="24,20,24,12" ColumnDefinitions="*,Auto">

            <StackPanel>
                <TextBlock Text="Add New System" FontSize="22" FontWeight="Light"
                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8" />
                <TextBlock Text="In this window you can download, configure and launch various retro gaming emulators."
                           TextWrapping="Wrap" FontSize="12"
                           Foreground="{DynamicResource TextMutedBrush}" />
                <TextBlock Text="We also support systems not listed here. Open an issue or use the original Simple Launcher to add a custom system."
                           TextWrapping="Wrap" FontSize="12"
                           Foreground="{DynamicResource TextMutedBrush}" Margin="0,6,0,0" />
            </StackPanel>

            <Button Grid.Column="1" Content="Close"
                    Classes="secondary"
                    Padding="14,6" Margin="4,0"
                    VerticalAlignment="Top"
                    Click="CloseButton_Click" />
        </Grid>

        <!-- Row 1: Main content (two columns) -->
        <Grid Grid.Row="1" Margin="24,12,24,12"
              IsEnabled="{Binding IsOperationInProgress, Converter={StaticResource InverseBool}}"
              ColumnDefinitions="*,20,*">

            <!-- Left column: Configuration -->
            <StackPanel Grid.Column="0">
                <TextBlock Text="Choose a System to Add" FontWeight="SemiBold" FontSize="13"
                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6" />
                <ComboBox x:Name="SystemNameCombo"
                          ItemsSource="{Binding Systems}"
                          SelectedItem="{Binding SelectedSystem}"
                          Height="32"
                          Background="{DynamicResource BgSecondaryBrush}"
                          Foreground="{DynamicResource TextPrimaryBrush}"
                          BorderBrush="{DynamicResource BorderNormalBrush}"
                          Margin="0,0,0,20">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding SystemName}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <TextBlock Text="Choose Folder with ROMs or ISOs" FontWeight="SemiBold" FontSize="13"
                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6" />
                <TextBlock Text="If you leave it empty, a default folder will be created."
                           TextWrapping="Wrap" FontSize="12"
                           Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,6" />
                <Grid ColumnDefinitions="*,Auto">
                    <TextBox Grid.Column="0"
                             Text="{Binding SystemFolderPath}"
                             VerticalContentAlignment="Center"
                             Height="32"
                             Background="{DynamicResource BgSecondaryBrush}"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             BorderBrush="{DynamicResource BorderNormalBrush}" />
                    <Button Grid.Column="1" Content="..."
                            Width="40" Height="32"
                            Margin="6,0,0,0"
                            Classes="secondary"
                            Click="BrowseFolder_Click"
                            ToolTip.Tip="Browse for ROM folder" />
                </Grid>

                <!-- Links section -->
                <StackPanel Margin="0,24,0,0">
                    <TextBlock Text="Resources" FontWeight="SemiBold" FontSize="13"
                               Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,10" />
                    <TextBlock Text="In case the image pack is not available, you can download covers manually:"
                               TextWrapping="Wrap" FontSize="12"
                               Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,6" />
                    <HyperlinkButton NavigateUri="https://github.com/libretro-thumbnails/libretro-thumbnails"
                                     Content="Libretro Thumbnails (GitHub)"
                                     Foreground="{DynamicResource LinkBrush}"
                                     Margin="0,2" />
                    <HyperlinkButton NavigateUri="https://emumovies.com/files/"
                                     Content="EmuMovies Files"
                                     Foreground="{DynamicResource LinkBrush}"
                                     Margin="0,2" />
                </StackPanel>
            </StackPanel>

            <!-- Right column: Downloads -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Install" FontWeight="SemiBold" FontSize="13"
                               Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,10" />

                    <!-- Essential components -->
                    <Border Background="{DynamicResource BgSecondaryBrush}"
                            BorderBrush="{DynamicResource BorderSubtleBrush}"
                            BorderThickness="1" CornerRadius="6"
                            Padding="12" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Essentials" FontWeight="SemiBold" FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8" />
                            <UniformGrid Columns="2" Rows="1">
                                <Button Content="Download Emulator"
                                        Command="{Binding DownloadEmulatorCommand}"
                                        IsEnabled="{Binding IsEmulatorDownloaded, Converter={StaticResource InverseBool}}"
                                        Height="38" Margin="4"
                                        Classes="primary" />
                                <Button Content="Download Core"
                                        Command="{Binding DownloadCoreCommand}"
                                        IsEnabled="{Binding IsCoreDownloaded, Converter={StaticResource InverseBool}}"
                                        Height="38" Margin="4"
                                        Classes="primary" />
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <!-- Image packs -->
                    <Border Background="{DynamicResource BgSecondaryBrush}"
                            BorderBrush="{DynamicResource BorderSubtleBrush}"
                            BorderThickness="1" CornerRadius="6"
                            Padding="12">
                        <StackPanel>
                            <TextBlock Text="Image Packs (Optional)" FontWeight="SemiBold" FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8" />
                            <UniformGrid Columns="2">
                                <Button Content="Image Pack 1"
                                        Command="{Binding DownloadImagePack1Command}"
                                        IsEnabled="{Binding IsImagePack1Downloaded, Converter={StaticResource InverseBool}}"
                                        IsVisible="{Binding IsImagePack1Available, Converter={StaticResource InverseBoolToVisibility}}"
                                        Height="38" Margin="4"
                                        Classes="primary" />
                                <Button Content="Image Pack 2"
                                        Command="{Binding DownloadImagePack2Command}"
                                        IsEnabled="{Binding IsImagePack2Downloaded, Converter={StaticResource InverseBool}}"
                                        IsVisible="{Binding IsImagePack2Available, Converter={StaticResource InverseBoolToVisibility}}"
                                        Height="38" Margin="4"
                                        Classes="primary" />
                                <Button Content="Image Pack 3"
                                        Command="{Binding DownloadImagePack3Command}"
                                        IsEnabled="{Binding IsImagePack3Downloaded, Converter={StaticResource InverseBool}}"
                                        IsVisible="{Binding IsImagePack3Available, Converter={StaticResource InverseBoolToVisibility}}"
                                        Height="38" Margin="4"
                                        Classes="primary" />
                                <Button Content="Image Pack 4"
                                        Command="{Binding DownloadImagePack4Command}"
                                        IsEnabled="{Binding IsImagePack4Downloaded, Converter={StaticResource InverseBool}}"
                                        IsVisible="{Binding IsImagePack4Available, Converter={StaticResource InverseBoolToVisibility}}"
                                        Height="38" Margin="4"
                                        Classes="primary" />
                                <Button Content="Image Pack 5"
                                        Command="{Binding DownloadImagePack5Command}"
                                        IsEnabled="{Binding IsImagePack5Downloaded, Converter={StaticResource InverseBool}}"
                                        IsVisible="{Binding IsImagePack5Available, Converter={StaticResource InverseBoolToVisibility}}"
                                        Height="38" Margin="4"
                                        Classes="primary" />
                            </UniformGrid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Row 2: Footer (progress + action) -->
        <Border Grid.Row="2"
                BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,1,0,0"
                Background="{DynamicResource BgSecondaryBrush}" Padding="20">
            <Grid ColumnDefinitions="*,Auto">

                <!-- Progress -->
                <Grid Grid.Column="0" Margin="0,0,20,0" RowDefinitions="Auto,Auto">

                    <Grid>
                        <ProgressBar Height="20"
                                     Value="{Binding DownloadProgress}"
                                     Minimum="0" Maximum="100" />
                        <TextBlock Text="Download Progress"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   FontSize="10" />
                    </Grid>

                    <DockPanel Grid.Row="1" Margin="0,6,0,0">
                        <Button DockPanel.Dock="Right"
                                Content="Stop"
                                Margin="10,0,0,0" Padding="10,4"
                                Command="{Binding StopDownloadCommand}"
                                IsEnabled="{Binding CanStopDownload}"
                                Classes="secondary" />
                        <TextBlock Text="{Binding DownloadStatus}"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                    </DockPanel>
                </Grid>

                <!-- Add System button -->
                <Button Grid.Column="1"
                        Content="Add System"
                        Command="{Binding AddSystemCommand}"
                        IsEnabled="{Binding IsAddSystemEnabled}"
                        FontSize="16" FontWeight="Bold"
                        Padding="32,12"
                        Classes="primary" />
            </Grid>
        </Border>

        <!-- Loading overlay -->
        <Border x:Name="LoadingOverlay"
                Grid.Row="0" Grid.RowSpan="3"
                Background="#B31E1E1E"
                IsVisible="False">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock x:Name="LoadingText"
                           Text="Loading configuration..."
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           FontSize="14"
                           HorizontalAlignment="Center" />
                <Button x:Name="EmergencyButton"
                        Content="Cancel"
                        Width="100" Margin="0,16,0,0"
                        Classes="secondary"
                        Click="EmergencyOverlay_Click"
                        HorizontalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
