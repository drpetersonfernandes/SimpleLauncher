<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFrameworks>net10.0;net10.0-windows</TargetFrameworks>
        <RuntimeFrameworkVersion>10.0.2</RuntimeFrameworkVersion>
        <OutputType>WinExe</OutputType>
        <ImplicitUsings>enable</ImplicitUsings>
        <IsPackable>false</IsPackable>
        <Company>PureLogicCode.com</Company>
        <Product>Simple Launcher</Product>
        <LangVersion>14</LangVersion>
        <Nullable>enable</Nullable>
        <NeutralLanguage>en</NeutralLanguage>
        <RuntimeIdentifiers Condition="'$(TargetFramework)' == 'net10.0-windows'">win-x64;win-arm64</RuntimeIdentifiers>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <DebugType>embedded</DebugType>
        <DebugSymbols>true</DebugSymbols>
        <NoWarn>NU1903;CS0436</NoWarn>
        <AssemblyName>SimpleLauncher.Avalonia</AssemblyName>
        <RootNamespace>SimpleLauncher.Avalonia</RootNamespace>
        <SupportedOSPlatformVersion>7.0</SupportedOSPlatformVersion>
        <AssemblyVersion>5.6.1</AssemblyVersion>
        <FileVersion>5.6.1</FileVersion>
        <Version>5.6.1</Version>
        <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
        <ApplicationIcon>icon\icon.ico</ApplicationIcon>
        <PackageIcon>icon\icon2.png</PackageIcon>
        <RepositoryUrl>https://github.com/drpetersonfernandes/SimpleLauncher</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageProjectUrl>https://github.com/drpetersonfernandes/SimpleLauncher</PackageProjectUrl>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <UseWindowsForms>False</UseWindowsForms>
        <StartupObject>SimpleLauncher.Avalonia.Program</StartupObject>
        <!-- Avalonia single-project (no .xaml split) -->
        <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
    </PropertyGroup>

    <!-- Linux target (net10.0): linux RIDs only. A Windows RID on this TFM builds
         WITHOUT the WINDOWS symbol, so Core's PlaySoundEffects silently takes the
         libsndfile/SoundFileReader path and crashes on Windows with
         DllNotFoundException: libsndfile (no Windows native binary is shipped).
         Fail loudly instead of producing a broken publish. -->
    <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0'">
        <RuntimeIdentifiers>linux-x64;linux-arm64</RuntimeIdentifiers>
    </PropertyGroup>

    <Target Name="GuardWindowsRidOnLinuxTfm" BeforeTargets="Build;Publish">
        <Error
            Condition="'$(TargetFramework)' == 'net10.0' and $([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('win'))"
            Text="Cannot build/publish net10.0 with a Windows RuntimeIdentifier '$([System.String]::Copy('$(RuntimeIdentifier)'))'. The net10.0 TFM is Linux-only (audio uses libsndfile). For Windows, use the net10.0-windows TFM, e.g. `dotnet publish -f net10.0-windows -r $(RuntimeIdentifier)`." />
    </Target>

    <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
        <PlatformTarget>AnyCPU</PlatformTarget>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
        <IsPublishable>False</IsPublishable>
        <PlatformTarget>AnyCPU</PlatformTarget>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\SimpleLauncher.Core\SimpleLauncher.Core.csproj" />
    </ItemGroup>

    <ItemGroup>
        <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
            <_Parameter1>SimpleLauncher.Avalonia.Tests</_Parameter1>
        </AssemblyAttribute>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
        <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.11" />
        <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.11" />
        <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.11" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
        <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.11" />
        <PackageReference Include="Serilog" Version="4.4.0" />
        <PackageReference Include="Serilog.Sinks.Async" Version="2.1.0" />
        <PackageReference Include="Serilog.Sinks.Debug" Version="3.0.0" />
        <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
        <!-- Avalonia 12.1.1 — same version as the reference source tree -->
        <PackageReference Include="Avalonia" Version="12.1.1" />
        <PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
        <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
        <PackageReference Include="Avalonia.Controls.DataGrid" Version="12.1.2" />
        <!-- Markdown.Avalonia 12.x is required for Avalonia 12 — 11.0.3 crashes with
             MissingMethodException (DynamicResourceExtension.ProvideValue) at XAML load -->
        <PackageReference Include="Markdown.Avalonia" Version="12.0.0-a3" />
        <!-- Windows-only screenshot capture (net10.0-windows TFM only; the net10.0 Linux TFM
             must not pull this in — System.Drawing.Common is Windows-only) -->
    </ItemGroup>

    <ItemGroup>
        <None Update="appsettings.json">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
        <None Update="Resources\strings.*.json">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
    </ItemGroup>

    <!-- Files sourced from the original SimpleLauncher project (outside this project dir)
         must use Include + Link — Update only modifies already-included items. -->
    <ItemGroup>
        <None Include="..\SimpleLauncher\tools\CHDMounter\*" Link="tools\CHDMounter\%(Filename)%(Extension)">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
        <None Include="..\SimpleLauncher\tools\RetroAchievementsSharp\*"
              Link="tools\RetroAchievementsSharp\%(Filename)%(Extension)">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
        <None Include="..\SimpleLauncher\images\systems\*.png" Link="images\systems\%(Filename)%(Extension)">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
        <None Include="..\SimpleLauncher\audio\*.mp3" Link="audio\%(Filename)%(Extension)">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
    </ItemGroup>

    <!-- Root data/docs files — same files the WPF app ships next to the executable -->
    <ItemGroup>
        <None Include="..\SimpleLauncher\WhatsNew.md" Link="WhatsNew.md">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
        <None Include="..\SimpleLauncher\parameters.md" Link="parameters.md">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
        <None Include="..\SimpleLauncher\mame.dat" Link="mame.dat">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
        <None Include="..\SimpleLauncher\RetroAchievements.dat" Link="RetroAchievements.dat">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
        <None Include="..\SimpleLauncher\history.dat" Link="history.dat">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
    </ItemGroup>

    <!-- UI icons (root of images\; images\systems\*.png is linked above) -->
    <ItemGroup>
        <None Include="..\SimpleLauncher\images\*.png" Link="images\%(Filename)%(Extension)">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
        <!-- UI icons embedded into the binary (Avalonia equivalent of the WPF
             <Resource Include="images\*.png" /> entries) — loaded via
             avares://SimpleLauncher.Avalonia/images/*.png. Loose copies below are kept
             because appsettings.json / user config reference some icons by file path
             (e.g. images\default.png), exactly like the WPF app ships them. -->
        <AvaloniaResource Include="..\SimpleLauncher\images\*.png" Link="images\%(Filename)%(Extension)" />
        <None Include="icon\icon.ico">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
    </ItemGroup>

    <!-- Emulator sample config files (injection + easy mode) -->
    <ItemGroup>
        <None Include="..\SimpleLauncher\samples\**\*" Link="samples\%(RecursiveDir)%(Filename)%(Extension)">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
    </ItemGroup>

    <!-- Batch/utility tools — mirrors the file list shipped by the WPF csproj -->
    <ItemGroup>
        <None Include="..\SimpleLauncher\tools\BatchConvertIsoToXiso\*"
              Link="tools\BatchConvertIsoToXiso\%(Filename)%(Extension)">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
        <None Include="..\SimpleLauncher\tools\BatchConvertToCHD\*"
              Link="tools\BatchConvertToCHD\%(Filename)%(Extension)">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
        <None Include="..\SimpleLauncher\tools\BatchConvertToCHD\Resources\*"
              Link="tools\BatchConvertToCHD\Resources\%(Filename)%(Extension)">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
        <None Include="..\SimpleLauncher\tools\BatchConvertToCompressedFile\*"
              Link="tools\BatchConvertToCompressedFile\%(Filename)%(Extension)">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
        <None Include="..\SimpleLauncher\tools\BatchConvertToRVZ\*"
              Link="tools\BatchConvertToRVZ\%(Filename)%(Extension)">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
        <None Include="..\SimpleLauncher\tools\CreateBatchFilesForPS3Games\*"
              Link="tools\CreateBatchFilesForPS3Games\%(Filename)%(Extension)">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
        <None Include="..\SimpleLauncher\tools\CreateBatchFilesForScummVMGames\*"
              Link="tools\CreateBatchFilesForScummVMGames\%(Filename)%(Extension)">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
        <None Include="..\SimpleLauncher\tools\CreateBatchFilesForWindowsGames\*"
              Link="tools\CreateBatchFilesForWindowsGames\%(Filename)%(Extension)">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
        <None Include="..\SimpleLauncher\tools\CreateBatchFilesForXbox360XBLAGames\*"
              Link="tools\CreateBatchFilesForXbox360XBLAGames\%(Filename)%(Extension)">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
        <None Include="..\SimpleLauncher\tools\FindRomCover\arm64\**\*"
              Link="tools\FindRomCover\arm64\%(RecursiveDir)%(Filename)%(Extension)">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
        <None Include="..\SimpleLauncher\tools\FindRomCover\x64\**\*"
              Link="tools\FindRomCover\x64\%(RecursiveDir)%(Filename)%(Extension)">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
        <None Include="..\SimpleLauncher\tools\RetroGameCoverDownloader\*"
              Link="tools\RetroGameCoverDownloader\%(Filename)%(Extension)">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
        <None Include="..\SimpleLauncher\tools\RomValidator\*" Link="tools\RomValidator\%(Filename)%(Extension)">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
        <None Include="..\SimpleLauncher\tools\SevenZip\*" Link="tools\SevenZip\%(Filename)%(Extension)">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
        <None Include="..\SimpleLauncher\tools\SimpleXisoDrive\*" Link="tools\SimpleXisoDrive\%(Filename)%(Extension)">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
        <None Include="..\SimpleLauncher\tools\SimpleZipDrive\*" Link="tools\SimpleZipDrive\%(Filename)%(Extension)">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
    </ItemGroup>

    <ItemGroup>
        <Using Include="System.IO" />
        <Using Include="System.Net.Http" />
        <Using Include="Serilog" />
    </ItemGroup>

    <!-- ── Avalonia Updater (phase 1.1: ship the updater next to the app) ──
         The updater is a standalone executable (no compile reference — ReferenceOutputAssembly=false),
         but it must ship in the same folder as the app so updates can replace the app files while
         the updater itself stays locked/running. -->
    <ItemGroup>
        <ProjectReference Include="..\SimpleLauncher.Avalonia.Updater\SimpleLauncher.Avalonia.Updater.csproj"
                          ReferenceOutputAssembly="false" />
    </ItemGroup>
    <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-windows'">
        <PackageReference Include="System.Drawing.Common" Version="10.0.11" />
    </ItemGroup>

    <Target Name="CopyAvaloniaUpdaterToOutput" AfterTargets="Build" Condition="'$(TargetFramework)' != ''">
        <ItemGroup>
            <AvaloniaUpdaterFiles
                Include="..\SimpleLauncher.Avalonia.Updater\bin\$(Configuration)\$(TargetFramework)\**\*.*" />
        </ItemGroup>
        <Copy SourceFiles="@(AvaloniaUpdaterFiles)"
              DestinationFiles="@(AvaloniaUpdaterFiles->'$(OutDir)%(RecursiveDir)%(Filename)%(Extension)')"
              SkipUnchangedFiles="true" />
    </Target>
</Project>